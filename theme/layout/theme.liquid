<!doctype html>
<html lang="{{ request.locale.iso_code }}{% if request.locale.iso_code == 'en' %}-IN{% endif %}">
  <head>
    {%- render 'meta-tags' -%}

    {%- comment -%}
      Lite mode for data saver, 2G and low-memory phones: decorative loops, the logo intro, photo fade-ins and the
      hero autoplay are skipped; every tap and drawer animation stays. Decided before first paint.
    {%- endcomment -%}
    <script>
      (function () {
        try {
          var c = navigator.connection || {};
          if (c.saveData || /(^|-)2g$/.test(c.effectiveType || '') || (navigator.deviceMemory && navigator.deviceMemory <= 2)) {
            document.documentElement.classList.add('lite');
          }
        } catch (e) {}
      })();
    </script>

    {{ 'cormorant-garamond-600-italic.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'jost-variable.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- render 'font-faces' -%}
    {%- assign intro_pages = 'index,collection,list-collections,product,page,blog,article' | split: ',' -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- if intro_pages contains request.page_type and settings.show_intro and request.design_mode == false -%}
      {%- render 'splash', part: 'head' -%}
    {%- endif -%}

    {%- comment -%} Start loading likely next pages as soon as a finger or pointer lands on a link. {%- endcomment -%}
    <script type="speculationrules">
      {
        "prerender": [{
          "where": { "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": ["/cart*", "/checkout*", "/account*", "/*\\?*"] } },
            { "not": { "selector_matches": "[rel~=nofollow], [data-no-prerender]" } }
          ] },
          "eagerness": "moderate"
        }]
      }
    </script>

    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>

    {{ content_for_header }}

    {%- render 'structured-data' -%}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {%- if intro_pages contains request.page_type and settings.show_intro and request.design_mode == false -%}
      {%- render 'splash', part: 'body' -%}
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
