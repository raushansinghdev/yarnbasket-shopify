{%- liquid
  assign count = section.blocks.size
-%}
{%- if count > 0 -%}
  <aside class="announce scheme-blush" aria-label="{{ 'announcement.label' | t }}" data-announce>
    <div class="announce__inner page-grid">
      <div class="announce__row">
        {%- if count > 1 -%}
          <button type="button" class="announce__btn" data-announce-prev>
            {%- render 'icon', icon: 'chevron', class: 'announce__chev announce__chev--prev' -%}
            <span class="visually-hidden">{{ 'announcement.previous' | t }}</span>
          </button>
        {%- endif -%}
        <ul class="announce__track" role="list" tabindex="0" aria-label="{{ 'announcement.label' | t }}" data-announce-track>
          {%- for block in section.blocks -%}
            <li class="announce__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if count > 1 -%}
          <button type="button" class="announce__btn" data-announce-next>
            {%- render 'icon', icon: 'chevron', class: 'announce__chev announce__chev--next' -%}
            <span class="visually-hidden">{{ 'announcement.next' | t }}</span>
          </button>
        {%- endif -%}
      </div>
    </div>
  </aside>
{%- endif -%}

{% stylesheet %}
  .announce { font-size: .6875rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--cocoa-deep); }
  .announce__row { display: flex; align-items: center; gap: var(--space-2); min-height: 40px; }
  .announce__track {
    flex: 1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .announce__track::-webkit-scrollbar { display: none; }
  .announce__item { scroll-snap-align: center; display: grid; place-items: center; text-align: center; padding: 10px var(--space-2); }
  .announce__item a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); }
  .announce__btn { display: grid; place-items: center; width: 40px; height: 40px; color: inherit; border-radius: 50%; flex: none; }
  .announce__chev { width: 16px; height: 16px; }
  .announce__chev--prev { transform: rotate(90deg); }
  .announce__chev--next { transform: rotate(-90deg); }
  @media (hover: hover) { .announce__btn:hover { background: color-mix(in srgb, var(--cocoa) 8%, transparent); } }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-announce]').forEach((bar) => {
    const track = bar.querySelector('[data-announce-track]');
    const step = (dir) => {
      const max = track.scrollWidth - track.clientWidth;
      let next = track.scrollLeft + dir * track.clientWidth;
      if (next > max + 2) next = 0;
      if (next < -2) next = max;
      track.scrollTo({ left: next, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    bar.querySelector('[data-announce-prev]')?.addEventListener('click', () => step(-1));
    bar.querySelector('[data-announce-next]')?.addEventListener('click', () => step(1));
  });
{% endjavascript %}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Message", "default": "Handmade with love, one stitch at a time" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
