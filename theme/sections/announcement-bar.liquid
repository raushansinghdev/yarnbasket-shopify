{%- liquid
  # Messages with a "Show until" date in the past are skipped, so an expired offer never stays on the site.
  assign today = 'now' | date: '%Y%m%d' | plus: 0
  assign live_ids = ''
  for block in section.blocks
    assign until = block.settings.show_until | remove: '-' | strip
    if until == blank
      assign live_ids = live_ids | append: block.id | append: ','
    else
      assign until_num = until | plus: 0
      if until_num >= today
        assign live_ids = live_ids | append: block.id | append: ','
      endif
    endif
  endfor
  assign live = live_ids | split: ','
  assign count = live.size
-%}
{%- if count > 0 -%}
  {%- comment -%}
    A slim, quiet line above the header (docs/home-hero-plan.md §4): delivery and payment terms where shoppers
    look first. It scrolls away with the page; the header stays sticky. One message is plain, still text; with
    more, arrows and swipe, never automatic rotation (WCAG 2.2.2).
    " · " in a message splits it into parts with a dot between them that screen readers skip.
  {%- endcomment -%}
  <aside class="announce" aria-label="{{ 'announcement.label' | t }}" data-announce>
    <div class="announce__inner page-grid">
      <div class="announce__row">
        {%- if count > 1 -%}
          <button type="button" class="announce__btn" data-announce-prev>
            {%- render 'icon', icon: 'chevron', class: 'announce__chev announce__chev--prev' -%}
            <span class="visually-hidden">{{ 'announcement.previous' | t }}</span>
          </button>
        {%- endif -%}
        <ul class="announce__track" role="list"{% if count > 1 %} tabindex="0" aria-label="{{ 'announcement.label' | t }}"{% endif %} data-announce-track>
          {%- for block in section.blocks -%}
            {%- unless live contains block.id -%}{%- continue -%}{%- endunless -%}
            {%- capture message -%}
              {%- if block.settings.icon != 'none' -%}{%- render 'icon', icon: block.settings.icon, class: 'announce__icon' -%}{%- endif -%}
              {%- assign parts = block.settings.text | split: ' · ' -%}
              <span>
                {%- for part in parts -%}
                  {%- unless forloop.first -%}<span class="visually-hidden">, </span><span class="announce__dot" aria-hidden="true">·</span>{%- endunless -%}
                  <span class="announce__part">{{ part }}</span>
                {%- endfor -%}
              </span>
            {%- endcapture -%}
            <li class="announce__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="announce__msg" href="{{ block.settings.link }}">{{ message }}</a>
              {%- else -%}
                <p class="announce__msg">{{ message }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if count > 1 -%}
          <button type="button" class="announce__btn" data-announce-next>
            {%- render 'icon', icon: 'chevron', class: 'announce__chev announce__chev--next' -%}
            <span class="visually-hidden">{{ 'announcement.next' | t }}</span>
          </button>
        {%- endif -%}
      </div>
    </div>
  </aside>
{%- endif -%}

{% stylesheet %}
  /* Quiet on purpose: Blush with Cocoa Deep text, a shade deeper than the header, with a hairline under it. It answers
     "do you deliver, can I pay on delivery?" without pulling the eye from the hero heading. */
  .announce {
    background: var(--blush);
    color: var(--cocoa-deep);
    border-bottom: 1px solid var(--color-line);
    font-size: .8125rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .announce__row { display: flex; align-items: center; gap: var(--space-1); min-height: 32px; }
  .announce__track {
    flex: 1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .announce__track::-webkit-scrollbar { display: none; }
  .announce__item { scroll-snap-align: center; display: grid; place-items: center; text-align: center; padding: 6px 0; }
  .announce__msg { display: inline-flex; align-items: center; gap: var(--space-2); margin: 0; color: inherit; text-wrap: balance; }
  /* Each part stays whole: on a narrow screen the line breaks between parts, never inside one. */
  .announce__part { white-space: nowrap; }
  .announce__dot { margin-inline: .5em; opacity: .55; }
  .announce__icon { width: 16px; height: 16px; flex: none; }
  a.announce__msg { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); }
  .announce__track:focus-visible { outline: 2px solid var(--cocoa-deep); outline-offset: -2px; box-shadow: none; }
  .announce__msg:focus-visible, .announce__btn:focus-visible { outline-color: var(--cocoa-deep); }
  /* Arrows only with two or more messages; the theme's 48px tap size (the row grows to fit). */
  .announce__btn { display: grid; place-items: center; width: var(--tap); height: var(--tap); color: inherit; border-radius: 50%; flex: none; }
  .announce__chev { width: 16px; height: 16px; }
  .announce__chev--prev { transform: rotate(90deg); }
  .announce__chev--next { transform: rotate(-90deg); }
  @media (hover: hover) {
    .announce__btn:hover { background: color-mix(in srgb, var(--cocoa) 9%, transparent); }
    a.announce__msg:hover { text-decoration-color: currentColor; }
  }
  /* Pop-ups that hang below the header (cart and saved toasts, the account sheet, the search panel) start lower
     while this bar is still on screen at the top of the page. Set on those four only, not on <html>: a custom property
     that changes on the root restyles the whole page, and this one flips as the first scroll begins. */
  html:not(.header-scrolled) :is(.cart-toast, .saved-toast, .account-btn, .search-panel) { --header-top: var(--announce-h, 0px); }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-announce]').forEach((bar) => {
    // Its real height (it can wrap to two lines on a narrow phone or at large text) for --header-top.
    new ResizeObserver(() => document.documentElement.style.setProperty('--announce-h', `${bar.offsetHeight}px`)).observe(bar);
    const track = bar.querySelector('[data-announce-track]');
    const step = (dir) => {
      const max = track.scrollWidth - track.clientWidth;
      let next = track.scrollLeft + dir * track.clientWidth;
      if (next > max + 2) next = 0;
      if (next < -2) next = max;
      track.scrollTo({ left: next, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    bar.querySelector('[data-announce-prev]')?.addEventListener('click', () => step(-1));
    bar.querySelector('[data-announce-next]')?.addEventListener('click', () => step(1));
  });
{% endjavascript %}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "settings": [
    { "type": "paragraph", "content": "A slim line above the header, on every page. Use it for delivery and payment terms, or real, time-bound news. Remove the section when there is nothing to say." }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Message", "info": "Only something a shopper can act on: delivery, payment, an offer. Separate parts with \" · \" (space, dot, space). It must match checkout exactly." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "package", "label": "Parcel" },
            { "value": "gift", "label": "Gift" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "truck"
        },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "show_until", "label": "Show until", "placeholder": "2027-02-10", "info": "Optional. Date as YYYY-MM-DD. After this day the message hides itself." }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
