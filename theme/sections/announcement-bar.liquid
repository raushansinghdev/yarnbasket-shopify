{%- comment -%}
  A slim, quiet line above the header (docs/offers-plan.md §4). Always one line, never a carousel: more messages
  would mean rotation (WCAG 2.2.2) or arrows, and Baymard found shoppers skip banner text anyway, so every offer is
  also said where the decision happens (product page, added-to-cart pop-up, cart).
  - The standing line is built from Theme settings, so it can't disagree with the cart: free shipping and COD once
    they're switched on, otherwise "Handmade in India · Ships in 1–2 days". Two parts on phones, three from 768px.
  - A message block (dated news: a Diwali cut-off, a sale) replaces it until its "Show until" day; the first live one wins.
    "Hide on the home page" skips it there, where the hero's campaign banner already says it (hero-campaign-plan.md D7).
  - Hidden on /cart, where the progress bar says the same thing with real numbers.
  " · " splits a message into parts with a dot between them that screen readers skip. It scrolls away with the
  page; the header stays sticky.
{%- endcomment -%}
{%- unless request.page_type == 'cart' -%}
  {%- liquid
    assign today = 'now' | date: '%Y%m%d' | plus: 0
    assign news = nil
    for block in section.blocks
      if block.settings.text == blank
        continue
      endif
      if block.settings.hide_on_home and request.page_type == 'index'
        continue
      endif
      assign until = block.settings.show_until | remove: '-' | strip
      if until == blank
        assign news = block
        break
      endif
      assign until_num = until | plus: 0
      if until_num >= today
        assign news = block
        break
      endif
    endfor

    if news
      assign parts = news.settings.text | split: ' · '
      assign icon = news.settings.icon
      assign link = news.settings.link
    elsif section.settings.terms
      assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
      assign ships = 'cart.ships' | t
      assign handmade = 'announcement.handmade' | t
      if threshold > 0 or settings.cod_available
        assign line = ''
        if threshold > 0
          assign amount = threshold | money_without_trailing_zeros
          assign line = 'announcement.free_shipping' | t: amount: amount | append: '|'
        endif
        if settings.cod_available
          assign cod = 'announcement.cod' | t
          assign line = line | append: cod | append: '|'
        endif
        assign line = line | append: ships | append: '|' | append: handmade
      else
        assign line = handmade | append: '|' | append: ships
      endif
      assign parts = line | split: '|'
      assign icon = 'none'
      assign link = blank
    endif
  -%}
  {%- if parts -%}
    {%- capture message -%}
      {%- if icon != 'none' -%}{%- render 'icon', icon: icon, class: 'announce__icon' -%}{%- endif -%}
      <span>
        {%- for part in parts limit: 3 -%}
          {%- comment -%} The dot ends a part, so a line that wraps never starts with one. The dot before the third
          part shows only where the third part does. {%- endcomment -%}
          <span class="announce__chunk{% if forloop.index == 3 %} announce__chunk--wide{% endif %}">
            <span class="announce__part">{{ part }}</span>
            {%- unless forloop.last -%}<span class="visually-hidden">, </span><span class="announce__dot{% if forloop.index == 2 %} announce__dot--wide{% endif %}" aria-hidden="true">·</span>{%- endunless -%}
          </span>
        {%- endfor -%}
      </span>
    {%- endcapture -%}
    <aside class="announce" aria-label="{{ 'announcement.label' | t }}" data-announce>
      <div class="announce__inner page-grid">
        {%- if link != blank -%}
          <a class="announce__msg" href="{{ link }}" data-announce-track>{{ message }}</a>
        {%- else -%}
          <p class="announce__msg" data-announce-track>{{ message }}</p>
        {%- endif -%}
      </div>
    </aside>
  {%- endif -%}
{%- endunless -%}

{% stylesheet %}
  /* Quiet on purpose: Blush with Cocoa Deep text, a shade deeper than the header, with a hairline under it. It answers
     "do you deliver, can I pay on delivery?" without pulling the eye from the hero heading. */
  .announce {
    background: var(--blush);
    color: var(--cocoa-deep);
    border-bottom: 1px solid var(--color-line);
    font-size: .8125rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .announce__inner { display: grid; place-items: center; min-height: 32px; padding-block: 6px; text-align: center; }
  .announce__msg { display: inline-flex; align-items: center; gap: var(--space-2); margin: 0; color: inherit; text-wrap: balance; }
  /* Each part stays whole: if a long dated message wraps, it breaks between parts, never inside one. */
  .announce__part { white-space: nowrap; }
  .announce__dot { margin-inline: .5em; opacity: .55; }
  /* The third part of the standing line only where there's room. */
  .announce__chunk--wide, .announce__dot--wide { display: none; }
  @media (min-width: 768px) { .announce__chunk--wide, .announce__dot--wide { display: inline; } }
  .announce__icon { width: 16px; height: 16px; flex: none; }
  a.announce__msg { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); }
  a.announce__msg:focus-visible { outline-color: var(--cocoa-deep); }
  @media (hover: hover) { a.announce__msg:hover { text-decoration-color: currentColor; } }
  /* Pop-ups that hang below the header (cart and saved toasts, the account sheet, the search panel) start lower
     while this bar is still on screen at the top of the page. Set on those four only, not on <html>: a custom property
     that changes on the root restyles the whole page, and this one flips as the first scroll begins. */
  html:not(.header-scrolled) :is(.cart-toast, .saved-toast, .account-btn, .search-panel) { --header-top: var(--announce-h, 0px); }
{% endstylesheet %}

{% javascript %}
  // Its real height (a long dated message can wrap on a narrow phone or at large text) for --header-top.
  document.querySelectorAll('[data-announce]').forEach((bar) => {
    new ResizeObserver(() => document.documentElement.style.setProperty('--announce-h', `${bar.offsetHeight}px`)).observe(bar);
  });
{% endjavascript %}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 2,
  "settings": [
    { "type": "paragraph", "content": "One quiet line above the header, on every page except the cart. It never rotates: to say something new, add a message with a \"Show until\" date. It replaces the store terms until that day, then the terms come back." },
    {
      "type": "checkbox",
      "id": "terms",
      "label": "Show the store terms",
      "default": true,
      "info": "Built from Theme settings → Cart: \"Free shipping over ₹…\" and \"Cash on delivery\" once they're set, otherwise \"Handmade in India · Ships in 1–2 days\"."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Message", "info": "Short news a shopper can act on, about 40 characters so it fits one line on a phone. Separate parts with \" · \" (space, dot, space). It must match checkout exactly." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "package", "label": "Parcel" },
            { "value": "gift", "label": "Gift" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "gift"
        },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "hide_on_home", "label": "Hide on the home page", "default": false, "info": "For a campaign that also has a banner on the home page: there the bar keeps the next message or the store terms, so it isn't said twice." },
        { "type": "text", "id": "show_until", "label": "Show until", "placeholder": "2027-02-10", "info": "Date as YYYY-MM-DD. After this day the message hides itself and the store terms come back. Leave empty to keep it until you remove it." }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
