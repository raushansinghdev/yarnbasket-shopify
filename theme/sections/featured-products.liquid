{%- liquid
  assign s = section.settings
  assign c = s.collection
-%}

<section class="section featured scheme-{{ s.scheme }}" aria-labelledby="Featured-{{ section.id }}">
  <div class="section-head section-head--split" data-arrive="lines">
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h2 id="Featured-{{ section.id }}">{{ s.heading }}</h2>
    {%- if s.show_view_all and c != blank -%}
      <a class="link section-head__link" href="{{ c.url }}">
        {{- 'general.view_all' | t -}}
        <span class="visually-hidden"> {{ c.title }}</span>
        {%- render 'icon', icon: 'arrow' -%}
      </a>
    {%- endif -%}
  </div>

  <ul class="product-grid" role="list" data-arrive="stagger">
    {%- if c != blank and c.products_count > 0 -%}
      {%- for product in c.products limit: s.limit -%}
        <li style="--i: {{ forloop.index0 | modulo: 4 }}">
          {%- render 'product-card', product: product, index: forloop.index0 -%}
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..s.limit) -%}
        <li style="--i: {{ forloop.index0 | modulo: 4 }}">
          {%- render 'product-card', product: blank, index: forloop.index0 -%}
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Loved most" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4,
      "info": "Four keeps the page calm. Eight at most."
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" link", "default": true },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "soft", "label": "Soft blush" }
      ],
      "default": "soft"
    }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
