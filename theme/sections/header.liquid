{%- liquid
  assign menu = section.settings.menu
  assign has_sub = false
  for link in menu.links
    if link.links.size > 0
      assign has_sub = true
      break
    endif
  endfor

  # Until the main menu has dropdowns, Demo content shows the planned menu (docs/nav-plan.md §3) so the header can be judged.
  assign demo_menu = false
  if settings.demo_content and has_sub == false
    assign demo_menu = true
  endif

  assign all_url = routes.all_products_collection_url
  assign bar_items = ''
  assign drawer_items = ''
  assign item_count = 0

  if demo_menu
    assign d_titles = 'Shop|Gifts|Bestsellers|Our story|Help' | split: '|'
    assign d_urls = routes.collections_url | append: '|' | append: all_url | append: '|' | append: all_url | append: '|' | append: routes.root_url | append: '|/pages/contact' | split: '|'
    assign item_count = d_titles.size
    assign shop_here = false
    if request.page_type == 'collection' or request.page_type == 'list-collections'
      assign shop_here = true
    endif
    for d_title in d_titles
      assign i = forloop.index0
      assign kt = blank
      assign ku = blank
      assign kh = blank
      assign tiles = false
      assign all_link = false
      assign here = false
      case forloop.index
        when 1
          assign kt = 'Bouquets|Keychains|Hair clips|Bag charms|Flower pots'
          assign kh = 'bouquets|keychains|hair-clips|bag-charms|flower-pots'
          assign ku = all_url | append: '|' | append: all_url | append: '|' | append: all_url | append: '|' | append: all_url | append: '|' | append: all_url
          assign tiles = true
          assign all_link = true
          assign here = shop_here
        when 2
          assign kt = 'Birthday|Anniversary|For her|Under ₹499'
          assign kh = 'birthday|anniversary|for-her|under-499'
          assign ku = all_url | append: '|' | append: all_url | append: '|' | append: all_url | append: '|' | append: all_url
          assign all_link = true
        when 5
          assign kt = 'FAQ|Shipping & delivery|Track order|Contact us'
          assign kh = 'faq|shipping|track-order|contact'
          assign ku = routes.root_url | append: '|/pages/contact|' | append: routes.account_url | append: '|/pages/contact'
          if request.path == '/pages/contact'
            assign here = true
          endif
      endcase
      capture bar_item
        render 'nav-item', place: 'bar', index: forloop.index, title: d_title, url: d_urls[i], here: here, kid_titles: kt, kid_urls: ku, kid_handles: kh, tiles: tiles, all_link: all_link
      endcapture
      capture drawer_item
        render 'nav-item', place: 'drawer', index: forloop.index, title: d_title, url: d_urls[i], here: here, kid_titles: kt, kid_urls: ku, kid_handles: kh, tiles: tiles, all_link: all_link
      endcapture
      assign bar_items = bar_items | append: bar_item
      assign drawer_items = drawer_items | append: drawer_item
    endfor
  else
    # One link is marked as "here": the current page, or the parent of the current page. Only one, so the view transition has a single mark to move.
    assign marked = false
    assign item_count = menu.links.size
    for link in menu.links
      assign here = false
      if marked == false
        if link.current or link.child_current or link.child_active
          assign here = true
          assign marked = true
        endif
      endif
      # A dropdown of collections is a list of crafts: it shows as photo tiles, with a "Shop all" link.
      assign tiles = false
      assign all_link = false
      if link.links.size > 0
        assign collection_kids = link.links | where: 'type', 'collection_link'
        if collection_kids.size > 0
          assign all_link = true
        endif
        if collection_kids.size == link.links.size and link.links.size > 1
          assign tiles = true
        endif
      endif
      capture bar_item
        render 'nav-item', place: 'bar', index: forloop.index, title: link.title, url: link.url, current: link.current, here: here, kids: link.links, tiles: tiles, all_link: all_link
      endcapture
      capture drawer_item
        render 'nav-item', place: 'drawer', index: forloop.index, title: link.title, url: link.url, current: link.current, here: here, kids: link.links, tiles: tiles, all_link: all_link
      endcapture
      assign bar_items = bar_items | append: bar_item
      assign drawer_items = drawer_items | append: drawer_item
    endfor
  endif

  assign whatsapp = settings.social_whatsapp | remove: '+' | remove: ' ' | remove: '-'
-%}

<header class="site-header" data-site-header>
  <div class="site-header__bar page-grid">
    <div class="site-header__row">
      <button
        type="button"
        class="icon-btn site-header__menu-btn"
        aria-controls="MenuDrawer"
        aria-expanded="false"
        data-menu-open
      >
        {%- render 'icon', icon: 'menu' -%}
        <span class="visually-hidden">{{ 'header.open_menu' | t }}</span>
      </button>

      <div class="site-header__logo-wrap">
        <a href="{{ routes.root_url }}" class="site-header__logo" {% if request.page_type == 'index' %}aria-current="page"{% endif %}>
          {%- render 'logo-mark', size: 38, id: 'header' -%}
          <span class="site-header__name">{{ shop.name }}</span>
          {%- comment -%} Screen readers hear "Yarn Basket, home". {%- endcomment -%}
          <span class="visually-hidden">, {{ 'header.home' | t }}</span>
        </a>
      </div>

      {%- if item_count > 0 -%}
        <nav class="site-header__nav" aria-label="{{ 'header.main_menu' | t }}" data-header-nav>
          <ul role="list" class="site-header__nav-list">
            {{- bar_items -}}
          </ul>
        </nav>
      {%- endif -%}

      <div class="site-header__icons">
        {%- comment -%}
          Search (docs/search-plan.md): a real field where there's room (tablet, wide desktop), a lens everywhere else.
          Without JavaScript the field submits and the lens is a link to /search. theme.js swaps the link for the
          button beside it, which opens the search panel; the panel follows here so Tab moves from the field into it.
        {%- endcomment -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="site-header__search-form">
          <label for="HeaderSearch" class="visually-hidden">{{ 'header.search' | t }}</label>
          {%- render 'search-field', id: 'HeaderSearch', value: search.terms, class: 'search-field--header', placeholder: 'header.search_placeholder', live: true -%}
          <input type="hidden" name="options[prefix]" value="last">
        </form>
        <a href="{{ routes.search_url }}" class="icon-btn site-header__search" data-search-fallback {% if request.page_type == 'search' %}aria-current="page"{% endif %}>
          {%- render 'icon', icon: 'search' -%}
          <span class="visually-hidden">{{ 'header.search' | t }}</span>
        </a>
        <button type="button" class="icon-btn site-header__search" aria-haspopup="dialog" aria-controls="SearchPanel" aria-expanded="false" data-search-open hidden {% if request.page_type == 'search' %}aria-current="page"{% endif %}>
          {%- render 'icon', icon: 'search' -%}
          <span class="visually-hidden">{{ 'header.search' | t }}</span>
        </button>
        {%- render 'search-panel' -%}
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="icon-btn site-header__account" {% if request.page_type contains 'customers/' %}aria-current="page"{% endif %}>
            {%- render 'icon', icon: 'account' -%}
            <span class="visually-hidden">{{ 'header.account' | t }}</span>
            <span class="tip" aria-hidden="true">{{ 'header.account' | t }}</span>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="icon-btn site-header__cart" data-no-prerender {% if request.page_type == 'cart' %}aria-current="page"{% endif %}>
          {%- render 'icon', icon: 'cart' -%}
          <span class="site-header__cart-word" aria-hidden="true">{{ 'header.cart' | t }}</span>
          <span class="site-header__count" data-cart-count aria-hidden="true" {% if cart.item_count == 0 %}hidden{% endif %}>
            {%- if cart.item_count > 99 %}99+{% else %}{{ cart.item_count }}{% endif -%}
          </span>
          {%- comment -%} theme.js rewrites this label when the count changes; 99 is swapped for the new number. {%- endcomment -%}
          <span
            class="visually-hidden"
            data-cart-label
            data-zero="{{ 'header.cart_count' | t: count: 0 | escape }}"
            data-one="{{ 'header.cart_count' | t: count: 1 | escape }}"
            data-other="{{ 'header.cart_count' | t: count: 99 | escape }}"
          >
            {{- 'header.cart_count' | t: count: cart.item_count -}}
          </span>
        </a>
      </div>
      {%- comment -%} theme.js writes here when the cart changes, so screen readers hear the new count. {%- endcomment -%}
      <p class="visually-hidden" role="status" data-cart-status></p>
    </div>
  </div>
</header>
{%- comment -%} Dims the page behind the search panel on wider screens; a click on it closes the panel. {%- endcomment -%}
<div class="search-scrim" data-search-scrim hidden></div>

<dialog class="drawer" id="MenuDrawer" aria-label="{{ 'header.menu' | t }}" data-scroll-lock closedby="any">
  <div class="drawer__panel">
    <div class="drawer__top">
      <a href="{{ routes.root_url }}" class="site-header__logo drawer__logo" {% if request.page_type == 'index' %}aria-current="page"{% endif %}>
        {%- render 'logo-mark', size: 34, id: 'drawer' -%}
        <span class="site-header__name">{{ shop.name }}</span>
        {%- comment -%} Screen readers hear "Yarn Basket, home". {%- endcomment -%}
        <span class="visually-hidden">, {{ 'header.home' | t }}</span>
      </a>
      <button type="button" class="icon-btn drawer__close" data-menu-close>
        {%- render 'icon', icon: 'close' -%}
        <span class="visually-hidden">{{ 'header.close_menu' | t }}</span>
      </button>
    </div>

    <nav class="drawer__nav" aria-label="{{ 'header.main_menu' | t }}">
      <ul role="list">
        {{- drawer_items -}}
      </ul>
    </nav>

    {%- assign i = item_count -%}
    <ul class="drawer__secondary" role="list">
      {%- assign i = i | plus: 1 -%}
      <li style="--i: {{ i }}">
        <a href="{{ routes.search_url }}" data-search-fallback>{%- render 'icon', icon: 'search' -%}{{ 'header.search' | t }}</a>
        <button type="button" aria-haspopup="dialog" aria-controls="SearchPanel" aria-expanded="false" data-search-open hidden>
          {%- render 'icon', icon: 'search' -%}{{ 'header.search' | t }}
        </button>
      </li>
      {%- if shop.customer_accounts_enabled -%}
        {%- assign i = i | plus: 1 -%}
        <li style="--i: {{ i }}">
          <a href="{{ routes.account_url }}">{%- render 'icon', icon: 'account' -%}{{ 'header.account' | t }}</a>
        </li>
      {%- endif -%}
      {%- if whatsapp != blank -%}
        {%- assign i = i | plus: 1 -%}
        <li style="--i: {{ i }}">
          <a href="https://wa.me/{{ whatsapp }}?text={{ 'header.whatsapp_message' | t | url_encode }}" rel="noopener" target="_blank">
            {%- render 'icon', icon: 'whatsapp' -%}
            {{ 'header.whatsapp' | t }}
            <span class="visually-hidden">({{ 'accessibility.new_window' | t }})</span>
          </a>
        </li>
      {%- endif -%}
      {%- if settings.social_instagram != blank -%}
        {%- assign i = i | plus: 1 -%}
        <li style="--i: {{ i }}">
          <a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">
            {%- render 'icon', icon: 'instagram' -%}
            Instagram
            <span class="visually-hidden">({{ 'accessibility.new_window' | t }})</span>
          </a>
        </li>
      {%- endif -%}
    </ul>

    <p class="drawer__sign eyebrow">{{ 'general.tagline' | t }}</p>
  </div>
</dialog>

{% stylesheet %}
  /* The section wrapper is what sticks; theme.js sets the state classes on <html>. */
  .header-section {
    position: sticky;
    top: 0;
    z-index: 50;
    view-transition-name: site-header;
    transition: transform var(--dur-panel) var(--ease-out);
  }
  html.header-hidden .header-section:not(:focus-within) { transform: translateY(-100%); transition-timing-function: var(--ease-in-out); }
  /* Positioned so it sits above the search scrim; the search panel hangs from its bottom edge. */
  .site-header {
    position: relative;
    z-index: 1;
    background-color: var(--header-bg, color-mix(in srgb, var(--blush-soft) 88%, transparent));
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-state) ease, background-color var(--dur-panel) ease, box-shadow var(--dur-panel) ease;
  }
  html.header-scrolled .site-header {
    --header-bg: color-mix(in srgb, var(--blush-soft) 88%, transparent);
    border-bottom-color: var(--color-line);
    box-shadow: 0 12px 28px -24px rgb(78 58 49 / .5);
  }

  .site-header__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: var(--header-height);
    gap: var(--space-2);
  }
  .site-header__menu-btn { margin-left: -12px; justify-self: start; }
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    text-decoration: none;
    color: var(--color-heading);
  }
  .site-header__logo .logo-mark { width: 34px; height: 34px; transition: transform var(--dur-enter) var(--ease-spring); }
  .site-header__logo .logo-mark [stroke-width="1.8"] { stroke-width: 2.4; }
  @media (hover: hover) { .site-header__logo:hover .logo-mark { transform: rotate(-6deg) translateY(-1px); } }
  .site-header__name {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -.01em;
    white-space: nowrap;
  }
  .site-header__nav { display: none; }
  .site-header__icons { display: flex; align-items: center; justify-content: flex-end; gap: 4px; margin-right: -10px; }
  /* Header glyphs are 28px: big enough to find at a glance, still inside a 48px target. */
  .site-header .icon-btn > .icon, .drawer__close > .icon { width: 28px; height: 28px; }
  .site-header__account, .site-header__cart-word, .site-header__search-form { display: none; }

  /* Search field (tablet and wide desktop): the pill itself is snippets/search-field. */
  .site-header__search-form { width: clamp(184px, 24vw, 240px); margin-right: var(--space-2); }
  .site-header__search-form .search-field { width: 100%; }

  /* A word under an icon, on hover and keyboard focus. It sits flush under the button so the pointer can move onto it,
     and Esc hides it (theme.js), as WCAG 1.4.13 asks. */
  .tip {
    position: absolute;
    top: 100%;
    left: 50%;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: var(--cocoa-deep);
    color: var(--cream);
    font-size: .8125rem;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    translate: -50% -4px;
    transition: opacity var(--dur-state) ease, translate var(--dur-state) var(--ease-out), visibility 0s linear var(--dur-state);
  }
  .icon-btn:focus-visible > .tip { opacity: 1; visibility: visible; translate: -50% 0; transition-delay: 0s; }
  @media (hover: hover) { .icon-btn:hover > .tip { opacity: 1; visibility: visible; translate: -50% 0; transition-delay: 300ms, 300ms, 300ms; } }
  html.tips-off .tip { display: none; }

  /* Tablet: room for the search field. */
  @media (min-width: 768px) {
    .site-header__search-form { display: flex; }
    .site-header__search { display: none; }
  }

  /* Icons answer the pointer with a small, quiet gesture. */
  .site-header__icons .icon, .site-header__menu-btn .icon { transition: transform var(--dur-panel) var(--ease-spring); }
  @media (hover: hover) {
    .site-header__search:hover .icon { transform: rotate(-10deg) scale(1.06); }
    .site-header__account:hover .icon { transform: translateY(-1px); }
    .site-header__cart:hover .icon { transform: translateX(2px); }
    .site-header__menu-btn:hover .icon { transform: scaleX(1.12); }
  }

  /* The count sits on the cart's top corner, with a ring in the header colour so it never merges with the glyph. */
  .site-header__count {
    position: absolute;
    top: 0;
    right: -3px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: var(--radius-pill);
    background: var(--cocoa-deep);
    color: var(--cream);
    box-shadow: 0 0 0 2px var(--header-bg, var(--blush-soft));
    font-size: .75rem;
    font-weight: 600;
    line-height: 20px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  @media (forced-colors: active) { .site-header__count { border: 1px solid CanvasText; line-height: 18px; } }
  .site-header__count.is-bumped { animation: count-bump 520ms var(--ease-spring); }
  @keyframes count-bump { from { transform: scale(.4); } to { transform: none; } }

  @media (min-width: 1100px) {
    .site-header__row { grid-template-columns: auto 1fr auto; gap: var(--space-6); }
    .site-header__menu-btn { display: none; }
    .site-header__search-form { display: none; }
    .site-header__search { display: inline-grid; }

    /* Cart is the most important button: it gets its word. */
    .site-header__cart { display: inline-flex; gap: 6px; width: auto; padding: 0 14px 0 10px; border-radius: var(--radius-pill); text-decoration: none; }
    .site-header__cart > .icon { width: 26px; height: 26px; }
    .site-header__cart-word { display: inline; font-size: .875rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
    .site-header__count { position: static; box-shadow: none; }
    .site-header__nav { display: block; justify-self: center; }
    .site-header__nav-list { display: flex; gap: clamp(var(--space-5), 2.2vw, var(--space-6)); }
    .site-header__nav-item { position: relative; }
    .site-header__nav-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: var(--tap);
      font-size: .875rem;
      font-weight: 500;
      letter-spacing: .12em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--cocoa-deep);
      transition: color var(--dur-state) ease;
    }
    .site-header__nav-item.is-here > .site-header__nav-link,
    .site-header__nav-item.is-lit > .site-header__nav-link,
    .site-header__nav-link[aria-expanded="true"] { color: var(--color-heading); }
    .site-header__chevron { width: 14px; height: 14px; margin-left: -2px; transition: transform var(--dur-panel) var(--ease-out); }
    .site-header__nav-link[aria-expanded="true"] .site-header__chevron { transform: rotate(180deg); }

    /* The stitch mark: a short run of stitches under the link you're on or pointing at.
       Without JS it sits under the current page; theme.js moves it so it leaves toward the next link
       and the next one draws in from the side it came from. */
    .nav-mark {
      position: absolute;
      left: 0;
      right: .12em;
      bottom: 9px;
      height: 2px;
      border-radius: 2px;
      background: linear-gradient(90deg, currentColor 6px, transparent 0) 0 0 / 10px 2px round;
      transform: scaleX(0);
      transform-origin: var(--mark-from, center);
      transition: transform 380ms var(--ease-out);
      pointer-events: none;
    }
    .site-header__nav-link:has(.site-header__chevron) .nav-mark { right: 20px; }
    .site-header__nav.is-ready .is-lit:not(.is-here) .nav-mark { transform: none; view-transition-name: nav-mark; }

    /* The page you're on keeps a solid line, so "where am I" and "where am I pointing" never look the same:
       solid = current page, dashed stitches = hover or keyboard focus. */
    .site-header__nav-item.is-here > .site-header__nav-link::after {
      content: "";
      position: absolute;
      left: 0;
      right: .12em;
      bottom: 9px;
      height: 1.5px;
      border-radius: 2px;
      background: currentColor;
      pointer-events: none;
    }
    .site-header__nav-item.is-here > .site-header__nav-link:has(.site-header__chevron)::after { right: 20px; }

    /* Dropdown */
    .site-header__sub {
      position: absolute;
      top: 100%;
      left: 50%;
      z-index: 2;
      min-width: 16rem;
      padding: var(--space-3);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      background: var(--cream);
      box-shadow: 0 24px 48px -28px rgb(78 58 49 / .45);
      opacity: 0;
      visibility: hidden;
      translate: -50% -8px;
      scale: .98;
      transform-origin: top center;
      transition: opacity var(--dur-state) ease, translate var(--dur-panel) var(--ease-out), scale var(--dur-panel) var(--ease-out), visibility 0s linear var(--dur-panel);
    }
    /* An invisible bridge, so the pointer can travel from the link to the panel without it closing. */
    .site-header__sub::before { content: ""; position: absolute; inset: -14px 0 100%; }
    .site-header__nav-item.is-open > .site-header__sub {
      opacity: 1;
      visibility: visible;
      translate: -50% 4px;
      scale: 1;
      transition-delay: 0s;
    }
    .site-header__sub-list { display: grid; gap: 2px; }
    .site-header__sub-link, .site-header__sub-all {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      min-height: var(--tap);
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-sm);
      color: var(--color-heading);
      text-decoration: none;
      transition: background-color var(--dur-state) ease, translate var(--dur-state) var(--ease-out);
    }
    .site-header__sub-link .icon--brand { width: 34px; height: 34px; flex: none; }
    .site-header__sub-link:hover, .site-header__sub-link:focus-visible { background: var(--blush-soft); translate: 2px 0; }
    .site-header__sub-link[aria-current] { background: var(--blush-soft); }
    .site-header__sub-all {
      justify-content: space-between;
      margin-top: var(--space-2);
      border-top: 1px dashed var(--color-line-strong);
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      padding-top: var(--space-2);
      font-size: var(--fs-label);
      font-weight: 500;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }
    .site-header__sub-all .icon { width: 18px; height: 18px; transition: translate var(--dur-state) var(--ease-out); }
    .site-header__sub-all:hover .icon, .site-header__sub-all:focus-visible .icon { translate: 4px 0; }
    @media (prefers-reduced-motion: no-preference) {
      .site-header__nav-item.is-open .site-header__sub-list > li {
        animation: sub-item 420ms var(--ease-out) both;
        animation-delay: calc(var(--i) * 35ms);
      }
    }
    @keyframes sub-item { from { opacity: 0; translate: 0 -4px; } }

    .site-header__account { display: inline-grid; }

    /* Shop panel: the crafts as photo tiles. */
    /* Five or more tiles are too wide to centre under "Shop" without running off the left edge, so this panel
       lines up with its menu item instead. */
    .site-header__sub--tiles { left: calc(var(--space-4) * -1); min-width: 0; padding: var(--space-4); translate: 0 -8px; }
    .site-header__nav-item.is-open > .site-header__sub--tiles { translate: 0 4px; }
    .site-header__tiles { display: grid; grid-auto-flow: column; grid-auto-columns: 128px; gap: var(--space-4); }
    .site-header__sub--tiles .site-header__sub-all { margin-top: var(--space-3); }
    @media (prefers-reduced-motion: no-preference) {
      .site-header__nav-item.is-open .site-header__tiles > li {
        animation: sub-item 420ms var(--ease-out) both;
        animation-delay: calc(var(--i) * 40ms);
      }
    }
  }

  @media (min-width: 1280px) {
    .site-header__search-form { display: flex; }
    .site-header__search { display: none; }
  }

  /* Short screens (landscape phones, 400% zoom): the header scrolls away with the page instead of covering it. */
  @media (max-height: 480px) {
    .header-section { position: relative; }
    .site-header__row { min-height: 56px; }
  }

  /* Menu photo tile (snippet: menu-tile), shared by the Shop panel and the drawer. */
  .menu-tile { display: grid; gap: var(--space-2); color: var(--color-heading); text-decoration: none; }
  .menu-tile__media { --ratio: 1; border-radius: var(--radius-sm); background: var(--oat); }
  .menu-tile__img { transition: transform 900ms var(--ease-out); }
  .menu-tile__art { position: absolute; inset: 0; display: grid; place-items: center; }
  .menu-tile__art .icon--brand { width: 52px; height: 52px; }
  .menu-tile__title { font-size: .9375rem; font-weight: 500; line-height: 1.3; }
  .menu-tile[aria-current] .menu-tile__media { outline: 2px solid var(--cocoa-deep); outline-offset: 2px; }
  .menu-tile:active .menu-tile__media { scale: .97; transition: scale var(--dur-press) ease; }
  @media (hover: hover) {
    .menu-tile:hover .menu-tile__img { transform: scale(1.05); }
    .menu-tile:hover .menu-tile__title { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--rose); }
  }

  ::view-transition-group(nav-mark) { animation-duration: 380ms; animation-timing-function: var(--ease-out); }

  /* Menu drawer. theme.js adds [data-closing] first, so it slides out in every browser before it closes. */
  .drawer {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(88vw, 420px);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--cream);
    color: var(--color-ink);
    transform: translateX(-100%);
    touch-action: pan-y;
    transition: transform var(--dur-panel) var(--ease-out), translate var(--dur-panel) var(--ease-out), overlay var(--dur-panel) allow-discrete, display var(--dur-panel) allow-discrete;
  }
  .drawer[open] { transform: none; }
  .drawer[open][data-closing] { transform: translateX(-100%); transition-timing-function: var(--ease-in-out); }
  .drawer.is-dragging { transition: none; }
  @starting-style { .drawer[open] { transform: translateX(-100%); } }
  .drawer::backdrop {
    background: rgba(51, 37, 31, .32);
    opacity: 0;
    transition: opacity var(--dur-panel) ease, overlay var(--dur-panel) allow-discrete, display var(--dur-panel) allow-discrete;
  }
  .drawer[open]::backdrop { opacity: var(--backdrop, 1); }
  .drawer[open][data-closing]::backdrop { opacity: 0; }
  .drawer.is-dragging::backdrop { transition: none; }
  @starting-style { .drawer[open]::backdrop { opacity: 0; } }

  .drawer__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-height: 100%;
    padding: 0 var(--space-5) max(var(--space-6), env(safe-area-inset-bottom));
  }
  /* The logo and × stay pinned while the menu scrolls, so the way out is always where people look for it.
     A hairline appears under it once the list has scrolled (theme.js sets .is-scrolled). */
  .drawer__top {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-inline: calc(var(--space-5) * -1);
    padding: max(var(--space-3), env(safe-area-inset-top)) calc(var(--space-5) - 10px) var(--space-2) var(--space-5);
    background: var(--cream);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-state) ease, box-shadow var(--dur-state) ease;
  }
  .drawer.is-scrolled .drawer__top { border-bottom-color: var(--color-line); box-shadow: 0 10px 20px -18px rgb(78 58 49 / .5); }
  .drawer__logo .site-header__name { font-size: 1.375rem; }
  .drawer__shop { display: grid; gap: var(--space-3); padding-bottom: var(--space-5); margin-bottom: var(--space-2); border-bottom: 1px solid var(--color-line); }
  .drawer__shop-title { margin: 0; }
  /* Crafts 3 across as squares, "Shop all" last: the whole menu fits a phone screen with little or no scrolling. */
  .drawer__tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4) var(--space-3); }
  .drawer__tiles .menu-tile { gap: 6px; }
  .drawer__tiles .menu-tile__media { --ratio: 1; }
  .drawer__tiles .menu-tile__title { font-size: .875rem; line-height: 1.25; text-wrap: balance; }
  .menu-tile--all .menu-tile__media { background: var(--blush); }
  .menu-tile--all .menu-tile__art .icon { width: 26px; height: 26px; color: var(--cocoa-deep); transition: translate var(--dur-state) var(--ease-out); }
  @media (hover: hover) { .menu-tile--all:hover .menu-tile__art .icon { translate: 4px 0; } }
  .drawer__close .icon { transition: transform var(--dur-panel) var(--ease-spring); }
  @media (hover: hover) { .drawer__close:hover .icon { transform: rotate(90deg); } }
  .drawer__nav > ul { display: grid; }
  .drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: 1.625rem;
    line-height: 1.15;
    color: var(--color-heading);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }
  .drawer__link::-webkit-details-marker { display: none; }
  a.drawer__link { justify-content: flex-start; }
  .drawer__link[aria-current] { text-decoration: underline; text-decoration-color: var(--rose); text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .drawer__chevron { width: 24px; height: 24px; transition: transform var(--dur-panel) var(--ease-out); }
  .drawer__group[open] .drawer__chevron { transform: rotate(180deg); }
  .drawer__group::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size var(--dur-panel) var(--ease-out), content-visibility var(--dur-panel) allow-discrete;
  }
  .drawer__group[open]::details-content { block-size: auto; }
  .drawer__sub { display: grid; gap: 2px; margin: 0 0 var(--space-3) 2px; padding: var(--space-1) 0 var(--space-1) var(--space-4); border-left: 1px dashed var(--color-line-strong); }
  .drawer__sub a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    padding: var(--space-1) var(--space-2);
    margin-inline: calc(var(--space-2) * -1);
    border-radius: var(--radius-sm);
    color: var(--color-heading);
    text-decoration: none;
    font-size: 1.0625rem;
  }
  .drawer__sub a:active { background: var(--blush-soft); }
  .drawer__sub a[aria-current] { background: var(--blush-soft); }
  .drawer__sub .icon--brand { width: 36px; height: 36px; flex: none; }
  .drawer__sub-all { justify-content: space-between; font-size: var(--fs-label) !important; font-weight: 500; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .drawer__sub-all .icon { width: 18px; height: 18px; }

  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] :is(.drawer__nav > ul, .drawer__secondary) > li {
      animation: drawer-item 520ms var(--ease-out) both;
      animation-delay: calc(60ms + var(--i) * 45ms);
    }
  }
  @keyframes drawer-item { from { opacity: 0; transform: translateX(-16px); } }
  .drawer__secondary { display: grid; gap: var(--space-1); padding-top: var(--space-5); border-top: 1px solid var(--color-line); }
  .drawer__secondary :is(a, button) {
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    text-decoration: none;
    color: var(--color-ink);
  }
  .drawer__secondary .icon { width: 20px; height: 20px; }
  .drawer__sign { margin-top: auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Keep it short: 4–6 links work best on phones."
    }
  ]
}
{% endschema %}
