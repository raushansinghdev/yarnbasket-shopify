{%- assign menu = section.settings.menu -%}

<header class="site-header" data-site-header>
  <div class="site-header__bar page-grid">
    <div class="site-header__row">
      <button
        type="button"
        class="icon-btn site-header__menu-btn"
        aria-controls="MenuDrawer"
        aria-expanded="false"
        data-menu-open
      >
        {%- render 'icon', icon: 'menu' -%}
        <span class="visually-hidden">{{ 'header.open_menu' | t }}</span>
      </button>

      <div class="site-header__logo-wrap">
        <a href="{{ routes.root_url }}" class="site-header__logo" {% if request.page_type == 'index' %}aria-current="page"{% endif %}>
          {%- render 'logo-mark', size: 38, id: 'header' -%}
          <span class="site-header__name">{{ shop.name }}</span>
        </a>
      </div>

      {%- if menu.links.size > 0 -%}
        <nav class="site-header__nav" aria-label="{{ 'header.main_menu' | t }}">
          <ul role="list">
            {%- for link in menu.links -%}
              <li>
                <a href="{{ link.url }}" class="site-header__nav-link" {% if link.current %}aria-current="page"{% endif %}>
                  {{- link.title -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="site-header__icons">
        <a href="{{ routes.search_url }}" class="icon-btn">
          {%- render 'icon', icon: 'search' -%}
          <span class="visually-hidden">{{ 'header.search' | t }}</span>
        </a>
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="icon-btn site-header__account">
            {%- render 'icon', icon: 'account' -%}
            <span class="visually-hidden">{{ 'header.account' | t }}</span>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="icon-btn site-header__cart" data-no-prerender>
          {%- render 'icon', icon: 'basket' -%}
          <span class="site-header__count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
            {{- cart.item_count -}}
          </span>
          <span class="visually-hidden">{{ 'header.cart_count' | t: count: cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>
</header>

<dialog class="drawer" id="MenuDrawer" aria-label="{{ 'header.menu' | t }}" data-scroll-lock closedby="any">
  <div class="drawer__panel">
    <div class="drawer__top">
      <span class="eyebrow">{{ 'header.menu' | t }}</span>
      <button type="button" class="icon-btn" data-menu-close>
        {%- render 'icon', icon: 'close' -%}
        <span class="visually-hidden">{{ 'header.close_menu' | t }}</span>
      </button>
    </div>

    <nav class="drawer__nav" aria-label="{{ 'header.main_menu' | t }}">
      <ul role="list">
        {%- for link in menu.links -%}
          <li style="--i: {{ forloop.index }}">
            <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <ul class="drawer__secondary" role="list">
      {%- if shop.customer_accounts_enabled -%}
        <li>
          <a href="{{ routes.account_url }}">{%- render 'icon', icon: 'account' -%}{{ 'header.account' | t }}</a>
        </li>
      {%- endif -%}
      <li>
        <a href="{{ routes.search_url }}">{%- render 'icon', icon: 'search' -%}{{ 'header.search' | t }}</a>
      </li>
      {%- if settings.social_instagram != blank -%}
        <li>
          <a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">
            {%- render 'icon', icon: 'instagram' -%}
            Instagram
          </a>
        </li>
      {%- endif -%}
    </ul>

    <p class="drawer__sign eyebrow">{{ 'general.tagline' | t }}</p>
  </div>
</dialog>

{% stylesheet %}
  /* The section wrapper is what sticks; theme.js sets the state classes on <html>. */
  .header-section {
    position: sticky;
    top: 0;
    z-index: 50;
    view-transition-name: site-header;
    transition: transform var(--dur-panel) var(--ease-out);
  }
  html.header-hidden .header-section:not(:focus-within) { transform: translateY(-100%); }
  .site-header {
    background: color-mix(in srgb, var(--blush-soft) 88%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-state) ease;
  }
  html.header-scrolled .site-header { border-bottom-color: var(--color-line); }

  .site-header__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: var(--header-height);
    gap: var(--space-2);
  }
  .site-header__menu-btn { margin-left: -12px; justify-self: start; }
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    text-decoration: none;
    color: var(--color-heading);
  }
  .site-header__logo .logo-mark { width: 34px; height: 34px; }
  .site-header__logo .logo-mark [stroke-width="1.8"] { stroke-width: 2.4; }
  .site-header__name {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -.01em;
    white-space: nowrap;
  }
  .site-header__nav { display: none; }
  .site-header__icons { display: flex; justify-content: flex-end; margin-right: -12px; }
  .site-header__account { display: none; }

  .site-header__count {
    position: absolute;
    top: 7px;
    right: 5px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: var(--radius-pill);
    background: var(--cocoa-deep);
    color: var(--cream);
    font-size: .6875rem;
    font-weight: 500;
    line-height: 18px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .site-header__count.is-bumped { animation: count-bump 520ms var(--ease-spring); }
  @keyframes count-bump { from { transform: scale(.4); } to { transform: none; } }

  @media (min-width: 990px) {
    .site-header__row { grid-template-columns: auto 1fr auto; gap: var(--space-6); }
    .site-header__menu-btn { display: none; }
    .site-header__nav { display: block; justify-self: center; }
    .site-header__nav ul { display: flex; gap: clamp(var(--space-5), 2.5vw, var(--space-7)); }
    .site-header__nav-link {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
      font-size: .8125rem;
      font-weight: 500;
      letter-spacing: .16em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--color-heading);
      background: linear-gradient(currentColor, currentColor) no-repeat 0 calc(50% + .9em) / 0 1px;
      transition: background-size var(--dur-panel) var(--ease-out);
    }
    .site-header__nav-link:hover, .site-header__nav-link[aria-current] { background-size: 100% 1px; }
    .site-header__account { display: inline-grid; }
  }

  /* Menu drawer */
  .drawer {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(88vw, 420px);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--cream);
    color: var(--color-ink);
    transform: translateX(-100%);
    transition: transform var(--dur-panel) var(--ease-out), overlay var(--dur-panel) allow-discrete, display var(--dur-panel) allow-discrete;
  }
  .drawer[open] { transform: none; }
  @starting-style { .drawer[open] { transform: translateX(-100%); } }
  .drawer::backdrop {
    background: rgba(51, 37, 31, .32);
    opacity: 0;
    transition: opacity var(--dur-panel) ease, overlay var(--dur-panel) allow-discrete, display var(--dur-panel) allow-discrete;
  }
  .drawer[open]::backdrop { opacity: 1; }
  @starting-style { .drawer[open]::backdrop { opacity: 0; } }

  .drawer__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-height: 100%;
    padding: max(var(--space-3), env(safe-area-inset-top)) var(--space-5) max(var(--space-6), env(safe-area-inset-bottom));
  }
  .drawer__top { display: flex; align-items: center; justify-content: space-between; margin-right: -12px; }
  .drawer__nav ul { display: grid; gap: var(--space-1); }
  .drawer__nav a {
    display: block;
    padding: var(--space-2) 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: 2.125rem;
    line-height: 1.15;
    color: var(--color-heading);
    text-decoration: none;
  }
  .drawer__nav a[aria-current] { text-decoration: underline; text-decoration-color: var(--rose); text-underline-offset: 6px; text-decoration-thickness: 2px; }
  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] .drawer__nav li {
      animation: drawer-item 520ms var(--ease-out) both;
      animation-delay: calc(60ms + var(--i) * 45ms);
    }
  }
  @keyframes drawer-item { from { opacity: 0; transform: translateX(-16px); } }
  .drawer__secondary { display: grid; gap: var(--space-1); padding-top: var(--space-5); border-top: 1px solid var(--color-line); }
  .drawer__secondary a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    text-decoration: none;
    color: var(--color-ink);
  }
  .drawer__secondary .icon { width: 20px; height: 20px; }
  .drawer__sign { margin-top: auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Keep it short: 4–6 links work best on phones."
    }
  ]
}
{% endschema %}
