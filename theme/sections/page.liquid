{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  Two pages are recognised by their handle, so they work whatever template the admin picked (docs/account-plan.md):
  "saved" (Saved items) and "track-order" (Track your order). The live theme's template list doesn't include ours
  until this theme is published.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}
{%- case page.handle -%}
  {%- when 'saved' -%}
    {%- render 'saved-body' -%}
  {%- when 'track-order' -%}
    {%- render 'track-order-body' -%}
  {%- else -%}
    <h1>{{ page.title }}</h1>

    {{ page.content }}
{%- endcase -%}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
