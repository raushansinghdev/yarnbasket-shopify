{%- liquid
  assign s = section.settings

  # The Shop list follows the main menu's first dropdown unless a menu is picked, so a craft added to the header
  # appears here too (docs/footer-plan.md).
  assign shop_title = s.menu_shop.title
  assign shop_links = s.menu_shop.links
  unless shop_links.size > 0
    for link in linklists['main-menu'].links
      if link.links.size > 0
        assign shop_title = link.title
        assign shop_links = link.links
        break
      endif
    endfor
  endunless

  assign whatsapp = settings.social_whatsapp | remove: '+' | remove: ' ' | remove: '-'
  assign has_hello = false
  if whatsapp != blank or settings.social_instagram != blank or settings.social_email != blank
    assign has_hello = true
  endif
-%}

{%- comment -%}
  Links first, signature last (docs/footer-plan.md): short lists on one grid, sharing the page's left edge, and the
  brand signing off like the label sewn onto a finished piece: the basket, the name and the tagline.
  The signature comes first in the markup (it leads on wide screens) and moves under the lists on phones.
{%- endcomment -%}
<footer class="section footer scheme-{{ s.scheme | default: 'soft' }}">
  <div class="footer__inner">
    <div class="footer__sign" data-arrive="lines">
      <a href="{{ routes.root_url }}" class="footer__logo">
        {%- render 'logo-mark', size: 56, id: 'footer', class: 'footer__mark' -%}
        <span class="footer__lockup">
          <span class="footer__name">{{ shop.name }}</span>
          <span class="footer__tagline">{{ 'general.tagline' | t }}</span>
        </span>
      </a>
      {%- comment -%} One faint outline flower, as on the brand banner. It never moves. {%- endcomment -%}
      <svg class="footer__flower" viewBox="-15 -15 30 30" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width=".8">
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(72)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(144)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(216)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(288)"/>
        <circle r="2.2"/>
      </svg>
    </div>

    <div class="footer__lists">
      {%- if shop_links.size > 0 -%}
        <nav class="footer__list footer__list--shop" aria-labelledby="Footer-shop">
          <h2 class="eyebrow" id="Footer-shop">{{ shop_title }}</h2>
          <ul role="list">
            {%- for link in shop_links -%}
              {%- liquid
                # The menu says "Hair" under a photo; a bare list needs the whole name.
                assign title = link.title
                if link.type == 'collection_link' and link.object.handle == 'hair-accessories'
                  assign title = 'general.hair_accessories' | t
                endif
              -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if s.menu_help.links.size > 0 -%}
        <nav class="footer__list footer__list--help" aria-labelledby="Footer-help">
          <h2 class="eyebrow" id="Footer-help">{{ s.menu_help.title }}</h2>
          <ul role="list">
            {%- for link in s.menu_help.links -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- comment -%} Only the channels filled in under Theme settings → Social. With none, Help's "Contact us" does the job. {%- endcomment -%}
      {%- if has_hello -%}
        <div class="footer__list footer__list--hello">
          <h2 class="eyebrow" id="Footer-hello">{{ 'general.say_hello' | t }}</h2>
          <ul class="footer__social" role="list" aria-labelledby="Footer-hello">
            {%- if whatsapp != blank -%}
              <li>
                <a class="icon-btn" href="https://wa.me/{{ whatsapp }}?text={{ 'header.whatsapp_message' | t | url_encode }}" rel="noopener" target="_blank">
                  {%- render 'icon', icon: 'whatsapp' -%}<span class="visually-hidden">WhatsApp ({{ 'accessibility.new_window' | t }})</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_instagram != blank -%}
              <li>
                <a class="icon-btn" href="{{ settings.social_instagram }}" rel="noopener" target="_blank">
                  {%- render 'icon', icon: 'instagram' -%}<span class="visually-hidden">Instagram ({{ 'accessibility.new_window' | t }})</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_email != blank -%}
              <li>
                <a class="icon-btn" href="mailto:{{ settings.social_email | strip | escape }}">
                  {%- render 'icon', icon: 'mail' -%}<span class="visually-hidden">{{ 'general.email' | t }}</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    <div class="footer__base">
      <p class="footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ 'general.made_in' | t }}</p>
      {%- if shop.policies.size > 0 -%}
        <ul class="footer__policies" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" role="list" aria-label="{{ 'general.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <a class="icon-btn footer__top" href="#top">
        {%- render 'icon', icon: 'arrow' -%}<span class="visually-hidden">{{ 'general.back_to_top' | t }}</span>
      </a>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    padding-top: var(--space-6);
    padding-bottom: max(var(--space-5), env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line);
  }
  .footer a { color: inherit; text-decoration: none; }
  /* A row of stitches instead of a plain rule, as on the brand's Instagram covers. One per footer. */
  .footer__sign, .footer__base { --stitches: repeating-linear-gradient(90deg, var(--color-line-strong) 0 7px, transparent 7px 13px) top left / 100% 1.5px no-repeat; }

  /* Phones: the lists, the stitches, the signature, the last lines. Everything starts at the page's left edge. */
  .footer__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-5); container-type: inline-size; }
  .footer__sign { position: relative; order: 1; padding-top: var(--space-5); background: var(--stitches); }
  /* Faint through its colour, not opacity: the arrival checks read low opacity as an arrival that never finished.
     It sits in the clear space right of the name, beside the logo at every width. */
  .footer__flower { position: absolute; right: 2px; bottom: 2px; width: 52px; height: 52px; rotate: 14deg; color: color-mix(in srgb, var(--taupe) 32%, transparent); pointer-events: none; }
  .footer__base { order: 2; }

  /* Narrow phones: smaller, so it keeps clear of the tagline. */
  @media (max-width: 349px) { .footer__flower { width: 32px; height: 32px; bottom: 12px; } }

  /* The signature: the basket beside the name and tagline, as on the brand kit's horizontal logo. */
  .footer__logo { display: inline-flex; align-items: center; gap: var(--space-3); max-width: 100%; }
  /* The drawing has a little air on its left: pulled back so the basket sits on the lists' left edge. */
  .footer__mark { width: 56px; height: 56px; flex: none; margin-left: -5px; transition: transform var(--dur-panel) var(--ease-out); }
  .footer__lockup { display: grid; gap: 6px; min-width: 0; }
  .footer__name {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    /* Capped by the screen's width, so the name stays on one line beside the basket at large text. */
    font-size: min(2rem, 9.5vw);
    line-height: 1;
    color: var(--color-heading);
  }
  .footer__tagline {
    font-size: .6875rem;
    font-weight: 500;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @media (hover: hover) { .footer__logo:hover .footer__mark { transform: rotate(-6deg); } }

  /* Two equal columns: Shop on the left; Help, then Say hello, on the right. */
  .footer__lists { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto 1fr; gap: var(--space-4); align-items: start; }
  .footer__list--shop { grid-row: span 2; }
  /* Large text: one column, so no link is broken mid-word. */
  @container (max-width: 15em) {
    .footer__lists { grid-template-columns: minmax(0, 1fr); }
  }
  .footer__list h2 { margin-bottom: var(--space-2); line-height: 1.6; }
  .footer__list li { display: flex; }
  .footer__list:not(.footer__list--hello) a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: .9375rem;
    line-height: 1.3;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 calc(50% + .75em) / 0 1px;
    transition: background-size var(--dur-panel) var(--ease-out);
  }
  .footer__list a[aria-current] { color: var(--color-heading); font-weight: 500; }
  @media (hover: hover) {
    .footer__list:not(.footer__list--hello) a:hover { background-size: 100% 1px; }
  }

  /* Round outlined buttons, so the contact channels and "Back to top" read as one set. */
  /* 40px on phones, so three fit one row in half of a 320px screen. */
  .footer .icon-btn { width: 40px; height: 40px; border: 1px solid var(--color-line-strong); }
  .footer__social { display: flex; flex-wrap: wrap; gap: var(--space-1); padding-top: 2px; }
  .footer__top .icon { rotate: -90deg; }

  /* The last lines. "Back to top" sits at the right, beside them. */
  .footer__base {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 var(--space-4);
    font-size: .8125rem;
    color: var(--color-muted);
  }
  .footer__base > * { grid-column: 1; }
  .footer__base > .footer__top { grid-column: 2; grid-row: 1 / span 3; }
  .footer__policies { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); }
  .footer__policies a { display: inline-flex; min-height: 32px; align-items: center; }
  .footer__policies a:hover { color: var(--color-heading); }
  .footer__payments { display: flex; flex-wrap: wrap; gap: var(--space-2); padding-block: var(--space-2); }
  .footer__payments svg { width: 38px; height: 24px; }

  /* Tablets: the signature leads, the three lists sit in a row under it, and the stitches move above the last line. */
  @media (min-width: 750px) {
    .footer { padding-top: var(--space-7); }
    .footer__inner { gap: var(--space-6); }
    .footer__sign { order: 0; padding-top: 0; background: none; }
    /* However many lists there are, they share the row equally. */
    .footer__lists { grid-template-columns: none; grid-template-rows: auto; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
    .footer__list--shop { grid-row: auto; }
    .footer__base { padding-top: var(--space-5); background: var(--stitches); }
    .footer .icon-btn { width: 44px; height: 44px; }
    .footer__social { gap: var(--space-2); }
    .footer__mark { width: 64px; height: 64px; }
    .footer__name { font-size: 2.5rem; }
    .footer__tagline { font-size: .75rem; letter-spacing: .28em; }
  }
  /* Desktop: one row. The signature takes the left five of twelve columns, the lists the rest. */
  @media (min-width: 990px) {
    .footer__inner { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-6) var(--space-5); }
    .footer__flower { top: 0; right: 12%; bottom: auto; width: 68px; height: 68px; }
    .footer__base { grid-column: 1 / -1; display: flex; gap: var(--space-5); }
    .footer__copy { margin-right: auto; }
    .footer__policies { gap: 0 var(--space-5); }
    .footer__payments { padding-block: 0; }
    .footer__list:not(.footer__list--hello) a { min-height: 32px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_shop",
      "label": "Shop list",
      "info": "Leave empty to follow the main menu's first dropdown, so the two never drift apart."
    },
    { "type": "link_list", "id": "menu_help", "label": "Help list", "default": "footer", "info": "Help links, such as track order, contact, shipping and returns. The menu's name is the list's heading." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "options": [
        { "value": "soft", "label": "Soft blush" },
        { "value": "blush", "label": "Blush (brand colour)" }
      ],
      "default": "soft"
    }
  ]
}
{% endschema %}
