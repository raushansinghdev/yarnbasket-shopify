{%- assign s = section.settings -%}

<footer class="section footer scheme-{{ section.settings.scheme | default: 'soft' }}">
  <div class="footer__grid">
    <div class="footer__brand">
      {%- comment -%} The logo lockup from the brand kit's banner: basket mark, name, and "Handmade with love". {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="footer__logo">
        {%- render 'logo-mark', size: 64, id: 'footer', class: 'footer__mark' -%}
        <span class="footer__lockup">
          <span class="footer__name">{{ shop.name }}</span>
          <span class="footer__tagline">{{ 'general.tagline' | t }}</span>
        </span>
      </a>
      {%- if s.text != blank -%}<p class="footer__text">{{ s.text }}</p>{%- endif -%}
      <ul class="footer__social" role="list">
        {%- if settings.social_instagram != blank -%}
          <li>
            <a class="icon-btn" href="{{ settings.social_instagram }}" rel="noopener" target="_blank">
              {%- render 'icon', icon: 'instagram' -%}<span class="visually-hidden">Instagram</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_whatsapp != blank -%}
          <li>
            <a class="icon-btn" href="https://wa.me/{{ settings.social_whatsapp | remove: '+' | remove: ' ' }}" rel="noopener" target="_blank">
              {%- render 'icon', icon: 'whatsapp' -%}<span class="visually-hidden">WhatsApp</span>
            </a>
          </li>
        {%- endif -%}
      </ul>
    </div>

    {%- for i in (1..2) -%}
      {%- liquid
        if i == 1
          assign menu = s.menu_shop
        else
          assign menu = s.menu_help
        endif
      -%}
      {%- if menu.links.size > 0 -%}
        <nav class="footer__menu" aria-labelledby="FooterMenu-{{ i }}">
          <h2 class="eyebrow" id="FooterMenu-{{ i }}">{{ menu.title }}</h2>
          <ul role="list">
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="footer__base">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ 'general.made_in' | t }}</p>
    {%- if shop.policies.size > 0 -%}
      <ul class="footer__policies" role="list">
        {%- for policy in shop.policies -%}
          <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payments" role="list" aria-label="{{ 'general.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .footer { padding-bottom: max(var(--space-6), env(safe-area-inset-bottom)); }
  .footer.scheme-blush { border-top: 1px solid var(--color-line-strong); }
  .footer a { color: inherit; text-decoration: none; }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--space-5);
    padding-bottom: var(--space-7);
  }
  .footer__brand { grid-column: 1 / -1; display: grid; gap: var(--space-4); justify-items: start; max-width: 24rem; }
  .footer__logo { display: inline-flex; align-items: center; gap: var(--space-3); margin-left: -4px; }
  .footer__mark { width: 60px; height: 60px; flex: none; transition: transform var(--dur-panel) var(--ease-out); }
  .footer__lockup { display: grid; gap: 6px; }
  .footer__name {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: 2.25rem;
    line-height: 1;
    color: var(--color-heading);
  }
  .footer__tagline {
    font-size: .6875rem;
    font-weight: 500;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @media (hover: hover) { .footer__logo:hover .footer__mark { transform: rotate(-6deg); } }
  .footer__text { color: var(--color-muted); font-size: var(--fs-small); }
  .footer__social { display: flex; gap: var(--space-1); margin-left: -12px; }
  .footer__social .icon-btn { color: var(--color-heading); }
  .footer__menu { display: grid; gap: var(--space-3); align-content: start; }
  .footer__menu h2 { color: var(--color-muted); }
  .footer__menu ul { display: grid; }
  .footer__menu a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-ink);
    background: linear-gradient(currentColor, currentColor) no-repeat 0 calc(50% + .8em) / 0 1px;
    transition: background-size var(--dur-panel) var(--ease-out);
  }
  @media (hover: hover) { .footer__menu a:hover { background-size: 100% 1px; } }

  .footer__base {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
    /* A row of stitches instead of a plain rule, as on the brand's Instagram covers. */
    background: repeating-linear-gradient(90deg, var(--color-line-strong) 0 7px, transparent 7px 13px) top left / 100% 1.5px no-repeat;
    font-size: .8125rem;
    color: var(--color-muted);
  }
  .footer__policies { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
  .footer__policies a { display: inline-flex; min-height: 32px; align-items: center; }
  .footer__policies a:hover { color: var(--color-heading); }
  .footer__payments { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .footer__payments svg { width: 38px; height: 24px; }

  @media (min-width: 990px) {
    .footer__grid { grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); }
    .footer__brand { grid-column: auto; }
    .footer__mark { width: 72px; height: 72px; }
    .footer__name { font-size: 2.625rem; }
    .footer__base { grid-template-columns: auto 1fr auto; align-items: center; }
    .footer__policies { justify-content: center; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Short text",
      "default": "Handmade crochet flowers, keychains, hair clips and bag charms, made to be gifted."
    },
    { "type": "link_list", "id": "menu_shop", "label": "First menu", "default": "footer" },
    { "type": "link_list", "id": "menu_help", "label": "Second menu" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "options": [
        { "value": "soft", "label": "Soft blush" },
        { "value": "blush", "label": "Blush (brand colour)" }
      ],
      "default": "soft"
    }
  ]
}
{% endschema %}
