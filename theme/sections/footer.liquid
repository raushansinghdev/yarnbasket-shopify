{%- assign s = section.settings -%}

{%- comment -%}
  Built from the brand kit's banner (Brand Kit/3-banner) and horizontal logo (Brand Kit/1-logo/logo-horizontal-colour):
  the basket mark beside "Yarn Basket" and "Handmade with love", a short rule, the crafts on one line,
  and faint outline flowers in the corners. The logo is live text, so it stays sharp and readable.
{%- endcomment -%}
<footer class="section footer scheme-{{ s.scheme | default: 'soft' }}">
  <svg class="footer__flower footer__flower--a" viewBox="0 0 30 30" aria-hidden="true" focusable="false"><use href="#yb-footer-flower"/></svg>
  <svg class="footer__flower footer__flower--b" viewBox="0 0 30 30" aria-hidden="true" focusable="false"><use href="#yb-footer-flower"/></svg>
  <svg class="footer__flower footer__flower--c" viewBox="0 0 30 30" aria-hidden="true" focusable="false"><use href="#yb-footer-flower"/></svg>
  <svg class="footer__flower footer__flower--d" viewBox="0 0 30 30" aria-hidden="true" focusable="false"><use href="#yb-footer-flower"/></svg>

  <div class="footer__banner" data-arrive="lines">
    <a href="{{ routes.root_url }}" class="footer__logo">
      {%- render 'logo-mark', size: 104, id: 'footer', class: 'footer__mark' -%}
      <span class="footer__lockup">
        <span class="footer__name">{{ shop.name }}</span>
        <span class="footer__tagline">{{ 'general.tagline' | t }}</span>
      </span>
    </a>

    <span class="footer__rule" aria-hidden="true"></span>

    {%- if s.menu_crafts.links.size > 0 -%}
      <nav class="footer__crafts" aria-label="{{ s.menu_crafts.title | escape }}">
        <ul role="list">
          {%- for link in s.menu_crafts.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- elsif settings.demo_content -%}
      <nav class="footer__crafts" aria-label="{{ 'general.crafts' | t }}">
        <ul role="list">
          {%- assign demo_crafts = 'Crochet bouquets,Keychains,Hair clips,Bag charms' | split: ',' -%}
          {%- for craft in demo_crafts -%}
            <li><a href="{{ routes.collections_url }}">{{ craft }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if settings.social_instagram != blank or settings.social_whatsapp != blank -%}
      <ul class="footer__social" role="list">
        {%- if settings.social_instagram != blank -%}
          <li>
            <a class="icon-btn" href="{{ settings.social_instagram }}" rel="noopener" target="_blank">
              {%- render 'icon', icon: 'instagram' -%}<span class="visually-hidden">Instagram ({{ 'accessibility.new_window' | t }})</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_whatsapp != blank -%}
          <li>
            <a class="icon-btn" href="https://wa.me/{{ settings.social_whatsapp | remove: '+' | remove: ' ' | remove: '-' }}" rel="noopener" target="_blank">
              {%- render 'icon', icon: 'whatsapp' -%}<span class="visually-hidden">WhatsApp ({{ 'accessibility.new_window' | t }})</span>
            </a>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>

  {%- liquid
    assign has_menus = false
    if s.menu_shop.links.size > 0 or s.menu_help.links.size > 0
      assign has_menus = true
    endif
  -%}
  {%- if has_menus -%}
    <div class="footer__menus">
      {%- for i in (1..2) -%}
        {%- liquid
          if i == 1
            assign menu = s.menu_shop
          else
            assign menu = s.menu_help
          endif
        -%}
        {%- if menu.links.size > 0 -%}
          <nav class="footer__menu" aria-label="{{ menu.title | escape }}">
            <ul role="list">
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="footer__base">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ 'general.made_in' | t }}</p>
    {%- if shop.policies.size > 0 -%}
      <ul class="footer__policies" role="list">
        {%- for policy in shop.policies -%}
          <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payments" role="list" aria-label="{{ 'general.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <svg width="0" height="0" class="visually-hidden" aria-hidden="true" focusable="false">
    <symbol id="yb-footer-flower" viewBox="-15 -15 30 30">
      <g fill="none" stroke="currentColor" stroke-width=".8">
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(72)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(144)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(216)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(288)"/>
        <circle r="2.2"/>
      </g>
    </symbol>
  </svg>
</footer>

{% stylesheet %}
  .footer {
    position: relative;
    overflow: clip;
    padding-bottom: max(var(--space-6), env(safe-area-inset-bottom));
    text-align: center;
  }
  .footer.scheme-blush { border-top: 1px solid var(--color-line-strong); }
  .footer a { color: inherit; text-decoration: none; }

  /* The banner: logo lockup, short rule, crafts on one line. */
  .footer__banner { position: relative; display: grid; justify-items: center; gap: var(--space-5); padding-bottom: var(--space-8); }
  .footer__logo { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-3) var(--space-4); max-width: 100%; text-align: left; }
  .footer__mark { width: 76px; height: 76px; flex: none; transition: transform var(--dur-panel) var(--ease-out); }
  .footer__lockup { display: grid; gap: 8px; min-width: 0; }
  .footer__name {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    /* Capped by the screen's width, so the name stays on one line beside the basket at large text. */
    font-size: min(2.375rem, 11.5vw);
    line-height: 1;
    color: var(--color-heading);
  }
  .footer__tagline {
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @media (hover: hover) { .footer__logo:hover .footer__mark { transform: rotate(-6deg); } }

  .footer__rule { width: min(220px, 50%); height: 1px; background: var(--color-line-strong); }
  /* The short rule draws itself as the banner arrives. */
  @media (prefers-reduced-motion: no-preference) {
    .footer__banner.is-arriving > .footer__rule { animation-name: rule-draw; animation-duration: var(--dur-hero); }
  }
  @keyframes rule-draw { from { opacity: 0; transform: scaleX(0); } }

  /* Phones: two neat columns. Wider screens: one line with dots, as on the banner. */
  .footer__crafts ul { display: grid; grid-template-columns: repeat(2, minmax(0, auto)); justify-content: center; gap: 0 var(--space-6); }
  /* Large text: one column, so no craft's name is broken mid-word. */
  .footer__crafts { width: 100%; container-type: inline-size; }
  @container (max-width: 13em) { .footer__crafts ul { grid-template-columns: minmax(0, auto); } }
  .footer__crafts li { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-3); }
  .footer__crafts a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--color-heading);
    background: linear-gradient(currentColor, currentColor) no-repeat 0 calc(50% + .9em) / 0 1px;
    transition: background-size var(--dur-panel) var(--ease-out);
  }

  .footer__social { display: flex; justify-content: center; gap: var(--space-1); }
  .footer__social .icon-btn { color: var(--color-heading); }

  /* Help and policy links: one quiet centred row per menu, wrapping on phones. */
  .footer__menus { display: grid; gap: var(--space-2); padding-bottom: var(--space-6); }
  .footer__menu ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 var(--space-5); }
  .footer__menu a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-ink);
    background: linear-gradient(currentColor, currentColor) no-repeat 0 calc(50% + .8em) / 0 1px;
    transition: background-size var(--dur-panel) var(--ease-out);
  }
  @media (hover: hover) {
    .footer__crafts a:hover, .footer__menu a:hover { background-size: 100% 1px; }
  }

  .footer__base {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding-top: var(--space-5);
    /* A row of stitches instead of a plain rule, as on the brand's Instagram covers. */
    background: repeating-linear-gradient(90deg, var(--color-line-strong) 0 7px, transparent 7px 13px) top left / 100% 1.5px no-repeat;
    font-size: .8125rem;
    color: var(--color-muted);
  }
  .footer__policies { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-1) var(--space-4); }
  .footer__policies a { display: inline-flex; min-height: 32px; align-items: center; }
  .footer__policies a:hover { color: var(--color-heading); }
  .footer__payments { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); }
  .footer__payments svg { width: 38px; height: 24px; }

  /* Faint outline flowers in the corners, as on the banner. They drift up and turn into place as the footer
     scrolls in (tied to the scroll), and then keep floating very slowly, each at its own pace.
     They stay in the corners, clear of all text and links. Reduced motion: still.
     Deliberate exception to WCAG 2.2.2 (no pause control), decided with Raushan: see docs/decisions.md. */
  .footer__flower { position: absolute; color: var(--taupe); opacity: .3; pointer-events: none; --fd: 13s; --fdl: 0s; }
  .footer__flower--a { --fy: 46px; --fr: -48deg; }
  .footer__flower--b { --fy: 30px; --fr: 36deg; --fd: 15.5s; --fdl: -5s; }
  .footer__flower--c { --fy: 56px; --fr: -30deg; --fd: 12s; --fdl: -8s; }
  .footer__flower--d { --fy: 38px; --fr: 54deg; --fd: 17s; --fdl: -3s; }
  @media (prefers-reduced-motion: no-preference) {
    .footer__flower { animation: footer-float var(--fd) ease-in-out var(--fdl) infinite alternate; }
    @supports (animation-timeline: view()) {
      .footer { view-timeline-name: --footer; }
      .footer__flower {
        animation: footer-drift linear both, footer-float var(--fd) ease-in-out var(--fdl) infinite alternate;
        animation-timeline: --footer, auto;
        animation-range: entry 5% entry 100%, normal;
      }
    }
  }
  /* The scroll drift uses transform; the float uses translate and rotate, so the two add up. */
  @keyframes footer-drift { from { transform: translateY(var(--fy)) rotate(var(--fr)); } to { transform: none; } }
  @keyframes footer-float {
    0% { translate: 0 0; rotate: 0deg; }
    45% { translate: 5px -8px; rotate: 10deg; }
    100% { translate: -4px -13px; rotate: -7deg; }
  }
  .footer__flower--a { width: 56px; top: var(--space-6); left: -14px; }
  .footer__flower--b { width: 40px; top: var(--space-7); right: 6px; }
  .footer__flower--c { width: 34px; top: 46%; left: 10px; opacity: .22; }
  .footer__flower--d { width: 60px; top: 64%; right: -22px; opacity: .24; }

  /* Phones: the logo nearly fills the width, so the flowers sit beside it and either side of the menu row. */
  @media (max-width: 749px) {
    .footer__flower--a { width: 36px; top: var(--space-4); left: -22px; }
    .footer__flower--b { width: 30px; top: var(--space-3); right: -10px; }
    .footer__flower--c { width: 30px; top: auto; bottom: 170px; left: 6px; }
    .footer__flower--d { width: 46px; top: auto; bottom: 186px; right: -18px; }
  }
  /* Narrow phones: the logo fills the width, so only the two flowers with clear space stay. */
  @media (max-width: 389px) {
    .footer__flower--a, .footer__flower--d { display: none; }
  }
  @media (min-width: 750px) {
    .footer__mark { width: 104px; height: 104px; }
    .footer__name { font-size: 3.25rem; }
    .footer__tagline { font-size: .8125rem; letter-spacing: .3em; }
    .footer__crafts a { font-size: .8125rem; letter-spacing: .2em; }
    .footer__crafts ul { display: flex; flex-wrap: wrap; gap: 0 var(--space-3); }
    .footer__crafts li + li::before { content: "·"; color: var(--color-muted); }
  }
  @media (min-width: 990px) {
    .footer__base { grid-template-columns: 1fr auto 1fr; align-items: center; }
    .footer__base > p { justify-self: start; }
    .footer__payments { justify-self: end; }
    .footer__flower--a { width: 84px; left: 6%; top: var(--space-7); }
    .footer__flower--b { width: 52px; right: 9%; top: var(--space-8); }
    .footer__flower--c { width: 48px; left: 3%; top: 52%; }
    .footer__flower--d { width: 80px; right: 4%; top: 46%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_crafts",
      "label": "Crafts line",
      "info": "The crafts shown under the logo, like the brand banner: bouquets, keychains, hair clips, bag charms. Keep it to 4 or 5 links."
    },
    { "type": "link_list", "id": "menu_shop", "label": "First menu", "default": "footer", "info": "Help links, such as contact, shipping, returns and care." },
    { "type": "link_list", "id": "menu_help", "label": "Second menu" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "options": [
        { "value": "soft", "label": "Soft blush" },
        { "value": "blush", "label": "Blush (brand colour)" }
      ],
      "default": "soft"
    }
  ]
}
{% endschema %}
