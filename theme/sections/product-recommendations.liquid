{%- comment -%}
  A row of other pieces on the product page (docs/product-page-plan.md, PP7). Used twice in templates/product.json:
  - "Pairs well with": the pieces picked for this product in the Search & Discovery app (complementary). Hidden
    when there are no picks.
  - "You may also like": written into the page (docs/seo-plan.md, phase 4), so the links are there without any
    script: pieces of the same craft, then of the same flower, then the Bestsellers (Bag charms has one piece).
    Under the cards, "More like this" links the collections this piece is in (snippets/collection-links).
    Shopify's own related picks are not used: with no orders yet they put hair clips beside a bouquet. They can
    come back once there are orders to learn from (the `recommendations` branch below still answers).
  "Pairs well with" ships an empty marker; product-rows.js asks Shopify for it when the marker is near the screen.
  Sold-out pieces, the free gift and test products are left out (snippets/product-row, snippets/gift-skip).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_id = 'Recs-' | append: section.id
-%}
{%- if recommendations.performed -%}
  {%- liquid
    assign picks = recommendations.products
    if recommendations.products_count == 0 and s.intent == 'related'
      assign picks = collections['bestsellers'].products | default: settings.shop_all_collection.products
    endif
  -%}
  {%- capture gift_skip -%}{% render 'gift-skip', products: picks %}{%- endcapture -%}
  {%- assign gift_skip = gift_skip | strip -%}
  <div class="page-grid recs" data-recs-ready>
    {%- render 'product-row', title: s.heading, id: heading_id, products: picks, exclude: gift_skip, limit: s.limit -%}
  </div>
{%- elsif product != blank and s.intent == 'related' -%}
  {%- liquid
    assign craft_handle = product.type | handleize
    assign picks = collections[craft_handle].products
    assign flower = blank
    for link in linklists['flowers'].links
      # The first link is every flower; the piece's own flower comes after it.
      if forloop.first or link.type != 'collection_link'
        continue
      endif
      for c in product.collections
        if c.handle == link.object.handle
          assign flower = link.object
          break
        endif
      endfor
      if flower != blank
        break
      endif
    endfor
    assign best = collections['bestsellers'].products
    capture gift_skip
      render 'gift-skip', products: picks
      render 'gift-skip', products: flower.products
      render 'gift-skip', products: best
    endcapture
    assign gift_skip = gift_skip | strip | append: product.id | append: ','
  -%}
  <div class="page-grid recs" data-recs-written{% if product.available == false %} data-recs-lift{% endif %}>
    <div class="recs__stack">
      {%- render 'product-row', title: s.heading, id: heading_id, products: picks, more: flower.products, last: best, exclude: gift_skip, limit: s.limit -%}
      {%- render 'collection-links', product: product, current: craft_handle -%}
    </div>
  </div>
  <script src="{{ 'product-rows.js' | asset_url }}" type="module"></script>
{%- elsif product != blank -%}
  <div
    data-recs
    data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&limit={{ s.limit | plus: 2 }}&section_id={{ section.id }}&intent={{ s.intent }}"
    {% if s.intent == 'related' and product.available == false %}
      data-recs-lift
    {% endif %}
  ></div>
  <script src="{{ 'product-rows.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .recs__stack { display: grid; gap: var(--space-5); }
{% endstylesheet %}

{% schema %}
{
  "name": "Product row",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "Which pieces",
      "options": [
        { "value": "related", "label": "Similar pieces (automatic)" },
        { "value": "complementary", "label": "Pairs well with (your picks)" }
      ],
      "default": "related",
      "info": "Similar pieces come from Shopify and show the Bestsellers until it has data. \"Pairs well with\" shows the pieces you pick for each product in the Search & Discovery app, and hides when there are none."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "How many", "min": 2, "max": 6, "step": 1, "default": 6 }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
