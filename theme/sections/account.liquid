{%- comment -%} The page itself is snippets/account-body (sections/page also renders it for a page with the handle 'account'). {%- endcomment -%}
{%- render 'account-body', demo: section.settings.demo, view: section.settings.view -%}

{% schema %}
{
  "name": "Your account",
  "settings": [
    {
      "type": "select",
      "id": "view",
      "label": "Show",
      "options": [
        { "value": "page", "label": "The account page" },
        { "value": "details", "label": "Your details (phones open it from the greeting)" },
        { "value": "order", "label": "One order (the address names it: #Order-1001)" },
        { "value": "empty", "label": "Preview only: the account page with no orders yet" }
      ],
      "default": "page"
    },
    {
      "type": "checkbox",
      "id": "demo",
      "label": "Preview the signed-in page",
      "info": "Shows made-up orders while nobody is signed in and Demo content is on. Only for judging the layout.",
      "default": false
    }
  ]
}
{% endschema %}
