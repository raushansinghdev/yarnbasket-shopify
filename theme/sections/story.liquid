{%- liquid
  assign s = section.settings

  # A short clip of the work (docs/home-media-plan.md §4), from Shopify's video picker: the 720p copy for phones, up
  # to 1080p for desktop. While Demo content is on and nothing is picked, the brand kit's logo animation stands in.
  assign v_small = blank
  assign v_large = blank
  assign v_alt = blank
  if s.video != blank
    assign best_small = 0
    assign best_large = 0
    for source in s.video.sources
      if source.format != 'mp4'
        continue
      endif
      assign short = source.width
      if source.height < short
        assign short = source.height
      endif
      if short <= 720 and short > best_small
        assign v_small = source.url
        assign best_small = short
      endif
      if short <= 1080 and short > best_large
        assign v_large = source.url
        assign best_large = short
      endif
    endfor
    assign v_small = v_small | default: v_large
    assign v_large = v_large | default: v_small
    assign v_alt = s.video_alt | default: s.video.alt
  elsif s.image == blank and settings.demo_content
    assign v_small = 'demo-story-video-720.mp4' | asset_url
    assign v_large = 'demo-story-video-1080.mp4' | asset_url
    assign v_alt = 'The Yarn Basket logo drawing itself: a ball of yarn and a crochet hook in a basket'
  endif
-%}

<section class="section story scheme-{{ s.scheme }}" aria-labelledby="Story-{{ section.id }}" data-inview>
  {%- assign yarn_words = s.heading | strip | downcase -%}
  {%- if yarn_words == 'one stitch at a time' -%}{%- render 'yarn-lettering', part: 'script' -%}{%- endif -%}
  {%- comment -%}
    The yarn strand from the brand kit's pinned Instagram banner: one line that draws itself
    across the section as it scrolls past and ends in a crochet flower.
  {%- endcomment -%}
  <div class="story__strand full-bleed" aria-hidden="true">
    <svg class="story__line" viewBox="0 0 1200 600" preserveAspectRatio="none" focusable="false">
      <path vector-effect="non-scaling-stroke" d="M-20 70 C 200 20, 330 150, 520 105 S 860 10, 1010 80 S 1185 230, 1160 380 S 1120 540, 1130 590"/>
    </svg>
    <svg class="story__bloom" viewBox="-15 -15 30 30" focusable="false">
      <g stroke-width="1.1">
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(72)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(144)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(216)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(288)"/>
        <circle r="2.6" class="story__bloom-centre"/>
      </g>
    </svg>
  </div>

  <div class="story__grid{% if s.panel %} story__grid--panel panel-blush{% endif %}">
    <div class="story__visual" data-arrive="settle">
      {%- if v_small != blank -%}
        {%- comment -%}
          Muted, inline and looping, playing only while at least half of it is on screen, and nothing downloads until
          the section is near (assets/story-video.js). The still frame is a lazy image of the same 4:5 shape, so
          nothing jumps when the video takes over. It never plays by itself with reduced motion, lite mode or data
          saver; the play button is always there (WCAG 2.2.2). The clip has no sound, so its name says what it shows
          (WCAG 1.2.1), and the text beside it says the rest.
        {%- endcomment -%}
        <div class="media story__media story__media--video" style="--ratio: 4 / 5" data-story-video>
          <video
            class="story__video"
            muted
            loop
            playsinline
            preload="none"
            disablepictureinpicture
            disableremoteplayback
            aria-label="{{ v_alt | escape }}"
            data-src-small="{{ v_small }}"
            data-src-large="{{ v_large }}"
          ></video>
          {%- if s.video != blank -%}
            {{- s.video.preview_image | image_url: width: 1200 | image_tag:
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 45vw, calc(100vw - 40px)',
              loading: 'lazy',
              class: 'story__poster',
              alt: ''
            -}}
          {%- else -%}
            <img class="story__poster" src="{{ 'demo-story-video-poster.webp' | asset_url }}" alt="" width="800" height="1000" loading="lazy">
          {%- endif -%}
          <button
            type="button"
            class="story__toggle"
            data-video-toggle
            data-label-play="{{ 'story.play' | t }}"
            data-label-pause="{{ 'story.pause' | t }}"
            aria-label="{{ 'story.play' | t }}"
            hidden
          >
            {%- render 'icon', icon: 'play', class: 'story__ico-play' -%}
            {%- render 'icon', icon: 'pause', class: 'story__ico-pause' -%}
          </button>
        </div>
        <script src="{{ 'story-video.js' | asset_url }}" type="module"></script>
      {%- else -%}
      <div class="media story__media"{% if s.image %} style="--ratio: {{ s.image.aspect_ratio }}"{% elsif settings.demo_content %} style="--ratio: 1179 / 678"{% endif %}>
        {%- if s.image -%}
          {%- render 'image', image: s.image, sizes: '(min-width: 990px) 45vw, calc(100vw - 40px)', class: 'story__img' -%}
        {%- elsif settings.demo_content -%}
          {%- render 'demo-image', name: 'story-rose', sizes: '(min-width: 990px) 45vw, calc(100vw - 40px)', class: 'story__img', width: 1179, height: 678, alt: 'Hands crocheting a red rose with a steel hook' -%}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>

    <div class="story__copy" data-arrive="lines">
      {%- render 'icon', icon: 'makers', class: 'story__icon' -%}
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- comment -%}
        "One stitch at a time" is written in one strand of yarn by a crochet hook when it comes into view
        (snippets/yarn-lettering, docs/yarn-story-plan.md §3); any other heading is plain text.
      {%- endcomment -%}
      {%- if yarn_words == 'one stitch at a time' -%}
        <h2 id="Story-{{ section.id }}">{%- render 'yarn-lettering', words: yarn_words -%}</h2>
      {%- else -%}
        <h2 id="Story-{{ section.id }}">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}<div class="rte story__text">{{ s.text }}</div>{%- endif -%}

      {%- if s.stat_value != blank -%}
        <p class="story__stat">
          <span class="story__stat-value">{{ s.stat_value }}</span>
          <span class="story__stat-label">{{ s.stat_label }}</span>
        </p>
      {%- endif -%}

      {%- if s.link_label != blank -%}
        <a class="link" href="{{ s.link_url | default: routes.root_url }}">
          {{- s.link_label -}}
          {%- render 'icon', icon: 'arrow' -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .story { position: relative; overflow: clip; isolation: isolate; }
  .story__strand { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .story__line { position: absolute; inset: 3% 0 2%; width: 100%; height: 95%; overflow: visible; }
  .story__line path {
    fill: none;
    stroke: var(--strand);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: .75;
    /* Dashes are measured on screen (non-scaling stroke), so use a length longer than the line ever gets. */
    stroke-dasharray: 3600;
    stroke-dashoffset: 0;
  }
  .story__bloom {
    position: absolute;
    width: 46px;
    left: calc(94.2% - 23px);
    top: calc(3% + 95% * (590 / 600) - 23px);
    overflow: visible;
  }
  .story__bloom ellipse { fill: var(--cream); stroke: var(--cocoa-deep); }
  .story__bloom-centre { fill: var(--sage); stroke: var(--cocoa-deep); }
  .scheme-cocoa .story__bloom ellipse { fill: var(--blush); stroke: var(--cocoa-deep); }
  .scheme-cocoa { --strand: var(--rose); }

  .story__grid { display: grid; gap: var(--space-7); align-items: center; }
  /* The Blush is painted underneath the yarn strand, so the strand still runs across the panel. */
  .story__grid--panel { position: relative; background: none; padding: var(--space-5) var(--space-5) var(--space-7); gap: var(--space-6); }
  .story__grid--panel::before { content: ""; position: absolute; inset: 0; z-index: -2; border-radius: inherit; background: var(--blush); }
  .story__grid--panel .story__media { border-radius: var(--radius-md); }
  .story__media { --ratio: 4 / 5; border-radius: var(--radius-lg); }

  /* The clip: the still frame sits on top until the video is actually playing, then fades away. */
  .story__poster { z-index: 1; transition: opacity var(--dur-panel) ease; }
  .story__media--video[data-started] .story__poster { opacity: 0; }
  .story__toggle {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    background: color-mix(in srgb, var(--white) 96%, transparent);
    box-shadow: 0 8px 22px -14px rgb(78 58 49 / .55);
    color: var(--cocoa-deep);
  }
  .story__toggle[hidden] { display: none; }
  .story__toggle .icon { width: 20px; height: 20px; }
  .story__ico-pause, [data-playing] .story__ico-play { display: none; }
  [data-playing] .story__ico-pause { display: block; }
  @media (hover: hover) { .story__toggle:hover { background: var(--white); } }
  .story__copy { display: grid; gap: var(--space-4); justify-items: start; max-width: 32rem; }
  .story__icon { width: 52px; height: 52px; color: var(--color-heading); }
  .story__text { color: var(--color-ink); }
  .story__stat {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-4);
    margin-block: var(--space-2);
    border-block: 1px solid var(--color-line);
    width: 100%;
  }
  .story__stat-value {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2.75rem, 2.2rem + 2.5vw, 4rem);
    line-height: 1;
    color: var(--color-heading);
    font-variant-numeric: lining-nums;
  }
  .story__stat-label { font-size: var(--fs-small); color: var(--color-muted); max-width: 16rem; }

  @media (min-width: 990px) {
    .story__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 5fr); gap: clamp(var(--space-8), 8vw, var(--space-10)); }
    .story__copy { padding-block: var(--space-6); }
    .story__grid--panel { padding: var(--space-6); padding-right: var(--space-8); gap: var(--space-8); }
  }

  /* Scroll-driven drawing. Without support the strand is simply shown complete. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .story__line path {
        animation: strand-draw linear both;
        animation-timeline: --story;
        animation-range: entry 35% exit 35%;
      }
      .story { view-timeline-name: --story; }
      .story__bloom {
        animation: strand-bloom linear both;
        animation-timeline: --story;
        animation-range: cover 52% cover 64%;
      }
    }
    @supports not (animation-timeline: view()) {
      .story[data-inview] .story__line path { stroke-dashoffset: 3600; transition: stroke-dashoffset 2.4s var(--ease-in-out); }
      .story[data-inview] .story__bloom { transform: scale(0) rotate(-60deg); transition: transform .8s var(--ease-spring) 2s; }
      .story.is-inview .story__line path { stroke-dashoffset: 0; }
      .story.is-inview .story__bloom { transform: none; }
    }
  }
  @keyframes strand-draw { from { stroke-dashoffset: 3600; } to { stroke-dashoffset: 0; } }
  @keyframes strand-bloom { from { transform: scale(0) rotate(-60deg); } to { transform: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Made by hand",
  "tag": "div",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Optional: 10–20 seconds of hands at work, filmed vertically and kept in the middle (it's shown 4:5). No text or music; it plays without sound. Upload in Content → Files. It replaces the photo."
    },
    {
      "type": "text",
      "id": "video_alt",
      "label": "What the video shows",
      "info": "One sentence for people who can't see it, e.g. \"Hands crocheting a red rose, petal by petal\"."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Hands at work: crocheting, winding yarn or finishing a piece. Portrait. Shown when there's no video."
    },
    { "type": "checkbox", "id": "panel", "label": "Blush panel", "default": true, "info": "Sets the story on a rounded panel in the brand colour." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "How it's made" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One stitch at a time" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every piece is crocheted by hand with soft yarn, one stitch at a time. No machines, no shortcuts, so no two pieces are ever quite the same.</p>"
    },
    {
      "type": "text",
      "id": "stat_value",
      "label": "Number",
      "info": "A real figure from your work, like \"6 hrs\". Leave blank to hide."
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Number label",
      "info": "What the number means, like \"to crochet one bouquet\"."
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Our story" },
    { "type": "url", "id": "link_url", "label": "Link" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "options": [
        { "value": "soft", "label": "Soft blush" },
        { "value": "white", "label": "White" },
        { "value": "blush", "label": "Blush" },
        { "value": "cocoa", "label": "Cocoa" }
      ],
      "default": "soft"
    }
  ],
  "presets": [{ "name": "Made by hand" }]
}
{% endschema %}
