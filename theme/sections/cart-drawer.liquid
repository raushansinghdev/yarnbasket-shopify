{%- comment -%}
  Cart drawer (docs/cart-plan.md §3, §4.1, §6). Rendered once by layout/theme.liquid on every page except /cart.
  A native <dialog> from the right, mirroring the menu drawer on the left: focus trap, Esc and an inert page come
  built in. cart.js opens it from the header's cart button (a plain tap; long-press and no-JS still go to /cart) and
  from "View cart" in the added-to-cart pop-up, and refreshes [data-cart-root] after every change.
  Pinned top bar · scrolling lines, gift note, price details and the swipe rows · pinned amount and Checkout.
  The same content, in the same order, as the cart page (docs/cart-plan.md, "One cart"). The swipe rows
  (snippets/cart-rows: Saved for later, Little extras, Recently viewed) are empty shells; assets/cart-rows.js,
  fetched with the drawer's first opening through data-addons, fills them.
{%- endcomment -%}
{%- unless request.page_type == 'cart' -%}
  <dialog class="cart-drawer scheme-soft" id="CartDrawer" aria-labelledby="CartDrawerTitle" data-scroll-lock closedby="any" data-cart-drawer data-addons="{{ 'cart-rows.js' | asset_url }}">
    {%- comment -%} Spoken updates while the drawer is open (the page behind it, header included, is inert). Outside
    the refreshed part, so screen readers keep listening to the same element. {%- endcomment -%}
    <p class="visually-hidden" role="status" data-cart-live></p>
    <div class="cart-drawer__root" data-cart-root data-count="{{ cart.item_count }}">
      <div class="cart-drawer__top">
        <h2 class="cart-drawer__title" id="CartDrawerTitle" tabindex="-1">
          {{- 'cart.title' | t -}}
          {%- if cart.item_count > 0 %}
            <span class="cart-drawer__count">({{ 'cart.count' | t: count: cart.item_count }})</span>
          {%- endif -%}
        </h2>
        <button type="button" class="icon-btn cart-drawer__close" data-cart-close aria-label="{{ 'cart.close' | t }}">
          {%- render 'icon', icon: 'close' -%}
        </button>
      </div>

      {%- if cart.item_count > 0 -%}
        <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__form" id="CartDrawerForm" data-cart-form novalidate>
          <div class="cart-drawer__body" data-scroll>
            <ul class="cart-lines" role="list" data-lines>
              {%- for item in cart.items -%}
                {%- render 'cart-line', item: item, place: 'drawer', sizes: '100px' -%}
              {%- endfor -%}
            </ul>
            {%- render 'cart-note', place: 'drawer' -%}
            {%- render 'cart-rewards', part: 'ladder' -%}
            {%- render 'cart-details', place: 'drawer' -%}
            {%- render 'cart-rows', place: 'drawer' -%}
          </div>
          <div class="cart-drawer__foot">
            {%- render 'cart-summary', place: 'drawer' -%}
          </div>
        </form>
      {%- else -%}
        <div class="cart-drawer__body" data-scroll>
          <ul class="cart-lines" role="list" data-lines></ul>
          {%- render 'cart-empty', place: 'drawer', level: 3 -%}
        </div>
      {%- endif -%}
    </div>
  </dialog>
{%- endunless -%}

{%- comment -%} Words cart.js needs, with [placeholders] it fills in. {%- endcomment -%}
<script type="application/json" id="CartStrings">
  {
    "added": {{ 'cart.added_status' | t: title: '[title]', count: '[count]' | json }},
    "updated": {{ 'cart.updated_status' | t: title: '[title]', quantity: '[quantity]', subtotal: '[subtotal]' | json }},
    "removed": {{ 'cart.removed' | t: title: '[title]' | json }},
    "removedStatus": {{ 'cart.removed_status' | t: title: '[title]' | json }},
    "restored": {{ 'cart.restored_status' | t: title: '[title]' | json }},
    "undo": {{ 'cart.undo' | t | json }},
    "undoLabel": {{ 'cart.undo_label' | t: title: '[title]' | json }},
    "max": {{ 'cart.max' | t | json }},
    "cap": {{ 'cart.cap' | t: count: settings.max_per_item | json }},
    "capHave": {{ 'cart.cap_have' | t: have: '[have]', count: settings.max_per_item | json }},
    "capCount": {{ settings.max_per_item | default: 0 }},
    "error": {{ 'cart.error' | t | json }},
    "offline": {{ 'cart.offline' | t | json }},
    "adding": {{ 'cart.adding' | t | json }},
    "addedButton": {{ 'cart.added_button' | t | json }},
    "giftAdded": {{ 'rewards.spoken_added' | t | json }},
    "giftRemoved": {{ 'rewards.spoken_removed' | t | json }},
    "giftLost": {{ 'rewards.spoken_lost' | t: amount: '[amount]' | json }},
    "one": {{ 'cart.count' | t: count: 1 | json }},
    "other": {{ 'cart.count' | t: count: 99 | json }}
  }
</script>

{%- comment -%} The free gift (docs/offers-plan.md §5.4): only when one is set up, so other shops pay nothing for it. {%- endcomment -%}
{%- if settings.gift_product != blank and settings.gift_threshold > settings.free_shipping_threshold -%}
  <script src="{{ 'rewards.js' | asset_url }}" type="module"></script>
{%- endif -%}

{%- comment -%}
  The added-to-cart pop-up (decision D2, cart-plan §6.1): photo, "Added to cart", the name, View cart and ×.
  Always two lines of text in a 64px pill (docs/cart-compact-plan.md §3); the rewards news stays in the cart.
  Phones: at the bottom, in thumb reach. Wider: under the header's cart button. It never takes focus; the header
  status line says what happened, and the header cart button does the same as View cart, so nothing is lost when
  it goes. It stays about 8 seconds and pauses while a finger, pointer or focus is on it.
{%- endcomment -%}
<template id="CartToastTemplate" data-src="{{ 'cart-toast.js' | asset_url }}">
  <div class="cart-toast" role="region" aria-label="{{ 'cart.added' | t }}">
    <span class="cart-toast__media media"><img alt="" width="56" height="56" hidden></span>
    <p class="cart-toast__text">
      <span class="cart-toast__head">{%- render 'icon', icon: 'check' -%}{{ 'cart.added' | t }}</span>
      <span class="cart-toast__title"></span>
    </p>
    {%- unless request.page_type == 'cart' -%}
      <button type="button" class="btn cart-toast__view" data-cart-view>{{ 'cart.view_cart' | t }}</button>
    {%- endunless -%}
    <button type="button" class="icon-btn cart-toast__close" data-toast-close aria-label="{{ 'cart.dismiss' | t }}">
      {%- render 'icon', icon: 'close' -%}
    </button>
  </div>
</template>

{% stylesheet %}
  /* Mirrors the menu drawer (sections/header.liquid) from the right. Full width on phones, 440px from 480px up. */
  .cart-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-ink);
    transform: translateX(100%);
    transition: transform var(--dur-panel) var(--ease-out), overlay var(--dur-panel) allow-discrete, display var(--dur-panel) allow-discrete;
  }
  @media (min-width: 480px) { .cart-drawer { width: 440px; } }
  .cart-drawer[open] { transform: none; }
  .cart-drawer[open][data-closing] { transform: translateX(100%); transition-timing-function: var(--ease-in-out); }
  @starting-style { .cart-drawer[open] { transform: translateX(100%); } }
  .cart-drawer::backdrop {
    background: rgba(51, 37, 31, .32);
    opacity: 0;
    transition: opacity var(--dur-panel) ease, overlay var(--dur-panel) allow-discrete, display var(--dur-panel) allow-discrete;
  }
  .cart-drawer[open]::backdrop { opacity: 1; }
  .cart-drawer[open][data-closing]::backdrop { opacity: 0; }
  @starting-style { .cart-drawer[open]::backdrop { opacity: 0; } }

  /* cart-rows.js keeps what is on screen in place through a redraw; the browser must not do it a second time. */
  .cart-drawer__root { display: flex; flex-direction: column; height: 100%; overflow-anchor: none; }
  .cart-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex: none;
    min-height: 56px;
    padding: max(var(--space-2), env(safe-area-inset-top)) var(--space-2) var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }
  .cart-drawer__title { font-size: 1.625rem; line-height: 1.2; }
  .cart-drawer__title:focus { outline: none; box-shadow: none; }
  .cart-drawer__count { font-family: var(--font-sans); font-style: normal; font-weight: 400; font-size: 1rem; letter-spacing: 0; color: var(--color-muted); }
  .cart-drawer__close .icon { transition: transform var(--dur-panel) var(--ease-spring); }
  @media (hover: hover) { .cart-drawer__close:hover .icon { transform: rotate(90deg); } }
  .cart-drawer__form { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  /* position: the screen-reader-only words in the list (absolutely placed) belong to this box and scroll with it.
     Without it they belong to the drawer, which then has hidden content below its edge, and bringing the price
     details into view scrolled the whole drawer: the top bar and its × went off screen (2026-10-08). */
  .cart-drawer__body { position: relative; flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 var(--space-4) var(--space-4); }
  .cart-drawer__body .cart-note { margin-top: var(--space-2); }
  /* The swipe rows (snippets/cart-rows) run to the drawer's edges, and stay swipe rows at every width: the
     drawer is 440px on a desktop too, where the page lays a row out 6 across. */
  .cart-drawer .cart-rows { --gutter: var(--space-4); }
  .cart-drawer .product-row__list {
    --scroller-item: 40%;
    display: grid;
    grid-auto-flow: column;
    grid-template-columns: none;
    gap: var(--scroller-gap);
    overflow-x: auto;
    padding: 10px var(--gutter);
    margin: -10px calc(var(--gutter) * -1) 0;
  }
  /* The amount beside Checkout scrolls here to the price details. They are no longer the end of the list, so
     the heading stops a little below the top and the whole card shows. */
  /* "Your rewards": a card of its own, before the price details. */
  .cart-drawer .ladder { margin-top: var(--space-4); padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-surface); }
  @media (forced-colors: active) { .cart-drawer .ladder { border: 1px solid CanvasText; } }
  .cart-drawer .cart-details__title { scroll-margin-top: var(--space-6); }
  @media (prefers-reduced-motion: no-preference) { .cart-drawer__body { scroll-behavior: smooth; } }
  .cart-drawer__body .cart-empty { padding-block: var(--space-6); }
  .cart-drawer__foot {
    position: relative;
    flex: none;
    padding: var(--space-3) var(--space-4) max(var(--space-3), env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line-strong);
    background: var(--color-bg);
    box-shadow: 0 -12px 24px -22px rgb(78 58 49 / .5);
  }
  /* While a reward is ahead, its progress bar is the pinned bottom's top edge: it takes the border's place and
     no height (snippets/cart-rewards). */
  .cart-drawer__foot .rewards__track { position: absolute; inset: -1px 0 auto; border-radius: 0; }
  /* At 400% zoom, with large text or on a short landscape phone, the pinned parts would cover most of the screen:
     let it all scroll. In em, so a larger browser text size counts too (31.25em is 500px at the usual size). */
  @media (max-height: 31.25em) {
    .cart-drawer__root { display: block; height: auto; min-height: 100%; }
    .cart-drawer { overflow-y: auto; }
    .cart-drawer__body { overflow: visible; }
  }

  /* Added-to-cart pop-up. */
  .cart-toast {
    position: fixed;
    /* On a product page the pop-up sits above the sticky buy bar while that shows (product.js sets --buybar). */
    inset: auto var(--space-3) calc(max(var(--space-3), env(safe-area-inset-bottom)) + var(--buybar, 0px));
    z-index: 30;
    /* One 64px row with round ends. The words keep room for "Added to cart" on one line (7.25rem); with large text
       or a very narrow screen the buttons wrap under them instead of squeezing them. */
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-1) var(--space-2) var(--space-2);
    border: 1px solid var(--color-line-strong);
    border-radius: 2rem;
    background: var(--white);
    color: var(--color-ink);
    box-shadow: 0 18px 40px -18px rgb(78 58 49 / .45);
    transition: opacity var(--dur-panel) var(--ease-out), transform var(--dur-panel) var(--ease-out);
  }
  @starting-style { .cart-toast { opacity: 0; transform: translateY(16px); } }
  .cart-toast.is-leaving { opacity: 0; transform: translateY(16px); transition-timing-function: var(--ease-exit); }
  .cart-toast__media { --ratio: 1; flex: none; width: 48px; border-radius: 50%; background: var(--oat); }
  .cart-toast__text { display: grid; gap: 2px; flex: 1 1 7.25rem; min-width: min(7.25rem, 100%); }
  .cart-toast__head { display: inline-flex; align-items: center; gap: 4px; font-size: var(--fs-small); font-weight: 500; color: var(--color-heading); white-space: nowrap; }
  .cart-toast__head .icon { width: 16px; height: 16px; flex: none; }
  .cart-toast__title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--fs-small); color: var(--color-muted); }
  .cart-toast__view { flex: none; min-height: var(--tap); padding: 0 var(--space-3); font-size: .9375rem; }
  .cart-toast__close { flex: none; width: 40px; }
  /* Too narrow for "Added to cart" on one line: the photo goes (it's decoration; the name is in the words). */
  @media (max-width: 339px) {
    .cart-toast { padding-left: var(--space-4); }
    .cart-toast__media { display: none; }
  }
  .cart-toast.is-error { flex-wrap: nowrap; padding-left: var(--space-4); border-radius: var(--radius-md); }
  .cart-toast.is-error .cart-toast__text { min-width: 0; }
  .cart-toast.is-error :is(.cart-toast__media, .cart-toast__head, .cart-toast__view) { display: none; }
  .cart-toast.is-error .cart-toast__title { white-space: normal; color: var(--color-heading); font-weight: 500; }
  @media (min-width: 768px) {
    .cart-toast { inset: calc(var(--header-top, 0px) + var(--header-height) + var(--space-2)) var(--gutter) auto auto; width: 25rem; }
    @starting-style { .cart-toast { transform: translateY(-12px); } }
    .cart-toast.is-leaving { transform: translateY(-12px); }
  }
  /* Reduced motion: base.css cuts every transition to 1ms, so the drawer simply appears; the pop-up doesn't travel. */
  @media (prefers-reduced-motion: reduce) {
    .cart-toast, .cart-toast.is-leaving { transform: none; }
  }
  @media (forced-colors: active) { .cart-toast, .cart-drawer { border: 1px solid CanvasText; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
