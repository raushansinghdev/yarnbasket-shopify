{%- comment -%}
  "Little extras" under the cart page (docs/cart-plan.md decision D7). Never placed on a page: cart.js asks Shopify's
  product recommendations for this section, based on the first product in the cart. Shows the 4 lowest-priced
  products that are in stock and not already in the cart; one-tap add for single-option products, "Choose" otherwise.
  Until Shopify has worked out recommendations (it takes a while for new products), it falls back to the store's
  lowest-priced products.
  Nothing renders (and the slot stays empty) when there's nothing to suggest.
  While a reward step is still ahead (docs/offers-plan.md §6), the cheapest pieces that would reach it come first; the
  cart's rewards line says how much is left (this section isn't redrawn as the cart changes, so it doesn't repeat it).
  The free gift itself is never suggested.
{%- endcomment -%}
{%- liquid
  assign in_cart = cart.items | map: 'product_id'
  assign shown = 0

  # The next reward step, measured the same way as the cart's rewards line (snippets/cart-rewards.liquid).
  assign gap = 0
  assign ship_at = settings.free_shipping_threshold | default: 0 | times: 100
  assign gift_at = settings.gift_threshold | default: 0 | times: 100
  assign gift_id = settings.gift_product.id
  assign gift_variant = settings.gift_product.variants.first
  assign total = cart.total_price
  for item in cart.items
    if gift_variant and item.variant_id == gift_variant.id
      assign total = total | minus: item.final_line_price
    endif
  endfor
  if ship_at > 0 and cart.total_price < ship_at
    assign gap = ship_at | minus: cart.total_price
  elsif gift_variant and gift_variant.available and gift_at > ship_at and total < gift_at
    assign gap = gift_at | minus: total
  else
    # The money-off steps count the items before order discounts (see the snippet).
    assign basis = cart.items_subtotal_price | minus: cart.total_price | plus: total
    assign off1_at = settings.discount_1_from | default: 0 | times: 100
    assign off2_at = settings.discount_2_from | default: 0 | times: 100
    if settings.discount_1_amount > 0 and basis < off1_at
      assign gap = off1_at | minus: basis
    elsif settings.discount_2_amount > 0 and basis < off2_at
      assign gap = off2_at | minus: basis
    endif
  endif
-%}
{%- liquid
  if recommendations.performed and recommendations.products_count > 0
    assign by_price = recommendations.products | sort: 'price'
  else
    assign by_price = collections.all.products | sort: 'price'
  endif
-%}
{%- if by_price.size > 0 -%}
  {%- capture cards -%}
    {%- comment -%} Two passes when a step is ahead: first the pieces that would reach it, then the rest. {%- endcomment -%}
    {%- for pass in (1..2) -%}
    {%- for product in by_price -%}
      {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
      {%- if product.available == false or in_cart contains product.id or product.id == gift_id -%}{%- continue -%}{%- endif -%}
      {%- if gap > 0 -%}
        {%- if pass == 1 and product.price < gap -%}{%- continue -%}{%- endif -%}
        {%- if pass == 2 and product.price >= gap -%}{%- continue -%}{%- endif -%}
      {%- elsif pass == 2 -%}
        {%- break -%}
      {%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- assign variant = product.selected_or_first_available_variant -%}
      <li class="extra">
        <a href="{{ product.url }}" class="extra__media media" tabindex="-1" aria-hidden="true">
          {%- if product.featured_media -%}
            {%- render 'image', image: product.featured_media.preview_image, sizes: '(min-width: 990px) 200px, 40vw', width: 480 -%}
          {%- endif -%}
        </a>
        <a href="{{ product.url }}" class="extra__title">{{ product.title }}</a>
        {%- render 'price', product: product -%}
        {%- if product.has_only_default_variant or product.variants.size == 1 -%}
          <form action="{{ routes.cart_add_url }}" method="post" class="extra__form">
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="extra__btn" aria-label="{{ 'cart.extras_add_label' | t: title: product.title | escape }}">
              {%- render 'icon', icon: 'plus' -%}
              <span aria-hidden="true">{{ 'cart.extras_add' | t }}</span>
            </button>
          </form>
        {%- else -%}
          <a href="{{ product.url }}" class="extra__btn" aria-label="{{ 'cart.extras_choose' | t }}: {{ product.title | escape }}">
            {{- 'cart.extras_choose' | t -}}
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if shown > 0 -%}
    <section class="extras" aria-labelledby="ExtrasTitle">
      <div class="extras__head">
        <h2 class="extras__title" id="ExtrasTitle">{{ 'cart.extras_title' | t }}</h2>
        <p class="muted">{{ 'cart.extras_text' | t }}</p>
      </div>
      <ul class="extras__grid" role="list">{{ cards }}</ul>
    </section>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .extras { margin-top: var(--section-space); padding-top: var(--space-6); border-top: 1px dashed var(--color-line-strong); }
  .extras__head { display: grid; gap: var(--space-1); margin-bottom: var(--space-5); }
  .extras__title { font-size: var(--fs-h3); }
  .extras__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-4); }
  .extra { display: grid; gap: var(--space-2); align-content: start; }
  .extra__media { --ratio: 1; border-radius: var(--radius-sm); background: var(--oat); }
  .extra__title { padding-block: 3px; margin-block: -3px; font-weight: 500; line-height: 1.35; color: var(--color-heading); text-decoration: none; overflow-wrap: anywhere; }
  @media (hover: hover) { .extra__title:hover { text-decoration: underline; text-decoration-color: var(--rose); text-underline-offset: 3px; } }
  .extra .price { font-size: var(--fs-small); }
  .extra__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    width: 100%;
    min-height: var(--tap);
    border: 1.5px solid color-mix(in srgb, var(--cocoa) 40%, transparent);
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--color-heading);
    font: 500 .9375rem var(--font-sans);
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--dur-state) ease, border-color var(--dur-state) ease, scale var(--dur-press) ease;
  }
  .extra__btn .icon { width: 18px; height: 18px; }
  .extra__btn:active { scale: .97; }
  .extra__btn[aria-busy="true"] { opacity: .6; }
  @media (hover: hover) { .extra__btn:hover { border-color: var(--cocoa); background: var(--blush-soft); } }
  @media (min-width: 990px) { .extras__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); } }
{% endstylesheet %}
