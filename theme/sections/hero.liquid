{%- liquid
  assign s = section.settings
  assign parts = s.heading | split: '*'

  # A campaign (docs/hero-campaign-plan.md) swaps the photo, the words and the link while today is within its dates,
  # then hides itself. The theme editor still shows one outside its dates, with a note, so it can be set up ahead.
  assign today = 'now' | date: '%Y%m%d' | plus: 0
  assign campaign = nil
  assign campaign_note = blank
  for block in section.blocks
    assign c = block.settings
    # Without photos a campaign shows nothing, except with Demo content on, where it shows a demo photo for testing.
    if c.image_phone == blank and c.image_desktop == blank and settings.demo_content == false
      continue
    endif
    assign c_live = true
    assign c_from = c.show_from | remove: '-' | strip
    assign c_until = c.show_until | remove: '-' | strip
    if c_from != blank
      assign c_from_num = c_from | plus: 0
      if c_from_num > today
        assign c_live = false
      endif
    endif
    if c_until != blank
      assign c_until_num = c_until | plus: 0
      if c_until_num < today
        assign c_live = false
      endif
    endif
    if c_live
      assign campaign = block
      if c_until == blank and request.design_mode
        assign campaign_note = 'hero.campaign_no_end' | t
      endif
    elsif request.design_mode
      assign campaign = block
      assign c_from_text = c.show_from | default: '…'
      assign c_until_text = c.show_until | default: '…'
      assign campaign_note = 'hero.campaign_hidden' | t: from: c_from_text, until: c_until_text
    endif
  endfor

  assign shop_all = settings.shop_all_collection.url | default: routes.all_products_collection_url
  assign photo = s.image
  assign photo_phone = nil
  assign demo = 'hero'
  assign title = blank
  assign line = s.text
  assign cta_label = s.button_label
  assign cta_link = s.button_link | default: shop_all
  assign tag_product = s.product
  assign tag_label = s.label
  if campaign
    assign cs = campaign.settings
    assign photo = cs.image_phone | default: cs.image_desktop
    if cs.image_phone != blank and cs.image_desktop != blank
      assign photo_phone = cs.image_desktop
    endif
    assign demo = 'campaign'
    assign title = cs.label
    assign line = cs.line
    assign cta_label = cs.button_label | default: s.button_label
    assign cta_link = cs.link | default: shop_all
    assign tag_product = cs.product
    assign tag_label = cs.product_label
  endif

  # On phones the photo box follows the photo: a square (or taller) photo is shown whole in a square box, a landscape
  # one is cropped to 6:5. Centred words are for a normal day with a centred photo; a campaign keeps its own layout.
  assign phone_ratio = 1
  if campaign
    assign phone_ratio = 1.5
  endif
  if photo_phone != blank
    assign phone_ratio = photo_phone.aspect_ratio
  elsif photo != blank
    assign phone_ratio = photo.aspect_ratio
  endif
  assign mods = ''
  if phone_ratio <= 1.1
    assign mods = mods | append: ' hero--square'
  endif
  if campaign
    assign mods = mods | append: ' hero--campaign'
  elsif s.align == 'centre'
    assign mods = mods | append: ' hero--centred'
  endif

  assign loading = 'lazy'
  assign fetch = 'auto'
  assign tag = 'h2'
  if section.index == 1
    assign loading = 'eager'
    assign fetch = 'high'
    assign tag = 'h1'
  endif
  # A landscape photo is cropped to 6:5 on phones, so it is drawn about a quarter wider than the screen.
  assign sizes = '(min-width: 990px) 62vw, (min-width: 600px) 100vw, 125vw'
-%}

{%- capture heading_html -%}
  {%- for part in parts -%}
    {%- assign odd = forloop.index0 | modulo: 2 -%}
    {%- assign yarn_words = part | strip | downcase -%}
    {%- if odd == 1 and yarn_words == 'stitched with love' -%}
      {%- render 'yarn-lettering', words: yarn_words -%}
    {%- else -%}
      {%- comment -%} The lead-in. Its closing comma is its own span: the centred phone lockup sets the lead in small
      capitals on a line of its own, where a comma would hang; it is still read aloud. {%- endcomment -%}
      {%- liquid
        assign lead = part | strip
        assign lead_end = lead | slice: -1
        assign lead_size = lead.size | minus: 1
      -%}
      {%- if lead == blank -%}
      {%- elsif lead_end == ',' -%}
        <span class="hero__lead">{{ lead | slice: 0, lead_size }}<span class="hero__comma">,</span></span>{{ ' ' }}
      {%- else -%}
        <span class="hero__lead">{{ lead }}</span>{{ ' ' }}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%}
  The home hero (docs/home-hero-v2-plan.md): one photo the full width of the screen, with no frame and no corners,
  whose lower edge (left edge on desktop) dissolves into the page, and the headline set across that dissolve. One
  line, one button. A campaign only swaps the photo, the words and the link.
{%- endcomment -%}
<section class="section hero{{ mods }} scheme-{{ s.scheme }}" aria-labelledby="Hero-{{ section.id }}" {% if campaign %}{{ campaign.shopify_attributes }}{% endif %}>
  <div class="hero__stage full-bleed">
    {%- comment -%} The photo repeats the button's link for taps; the button is the one link for keyboards and screen readers. {%- endcomment -%}
    <a class="hero__photo" href="{{ cta_link }}" tabindex="-1" aria-hidden="true">
      {%- if photo != blank -%}
        <picture>
          {%- if photo_phone != blank -%}
            <source
              media="(max-width: 599px)"
              srcset="{{ photo_phone | image_url: width: 480 }} 480w, {{ photo_phone | image_url: width: 750 }} 750w, {{ photo_phone | image_url: width: 1080 }} 1080w, {{ photo_phone | image_url: width: 1440 }} 1440w"
              sizes="100vw"
            >
          {%- endif -%}
          {%- liquid
            assign focus = 'object-position: ' | append: photo.presentation.focal_point
            if campaign == nil and s.focus_y != 50
              assign focus = 'object-position: 50% ' | append: s.focus_y | append: '%'
            endif
          -%}
          {{- photo | image_url: width: 2400 | image_tag:
            widths: '480, 640, 828, 1080, 1440, 1800, 2400',
            sizes: sizes,
            loading: loading,
            fetchpriority: fetch,
            class: 'hero__img',
            style: focus,
            alt: ''
          -}}
        </picture>
      {%- elsif settings.demo_content and demo == 'campaign' -%}
        <img
          src="{{ 'demo-campaign-1600.webp' | asset_url }}"
          srcset="{{ 'demo-campaign-800.webp' | asset_url }} 800w, {{ 'demo-campaign-1600.webp' | asset_url }} 1600w, {{ 'demo-campaign-2400.webp' | asset_url }} 2400w"
          sizes="{{ sizes }}"
          alt=""
          width="2400"
          height="1600"
          loading="{{ loading }}"
          fetchpriority="{{ fetch }}"
          class="hero__img"
          style="object-position: 70% 30%"
        >
      {%- elsif settings.demo_content -%}
        {%- render 'demo-image', name: 'hero-sunflowers', sizes: sizes, loading: loading, class: 'hero__img' -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hero__img' }}
      {%- endif -%}
    </a>

    {%- if tag_product != blank -%}
      <a class="hero__tag-link" href="{{ tag_product.url }}">
        {%- render 'hero-tag', product: tag_product, label: tag_label -%}
      </a>
    {%- endif -%}
    {%- if campaign_note != blank -%}
      <span class="hero__note">{{ campaign_note }}</span>
    {%- endif -%}

    <div class="hero__copy">
      {%- if title != blank -%}
        {%- comment -%} In a campaign the page's own heading stays, unseen, for Google and screen readers. {%- endcomment -%}
        <{{ tag }} id="Hero-{{ section.id }}" class="visually-hidden">{{ s.heading | remove: '*' }}</{{ tag }}>
        <p class="h-display hero__title hero__title--plain hero__anim" style="--d: 60ms">{{ title | escape }}</p>
      {%- else -%}
        <{{ tag }} id="Hero-{{ section.id }}" class="h-display hero__title hero__anim" style="--d: 60ms">{{ heading_html }}</{{ tag }}>
      {%- endif -%}
      {%- if line != blank -%}
        <p class="hero__text hero__anim" style="--d: 140ms">{{ line }}</p>
      {%- endif -%}
      {%- if cta_label != blank -%}
        <a class="btn hero__cta hero__anim" style="--d: 220ms" href="{{ cta_link }}">
          {{- cta_label -}}
          {%- render 'icon', icon: 'arrow' -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero { padding-block: 0 var(--space-5); overflow: clip; }
  .hero__stage { position: relative; }

  /* The photo: edge to edge, flush under the header. Its last third dissolves into the page colour (a mask, so the
     section's own background shows through and nothing extra is downloaded). */
  .hero__photo {
    display: block;
    aspect-ratio: 6 / 5;
    /* On a short phone the photo gives way, so the button is always on the first screen. */
    max-height: max(200px, calc(100svh - 18.5rem));
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 50%, rgb(0 0 0 / .8) 62%, rgb(0 0 0 / .5) 72%, rgb(0 0 0 / .22) 82%, rgb(0 0 0 / .07) 91%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 50%, rgb(0 0 0 / .8) 62%, rgb(0 0 0 / .5) 72%, rgb(0 0 0 / .22) 82%, rgb(0 0 0 / .07) 91%, transparent 100%);
  }
  .hero__photo picture { display: contents; }
  .hero__img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero__img.placeholder-svg { fill: color-mix(in srgb, var(--color-ink) 22%, transparent); background: var(--color-surface); }

  /* The words start on the last of the dissolve, where the photo is under a third of its strength. */
  .hero__copy {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: .625rem;
    margin-top: -3rem;
    padding-inline: var(--gutter);
  }
  .hero__title { font-size: clamp(1.875rem, 1.26rem + 2.37vw, 2.5rem); line-height: 1.02; }
  .hero__title .yarn { font-size: 1.2667em; }
  .hero__title--plain { font-size: clamp(2.125rem, 1.4rem + 3.2vw, 2.875rem); line-height: 1.05; text-wrap: balance; }
  .hero__text { max-width: 30rem; font-size: 1rem; line-height: 1.5; color: var(--color-ink); text-wrap: balance; }
  .hero__cta.btn { min-height: 52px; margin-top: var(--space-2); padding: 0 1.375rem 0 1.625rem; gap: .625rem; }

  /* The product in the photo: its name and live price (snippets/hero-tag), a link of its own. */
  .hero__tag-link {
    position: absolute;
    top: 4px;
    right: calc(var(--gutter) - 8px);
    z-index: 2;
    display: grid;
    place-items: center;
    min-height: var(--tap);
    padding: 8px;
    max-width: 70%;
    text-decoration: none;
  }
  .hero__tag {
    display: flex;
    align-items: baseline;
    gap: 6px;
    max-width: 100%;
    padding: 6px 11px;
    /* A pill on one line; when the name takes two lines (small phones, large text) the corners stay this round. */
    border-radius: 17px;
    background: color-mix(in srgb, var(--white) 96%, transparent);
    box-shadow: 0 6px 18px -12px rgb(78 58 49 / .6);
    font-size: .8125rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--cocoa-deep);
  }
  /* The whole name, on two lines when one isn't enough; only a third line is cut. */
  .hero__tag-name { min-width: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
  .hero__tag-price { flex: none; font-weight: 600; white-space: nowrap; }
  @media (max-width: 599px) {
    .hero__tag--stack { flex-direction: column; align-items: flex-start; gap: 1px; border-radius: 14px; }
  }
  /* Theme editor only: why a campaign shows here but not on the site. */
  .hero__note {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    max-width: calc(100% - 20px);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--cocoa-deep);
    color: var(--white);
    font-size: .75rem;
    font-weight: 500;
  }

  /* Bestsellers comes up close, so its heading shows on the first screen. */
  .shopify-section:has(> .hero) + .shopify-section > [data-shop-crafts] { padding-top: 1.75rem; }
  .shopify-section:has(> .hero) + .shopify-section > [data-shop-crafts] .section-head { gap: var(--space-1); }

  /* A square photo is shown whole on phones, and it dissolves later: the piece stays crisp, only the empty surface
     under it melts into the page. */
  @media (max-width: 599px) {
    .hero--square .hero__photo {
      aspect-ratio: 1;
      /* A short phone trims the empty wall and surface, never the piece: the words still start below it. */
      max-height: max(200px, calc(100svh - 14rem));
      -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 68%, rgb(0 0 0 / .8) 77%, rgb(0 0 0 / .5) 84%, rgb(0 0 0 / .22) 90%, rgb(0 0 0 / .07) 95%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 0, #000 68%, rgb(0 0 0 / .8) 77%, rgb(0 0 0 / .5) 84%, rgb(0 0 0 / .22) 90%, rgb(0 0 0 / .07) 95%, transparent 100%);
    }
  }

  /* Centred words, phones and tablets (docs/home-hero-v2-plan.md, "The label"): built like the logo, on one centre
     line under a centred photo. The lead-in steps back into small spaced capitals and the yarn lettering leads; the
     description waits for desktop, since the photo and the craft circles right below already say it. */
  @media (max-width: 989px) {
    .hero--centred .hero__copy { justify-items: center; text-align: center; }
    .hero--centred .hero__title { display: grid; justify-items: center; gap: .5rem; text-wrap: balance; }
    .hero--centred .hero__title:has(.yarn) .hero__lead {
      font-family: var(--font-sans);
      font-style: normal;
      font-weight: 500;
      font-size: .8125rem;
      line-height: 1.4;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--cocoa);
    }
    .hero--centred .hero__title:has(.yarn) .hero__comma { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .hero--centred .hero__title .yarn { width: min(20rem, calc(100vw - 2 * var(--gutter))); margin: 0 auto; }
    .hero--centred .hero__text { display: none; }
    .hero--centred .hero__cta.btn { margin-top: var(--space-3); }
  }

  @media (min-width: 600px) and (max-width: 989px) {
    .hero__photo { aspect-ratio: 2 / 1; }
    .hero--centred .hero__title .yarn { width: 24rem; }
  }

  /* Desktop: the same idea turned sideways. One band the width of the window; the photo fills the right and runs
     off the edge, its left side dissolving into the page where the words sit. */
  @media (min-width: 990px) {
    .hero { padding-bottom: 0; }
    .hero__stage {
      display: grid;
      grid-template-columns: minmax(var(--gutter), 1fr) var(--content-width) minmax(var(--gutter), 1fr);
      align-items: center;
      height: clamp(420px, 37vw, 560px);
    }
    .hero__photo {
      position: absolute;
      inset: 0 0 0 auto;
      width: 64%;
      aspect-ratio: auto;
      max-height: none;
      -webkit-mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / .1) 10%, rgb(0 0 0 / .45) 24%, rgb(0 0 0 / .85) 38%, #000 50%), linear-gradient(to bottom, #000 82%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / .1) 10%, rgb(0 0 0 / .45) 24%, rgb(0 0 0 / .85) 38%, #000 50%), linear-gradient(to bottom, #000 82%, transparent 100%);
      mask-composite: intersect;
    }
    .hero__copy { grid-column: 2; gap: var(--space-4); margin-top: 0; padding-inline: 0; max-width: 34rem; }
    .hero__title { font-size: var(--fs-display); line-height: 1; max-width: 12ch; }
    .hero__title .yarn { font-size: 1em; }
    .hero__title--plain { font-size: clamp(3rem, 1.6rem + 3vw, 4.25rem); max-width: 13ch; }
    .hero__text { font-size: var(--fs-lead); max-width: 24rem; }
    .hero__cta.btn { margin-top: var(--space-3); }
    .hero__tag-link { top: auto; bottom: 14%; right: calc(var(--gutter) - 8px); }
    .shopify-section:has(> .hero) + .shopify-section > [data-shop-crafts] { padding-top: var(--space-6); }
  }

  /* Arriving, once: the photo settles from a slight zoom (transform only, so it still counts as painted for LCP)
     and the words rise in turn. Nothing moves after that. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__anim { animation: hero-rise var(--dur-hero) var(--ease-out) var(--d, 0ms) both; }
    .hero__img { animation: hero-settle 1600ms var(--ease-out) both; }
    html.yb-intro :is(.hero__anim, .hero__img) { animation-play-state: paused; }
    html.lite :is(.hero__anim, .hero__img) { animation: none; }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes hero-settle { from { transform: scale(1.05); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Pieces in the upper two-thirds, a plain surface at the bottom: the bottom dissolves into the page. Set the focal point on the image in Shopify." },
    { "type": "product", "id": "product", "label": "Product in the photo", "info": "Optional. Shows its name and price on the photo, linking to it." },
    { "type": "text", "id": "label", "label": "Short name on the photo", "info": "Optional. Defaults to the product's title." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handmade crochet gifts, *stitched with love*", "info": "\"*stitched with love*\" is drawn in yarn." },
    { "type": "textarea", "id": "text", "label": "Line under the heading" },
    {
      "type": "select",
      "id": "align",
      "label": "Words on phones",
      "default": "left",
      "info": "Centred suits a photo with the piece in the middle: the heading becomes a small label over the yarn lettering, and the line under it waits for desktop. A campaign keeps its own layout.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "centre", "label": "Centred" }
      ]
    },
    { "type": "range", "id": "focus_y", "label": "Photo focus, top to bottom", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50, "info": "Which part of the photo stays in view where it is cropped (tablets and desktop). At 50 the focal point set on the image in Shopify is used." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all gifts" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colours",
      "default": "soft",
      "options": [
        { "value": "soft", "label": "Soft blush" },
        { "value": "white", "label": "White" },
        { "value": "blush", "label": "Blush" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "campaign",
      "name": "Campaign",
      "limit": 3,
      "settings": [
        { "type": "paragraph", "content": "A dated campaign: while it is on, it swaps the hero's photo, words and link. It hides itself after \"Show until\"." },
        { "type": "image_picker", "id": "image_phone", "label": "Landscape photo", "info": "At least 2000 px wide. Pieces in the right half and upper two-thirds, calm space on the left and at the bottom. No text in the photo." },
        { "type": "image_picker", "id": "image_desktop", "label": "Phone photo (optional)", "info": "Square or portrait, used on phones when the landscape photo crops badly." },
        { "type": "text", "id": "label", "label": "Headline", "info": "About 26 characters, e.g. \"Diwali gifts, made by hand\"." },
        { "type": "text", "id": "line", "label": "Second line", "info": "Optional, about 34 characters: a real deadline or the offer. Never a made-up countdown." },
        { "type": "url", "id": "link", "label": "Link", "info": "The occasion's collection." },
        { "type": "text", "id": "button_label", "label": "Button label", "info": "E.g. \"Shop Diwali gifts\". Defaults to the hero's button label." },
        { "type": "product", "id": "product", "label": "Product in the photo", "info": "Optional. Shows its name and price on the photo." },
        { "type": "text", "id": "product_label", "label": "Short name on the photo" },
        { "type": "text", "id": "show_from", "label": "Show from", "placeholder": "2026-10-15", "info": "Optional. Date as YYYY-MM-DD." },
        { "type": "text", "id": "show_until", "label": "Show until", "placeholder": "2026-10-27", "info": "Date as YYYY-MM-DD. Shopify caches pages, so allow a day's margin." }
      ]
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
