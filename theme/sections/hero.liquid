{%- liquid
  assign s = section.settings
  if section.index == 1
    assign img_loading = 'eager'
    assign img_priority = true
  else
    assign img_loading = 'lazy'
    assign img_priority = false
  endif
-%}

<section class="section hero scheme-{{ s.scheme }}" aria-labelledby="Hero-{{ section.id }}">
  <div class="hero__grid">
    <div class="hero__copy">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow hero__anim" style="--d: 0ms">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if section.index == 1 -%}
        <h1 id="Hero-{{ section.id }}" class="h-display hero__title hero__anim" style="--d: 60ms">{{ s.heading }}</h1>
      {%- else -%}
        <h2 id="Hero-{{ section.id }}" class="h-display hero__title hero__anim" style="--d: 60ms">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="lead hero__text hero__anim" style="--d: 140ms">{{ s.text }}</p>
      {%- endif -%}
      {%- if s.button_label != blank or s.link_label != blank -%}
        <div class="hero__actions hero__anim" style="--d: 220ms">
          {%- if s.button_label != blank -%}
            <a class="btn" href="{{ s.button_link | default: routes.all_products_collection_url }}">
              {{- s.button_label -}}
              {%- render 'icon', icon: 'arrow' -%}
            </a>
          {%- endif -%}
          {%- if s.link_label != blank -%}
            <a class="link" href="{{ s.link_url | default: routes.collections_url }}">{{ s.link_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero__visual">
      <div class="hero__frame">
        <div class="media hero__media">
          {%- if s.image -%}
            {%- render 'image', image: s.image, sizes: '(min-width: 990px) 52vw, calc(100vw - 40px)', loading: img_loading, priority: img_priority, class: 'hero__img' -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
      <svg class="hero__flower hero__flower--a" viewBox="0 0 30 30" aria-hidden="true" focusable="false"><use href="#yb-flower"/></svg>
      <svg class="hero__flower hero__flower--b" viewBox="0 0 30 30" aria-hidden="true" focusable="false"><use href="#yb-flower"/></svg>
    </div>
  </div>

  <svg width="0" height="0" class="visually-hidden" aria-hidden="true" focusable="false">
    <symbol id="yb-flower" viewBox="-15 -15 30 30">
      <g fill="none" stroke="currentColor" stroke-width=".8">
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(72)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(144)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(216)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(288)"/>
        <circle r="2.2"/>
      </g>
    </symbol>
  </svg>
</section>

{% stylesheet %}
  .hero { padding-top: clamp(var(--space-6), 2rem + 3vw, var(--space-9)); overflow: clip; }
  .hero__grid {
    display: grid;
    gap: clamp(var(--space-7), 2rem + 3vw, var(--space-8));
    align-items: center;
  }
  .hero__copy { display: grid; gap: var(--space-4); justify-items: start; max-width: 36rem; }
  .hero__title { max-width: 12ch; }
  .hero__text { max-width: 30rem; color: var(--color-ink); }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-3);
  }

  .hero__visual { position: relative; }
  /* The photo-frame outline from the Instagram covers: a fine Rose line set just outside the photo. */
  .hero__frame {
    position: relative;
    padding: 10px;
    border: 1.5px solid color-mix(in srgb, var(--rose) 80%, transparent);
    border-radius: calc(var(--radius-lg) + 10px);
  }
  .hero__media { --ratio: 4 / 5; border-radius: var(--radius-lg); }

  .hero__flower {
    position: absolute;
    color: var(--taupe);
    opacity: .4;
    pointer-events: none;
  }
  .hero__flower--a { width: 64px; top: -26px; right: -14px; }
  .hero__flower--b { width: 44px; bottom: 14%; left: -22px; opacity: .3; }

  @media (min-width: 990px) {
    .hero { padding-top: var(--space-7); }
    .hero__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(var(--space-7), 6vw, var(--space-10)); }
    .hero__media { --ratio: 5 / 6; }
    .hero__flower--a { width: 96px; top: -40px; right: -36px; }
    .hero__flower--b { width: 60px; left: -48px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Copy rises in; the photo settles from a slight zoom (transform only, so it still counts as painted for LCP). */
    .hero__anim { animation: hero-rise var(--dur-hero) var(--ease-out) var(--d, 0ms) both; }
    .hero__img, .hero__media > .placeholder-svg { animation: hero-settle 1600ms var(--ease-out) both; }
    .hero__flower { animation: hero-drift 15s ease-in-out infinite alternate; }
    .hero__flower--b { animation-duration: 12s; animation-delay: -5s; }
    /* While the logo intro plays, hold the entrance so it happens as the intro fades. */
    html.yb-intro .hero__anim, html.yb-intro .hero__img { animation-play-state: paused; }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes hero-settle { from { transform: scale(1.06); } }
  @keyframes hero-drift {
    from { transform: translate3d(0, 0, 0) rotate(0deg); }
    to { transform: translate3d(8px, -14px, 0) rotate(28deg); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Portrait, at least 1600 × 2000 px. One product, plenty of space around it."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Handmade in India"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Handmade crochet flowers that never fade",
      "info": "This is the page's main heading for Google. Keep \"crochet\" and what you sell in it."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Bouquets, keychains, hair clips and bag charms, crocheted stitch by stitch and made to be gifted."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop bouquets"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Second link label",
      "default": "Find a gift"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Second link"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "oat", "label": "Oat" },
        { "value": "blush", "label": "Blush" }
      ],
      "default": "cream"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
