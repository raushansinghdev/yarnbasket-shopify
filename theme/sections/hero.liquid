{%- liquid
  assign s = section.settings
  if section.index == 1
    assign img_loading = 'eager'
    assign img_priority = true
  else
    assign img_loading = 'lazy'
    assign img_priority = false
  endif
  assign parts = s.heading | split: '*'
-%}

{%- capture heading_html -%}
  {%- for part in parts -%}
    {%- assign odd = forloop.index0 | modulo: 2 -%}
    {%- if odd == 1 -%}
      <span class="hl">{{ part }}<svg class="hl__stitch" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M3 9 C 40 4, 80 4, 110 7 S 170 11, 197 5"/></svg></span>
    {%- else -%}
      {{- part -}}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section class="section hero scheme-{{ s.scheme }}" aria-labelledby="Hero-{{ section.id }}">
  <div class="hero__grid">
    <div class="hero__copy">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow hero__anim" style="--d: 0ms">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if section.index == 1 -%}
        <h1 id="Hero-{{ section.id }}" class="h-display hero__title hero__anim" style="--d: 60ms">{{ heading_html }}</h1>
      {%- else -%}
        <h2 id="Hero-{{ section.id }}" class="h-display hero__title hero__anim" style="--d: 60ms">{{ heading_html }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="lead hero__text hero__anim" style="--d: 140ms">{{ s.text }}</p>
      {%- endif -%}
      {%- if s.button_label != blank or s.link_label != blank -%}
        <div class="hero__actions hero__anim" style="--d: 220ms">
          {%- if s.button_label != blank -%}
            <a class="btn btn--knob hero__btn" href="{{ s.button_link | default: routes.all_products_collection_url }}">
              {{- s.button_label -}}
              <span class="btn__knob">{%- render 'icon', icon: 'arrow' -%}</span>
            </a>
          {%- endif -%}
          {%- if s.link_label != blank -%}
            <a class="btn btn--ghost hero__btn" href="{{ s.link_url | default: routes.collections_url }}">
              {%- render 'icon', icon: 'gift' -%}
              {{- s.link_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero__visual">
      <div class="hero__frame">
        <div class="media hero__media">
          {%- if s.image -%}
            {%- render 'image', image: s.image, sizes: '(min-width: 990px) 46vw, calc(100vw - 60px)', loading: img_loading, priority: img_priority, class: 'hero__img' -%}
          {%- elsif settings.demo_content -%}
            {%- render 'demo-image', name: 'hero-sunflowers', sizes: '(min-width: 990px) 46vw, calc(100vw - 60px)', loading: img_loading, priority: img_priority, class: 'hero__img', alt: 'Hand holding a bouquet of three crochet sunflowers' -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      {%- if s.inset_image or settings.demo_content -%}
        <div class="hero__inset media">
          {%- if s.inset_image -%}
            {%- render 'image', image: s.inset_image, sizes: '(min-width: 990px) 16vw, 34vw', width: 800, class: 'hero__inset-img' -%}
          {%- else -%}
            {%- render 'demo-image', name: 'bee-keychain', sizes: '(min-width: 990px) 16vw, 34vw', class: 'hero__inset-img', alt: 'Crochet bee keychain in an open palm' -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.show_badge -%}
        <div class="hero__badge" aria-hidden="true">
          <svg class="hero__badge-text" viewBox="0 0 120 120" focusable="false">
            <defs><path id="HeroBadge-{{ section.id }}" d="M60 60 m-45 0 a45 45 0 1 1 90 0 a45 45 0 1 1 -90 0"/></defs>
            <text><textPath href="#HeroBadge-{{ section.id }}" textLength="279" lengthAdjust="spacing">{{ 'general.tagline' | t | upcase }} · {{ 'general.tagline' | t | upcase }} ·</textPath></text>
          </svg>
          {%- render 'logo-mark', size: 46, id: 'hero-badge', class: 'hero__badge-mark' -%}
        </div>
      {%- endif -%}

      <svg class="hero__flower hero__flower--a" viewBox="0 0 30 30" aria-hidden="true" focusable="false"><use href="#yb-flower"/></svg>
      <svg class="hero__flower hero__flower--b" viewBox="0 0 30 30" aria-hidden="true" focusable="false"><use href="#yb-flower"/></svg>
    </div>
  </div>

  <svg width="0" height="0" class="visually-hidden" aria-hidden="true" focusable="false">
    <symbol id="yb-flower" viewBox="-15 -15 30 30">
      <g fill="none" stroke="currentColor" stroke-width=".8">
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(72)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(144)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(216)"/>
        <ellipse cx="0" cy="-6.6" rx="4.4" ry="6.2" transform="rotate(288)"/>
        <circle r="2.2"/>
      </g>
    </symbol>
  </svg>
</section>

{% stylesheet %}
  .hero { padding-top: clamp(var(--space-6), 2rem + 3vw, var(--space-9)); overflow: clip; }
  .hero__grid { display: grid; gap: clamp(var(--space-8), 3rem + 3vw, var(--space-9)); align-items: center; }
  .hero__copy { display: grid; gap: var(--space-4); justify-items: start; max-width: 36rem; }
  .hero__title { max-width: 12ch; }
  .hero__text { max-width: 30rem; color: var(--color-ink); }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    width: 100%;
  }
  /* On phones the two buttons stack full width, right under the thumb; from tablet up they sit side by side. */
  .hero__btn { flex: 1 1 100%; }
  .hero__btn.btn--knob { justify-content: space-between; padding-left: 1.75rem; }
  @media (min-width: 600px) {
    .hero__btn { flex: 0 0 auto; }
    .hero__btn.btn--knob { justify-content: center; }
  }

  /* Highlighted words get a hand-stitched underline that sews itself in. */
  .hl { position: relative; white-space: nowrap; }
  .hl__stitch {
    position: absolute;
    left: -2%;
    bottom: -.04em;
    width: 104%;
    height: .26em;
    overflow: visible;
  }
  .hl__stitch path {
    fill: none;
    stroke: var(--strand);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 7 6;
    vector-effect: non-scaling-stroke;
  }

  .hero__visual { position: relative; margin-inline: 6px 2px; }
  /* The photo-frame outline from the Instagram covers: a fine Rose line just outside the photo. */
  .hero__frame {
    position: relative;
    padding: 10px;
    border: 1.5px solid color-mix(in srgb, var(--rose) 85%, transparent);
    border-radius: calc(var(--radius-lg) + 10px);
  }
  .hero__media { --ratio: 4 / 5; border-radius: var(--radius-lg); }

  .hero__inset {
    position: absolute;
    left: -6px;
    bottom: -28px;
    width: 34%;
    --ratio: 1;
    border-radius: 50%;
    border: 6px solid var(--color-bg);
    box-shadow: 0 18px 40px -22px rgba(78, 58, 49, .55);
  }

  .hero__badge {
    position: absolute;
    top: -30px;
    right: -6px;
    width: 104px;
    height: 104px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--cream);
    box-shadow: 0 10px 30px -18px rgba(78, 58, 49, .5);
  }
  .hero__badge-text { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .hero__badge-text text {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 9.5px;
    letter-spacing: .1em;
    fill: var(--cocoa);
  }
  .hero__badge-mark { width: 44px; height: 44px; }

  .hero__flower { position: absolute; color: var(--taupe); opacity: .38; pointer-events: none; }
  .hero__flower--a { width: 56px; bottom: 18%; right: -20px; }
  .hero__flower--b { width: 40px; top: 30%; left: -22px; opacity: .28; }

  @media (min-width: 990px) {
    .hero { padding-top: var(--space-7); padding-bottom: calc(var(--section-space) + var(--space-5)); }
    .hero__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(var(--space-7), 6vw, var(--space-10)); }
    .hero__visual { margin-inline: 0 var(--space-6); }
    .hero__inset { width: 38%; left: -16%; bottom: -36px; }
    .hero__badge { width: 132px; height: 132px; top: -44px; right: -48px; }
    .hero__badge-mark { width: 56px; height: 56px; }
    .hero__flower--a { width: 88px; right: -64px; bottom: 26%; }
    .hero__flower--b { width: 56px; left: -30%; top: 12%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Copy rises in; the photo settles from a slight zoom (transform only, so it still counts as painted for LCP). */
    .hero__anim { animation: hero-rise var(--dur-hero) var(--ease-out) var(--d, 0ms) both; }
    .hero__img, .hero__media > .placeholder-svg { animation: hero-settle 1600ms var(--ease-out) both; }
    .hero__inset { animation: hero-pop 900ms var(--ease-spring) 380ms both, hero-bob 7s ease-in-out 1.4s infinite alternate; }
    .hero__badge { animation: hero-pop 900ms var(--ease-spring) 520ms both; }
    .hero__badge-text { animation: badge-spin 28s linear infinite; }
    .hl__stitch path { animation: hl-sew 1100ms var(--ease-in-out) 700ms both; }
    .hero__flower { animation: hero-drift 15s ease-in-out infinite alternate; }
    .hero__flower--b { animation-duration: 12s; animation-delay: -5s; }
    /* While the logo intro plays, hold the entrance so it happens as the intro fades. */
    html.yb-intro :is(.hero__anim, .hero__img, .hero__inset, .hero__badge, .hl__stitch path) { animation-play-state: paused; }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes hero-settle { from { transform: scale(1.06); } }
  @keyframes hero-pop { from { opacity: 0; transform: scale(.6); } }
  @keyframes hero-bob { to { translate: 0 -8px; } }
  @keyframes badge-spin { to { transform: rotate(1turn); } }
  @keyframes hl-sew { from { stroke-dasharray: 0 400; } to { stroke-dasharray: 7 6; } }
  @keyframes hero-drift {
    from { transform: translate3d(0, 0, 0) rotate(0deg); }
    to { transform: translate3d(8px, -14px, 0) rotate(28deg); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main photo",
      "info": "Portrait or square, at least 1600 px wide. One product, plenty of space around it."
    },
    {
      "type": "image_picker",
      "id": "inset_image",
      "label": "Small round photo",
      "info": "A second product, shown in a circle overlapping the main photo. Square."
    },
    { "type": "checkbox", "id": "show_badge", "label": "Show \"Handmade with love\" badge", "default": true },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "info": "Optional line above the heading. Leave blank unless it adds something the heading doesn't say."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Handmade crochet gifts, *stitched with love*",
      "info": "The page's main heading for Google. Keep \"crochet\" in it. Wrap words in *asterisks* to give them the stitched underline."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Bouquets, keychains, hair clips and bag charms, crocheted stitch by stitch and made to be gifted."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Second button label", "default": "Find a gift" },
    { "type": "url", "id": "link_url", "label": "Second button link" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "soft", "label": "Soft blush" },
        { "value": "blush", "label": "Blush" }
      ],
      "default": "soft"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
