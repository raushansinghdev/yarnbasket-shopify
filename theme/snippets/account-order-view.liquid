{%- doc -%}
  One order as its own page (docs/account-orders-plan.md, rounds 5 and 6): its name and date, where it is on its way
  (Ordered → Shipped → Delivery), the same buttons as its card, then what's in it and what it cost, how it was paid,
  where it's going and its tracking. Liquid can't see deliveries, so the last step never says "Delivered": while the
  parcel is out it points to the courier's tracking. A cancelled or refunded order shows that instead of the steps.
  snippets/account-order-page renders one of these per order and shows only the one the address names (#Order-1001).
  Takes plain values and ready HTML, so the demo uses it too.

  @param {string} name - "#1042"
  @param {string} date - The order date, already formatted
  @param {string} state - confirmed, cod, shipped, partial, cancelled or refunded
  @param {string} [shipped_note] - When it shipped and with whom ("13 Sep · Blue Dart"), once it has
  @param {string} [cancelled_on] - When a cancelled order was cancelled
  @param {string} [track_url] - The courier's tracking page, while it's on its way
  @param {string} [buy] - The pieces still for sale, as "variant_id:qty,variant_id:qty"
  @param {number} [skipped] - How many pieces are sold out (left out of Buy again)
  @param {string} main - The pieces and the amounts, as HTML (snippets/account-order-details, part 'main')
  @param {string} [side] - Payment, address and tracking, as HTML (part 'side')
  @param {string} back_url - The account page's orders
  @param {string} help_url - WhatsApp (prefilled with the order number) or the contact page
  @param {boolean} [help_new_tab] - true when help_url is WhatsApp
{%- enddoc -%}
{%- liquid
  assign label_key = 'account.status_' | append: state
  assign id = name | handleize | prepend: 'Order-'
  assign title = 'account.order' | t: name: name

  # The steps: 1 Ordered (always done), 2 Shipped, 3 Delivery. "now" is the step in progress.
  assign now_step = 2
  if state == 'shipped' or state == 'partial'
    assign now_step = 3
  endif
  assign stopped = false
  if state == 'cancelled' or state == 'refunded'
    assign stopped = true
  endif
-%}
<article class="order-view" id="{{ id }}" aria-labelledby="{{ id }}-name" data-order-view data-title="{{ title | escape }}">
  <a class="account__quiet-link account__back" href="{{ back_url }}">{%- render 'icon', icon: 'back' -%}{{ 'account.back_orders' | t }}</a>
  <header class="order-view__head">
    <h1 class="account__title" id="{{ id }}-name" tabindex="-1">{{ title }}</h1>
    <p class="order-view__date">{{ 'account.ordered_on' | t: date: date }}</p>
    {%- if stopped -%}
      <p class="order-card__state order-card__state--stop">{%- render 'icon', icon: 'close' -%}{{ label_key | t }}</p>
      {%- if state == 'cancelled' and cancelled_on != blank -%}<p class="order-card__note">{{ 'account.cancelled_on' | t: date: cancelled_on }}</p>{%- endif -%}
    {%- endif -%}
  </header>
  {%- unless stopped -%}
    <ol class="order-steps" aria-label="{{ 'account.steps_label' | t }}" role="list">
      {%- for step in (1..3) -%}
        {%- liquid
          if step < now_step
            assign at = 'done'
          elsif step == now_step
            assign at = 'now'
          else
            assign at = 'next'
          endif
          case step
            when 1
              assign step_name = 'account.step_ordered' | t
              assign step_when = date
            when 2
              if state == 'partial'
                assign step_name = 'account.status_partial' | t
              else
                assign step_name = 'account.step_shipped' | t
              endif
              if at == 'done'
                assign step_when = shipped_note
              elsif state == 'cod'
                assign step_when = 'account.step_ready_cod' | t
              else
                assign step_when = 'account.status_confirmed_note' | t
              endif
            when 3
              assign step_name = 'account.step_delivery' | t
              if at == 'now' and track_url != blank
                assign step_when = 'account.step_on_way' | t
              elsif at == 'now'
                assign step_when = 'account.step_not_arrived' | t
              else
                assign step_when = blank
              endif
          endcase
          case at
            when 'done'
              assign said = 'account.step_done' | t
            when 'now'
              assign said = 'account.step_now' | t
            else
              assign said = 'account.step_next' | t
          endcase
        -%}
        <li class="order-steps__step order-steps__step--{{ at }}"{% if at == 'now' %} aria-current="step"{% endif %}>
          <span class="order-steps__dot" aria-hidden="true">{%- if at == 'done' -%}{%- render 'icon', icon: 'check' -%}{%- endif -%}</span>
          <span class="order-steps__name">{{ step_name }}<span class="visually-hidden">, {{ said }}</span></span>
          {%- if step_when != blank -%}<span class="order-steps__when">{{ step_when }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  {%- endunless -%}
  <div class="order-view__actions">
    {%- render 'account-order-actions', name: name, track_url: track_url, buy: buy, skipped: skipped, help_url: help_url, help_new_tab: help_new_tab -%}
  </div>
  <div class="order-view__grid">
    <section class="order-view__box order-more" aria-labelledby="{{ id }}-in">
      <h2 class="order-view__h2" id="{{ id }}-in">{{ 'account.in_order' | t }}</h2>
      {{ main }}
    </section>
    {%- if side != blank -%}
      <div class="order-view__box order-view__side order-more">{{ side }}</div>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  /* Only the order the address names is shown; with none named (or one we don't have), the "couldn't find" note. */
  .order-view { display: none; gap: var(--space-5); }
  .order-view:target { display: grid; }
  .order-views:has(.order-view:target) .order-none { display: none; }
  .order-views { display: grid; }
  /* Arriving at …#Order-1001 the browser would jump to the order and hide the offer bar: a margin taller than the page
     above it keeps the page at its top, like any other page. */
  .order-view { scroll-margin-top: 100vh; }
  .order-none { display: grid; justify-items: start; gap: var(--space-3); max-width: 34rem; }
  .order-none__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
  .order-none__text { color: var(--color-ink); font-size: var(--fs-lead); line-height: 1.5; }

  .order-view .account__back { justify-self: start; margin-bottom: calc(var(--space-4) * -1); }
  .order-view__head { display: grid; justify-items: start; gap: var(--space-1); }
  :is(.order-view__head, .order-none) .account__title:focus { outline: none; box-shadow: none; }
  .order-view__date { color: var(--color-muted); font-size: var(--fs-small); }
  .order-view__head .order-card__state { margin-top: var(--space-2); }

  /* Where it is on its way: three steps, done (Cocoa with a tick), now (a ring) and still to come (hollow). Each says
     so in words for screen readers. Down the page on phones, across from 600px. */
  .order-steps { --dot: 28px; display: grid; gap: 0; padding: var(--space-4) var(--space-5); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--white); }
  .order-steps__step { position: relative; display: grid; grid-template-columns: var(--dot) minmax(0, 1fr); column-gap: var(--space-3); padding-bottom: var(--space-4); }
  .order-steps__step:last-child { padding-bottom: 0; }
  .order-steps__step::before { content: ""; position: absolute; left: calc(var(--dot) / 2 - 1px); top: var(--dot); bottom: 0; width: 2px; background: var(--color-line-strong); }
  .order-steps__step:last-child::before { display: none; }
  .order-steps__step--done::before { background: var(--cocoa-deep); }
  .order-steps__dot { grid-row: span 2; display: grid; place-items: center; width: var(--dot); height: var(--dot); border: 2px solid var(--color-line-strong); border-radius: 50%; background: var(--white); color: var(--cream); }
  .order-steps__dot .icon { width: 16px; height: 16px; }
  .order-steps__step--done .order-steps__dot { border-color: var(--cocoa-deep); background: var(--cocoa-deep); }
  .order-steps__step--now .order-steps__dot { border-color: var(--cocoa-deep); box-shadow: inset 0 0 0 5px var(--white), inset 0 0 0 12px var(--rose); }
  .order-steps__name { align-self: center; min-height: var(--dot); display: flex; align-items: center; font-weight: 500; color: var(--color-heading); }
  .order-steps__step--next .order-steps__name { color: var(--color-muted); font-weight: 400; }
  .order-steps__when { grid-column: 2; font-size: var(--fs-small); color: var(--color-ink); }
  .order-steps__step--now .order-steps__when { color: var(--color-heading); }
  @media (min-width: 600px) {
    .order-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: var(--space-5); }
    .order-steps__step { grid-template-columns: minmax(0, 1fr); align-content: start; row-gap: var(--space-2); padding: 0 var(--space-4) 0 0; }
    .order-steps__dot { grid-row: auto; }
    .order-steps__name { min-height: 0; }
    .order-steps__when { grid-column: 1; }
    .order-steps__step::before { left: var(--dot); right: 0; top: calc(var(--dot) / 2 - 1px); bottom: auto; width: auto; height: 2px; margin-inline: var(--space-2); }
  }
  .order-view__actions { display: grid; gap: var(--space-2); }
  .order-view__grid { display: grid; gap: var(--space-4); align-items: start; }
  /* The account page's columns: the main column and a side column of the same width as its Your details card. */
  @media (min-width: 900px) { .order-view__grid { grid-template-columns: minmax(0, 1fr) minmax(19rem, 23rem); gap: var(--space-7) clamp(var(--space-6), 4vw, var(--space-8)); } }
  .order-view__box { padding: var(--space-5); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--white); }
  @media (max-width: 599px) { .order-view__box { padding: var(--space-4); } }
  .order-view__h2 { font-size: var(--fs-h3); }
  .order-view__side { gap: 0; }
  .order-view__side .order-more__block { padding-block: var(--space-4); border-top: 1px solid var(--color-line); }
  .order-view__side .order-more__block:first-child { padding-top: 0; border-top: 0; }
  .order-view__side .order-more__block:last-child { padding-bottom: 0; }

  .order-more { display: grid; gap: var(--space-4); font-size: .9375rem; color: var(--color-ink); }
  .order-more__items { display: grid; gap: var(--space-3); }
  .order-more__item { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: var(--space-3); align-items: start; }
  .order-more__item > * { align-self: center; }
  .order-more__media { --ratio: 1; border-radius: var(--radius-sm); background: var(--oat); }
  .order-more__name { display: grid; gap: 1px; min-width: 0; overflow-wrap: anywhere; color: var(--color-heading); font-weight: 500; }
  .order-more__name a { color: inherit; text-decoration-color: var(--rose); text-underline-offset: 3px; }
  .order-more__option { color: var(--color-muted); font-size: var(--fs-small); font-weight: 400; }
  .order-more__price { text-align: right; white-space: nowrap; color: var(--color-heading); }
  .order-more__price s { margin-right: 4px; color: var(--color-muted); }
  .order-more__sums { display: grid; gap: var(--space-2); padding-top: var(--space-4); border-top: 1px solid var(--color-line); }
  .order-more__sums > div { display: flex; justify-content: space-between; gap: var(--space-4); }
  .order-more__sums dt { color: var(--color-muted); }
  .order-more__sums dd { margin: 0; text-align: right; color: var(--color-heading); }
  .order-more__total { margin-top: var(--space-2); padding-top: var(--space-3); border-top: 1px solid var(--color-line); font-size: 1.0625rem; font-weight: 500; }
  .order-more .order-more__total dt { color: var(--color-heading); }
  .order-more__block { display: grid; gap: 2px; }
  .order-more__label { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-1); font-family: var(--font-sans); font-style: normal; font-size: var(--fs-small); font-weight: 500; line-height: 1.4; color: var(--color-muted); }
  .order-more__label .icon { width: 18px; height: 18px; color: var(--cocoa); }
  .order-more__label .icon__fill { fill: var(--blush); }
  .order-more__block p, .order-more__parcels { color: var(--color-heading); overflow-wrap: anywhere; }
  .order-more__parcels a { color: inherit; text-decoration-color: var(--rose); text-underline-offset: 3px; }
{% endstylesheet %}
