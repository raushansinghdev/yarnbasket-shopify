{%- comment -%}
  Track your order (docs/account-plan.md §7), on a page using the "track-order" template; Help → Track order links
  here. Shoppers who checked out as guests don't know they "have an account": signing in with the email they ordered
  with shows every order and its tracking. Signed in, the latest order is shown first.
{%- endcomment -%}
{%- liquid
  assign whatsapp = settings.social_whatsapp | remove: '+' | remove: ' ' | remove: '-'
  assign last = customer.last_order
-%}
<div class="section track scheme-soft">
  <div class="track__inner">
    <span class="track__icon" aria-hidden="true">{%- render 'icon', icon: 'package' -%}</span>
    <h1 class="track__title">{{ 'track.title' | t }}</h1>

    {%- if customer -%}
      <p class="track__lead">{{ 'track.lead_in' | t }}</p>
      {%- if last -%}
        {%- assign first_item = last.line_items.first -%}
        <a class="track-order" href="{{ last.customer_url | default: routes.account_url }}">
          <span class="track-order__media media">
            {%- if first_item.image -%}
              {{ first_item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            {%- endif -%}
          </span>
          <span class="track-order__text">
            <span class="eyebrow">{{ 'track.latest' | t }}</span>
            <span class="track-order__name">{{ 'track.order' | t: name: last.name }}</span>
            <span class="track-order__meta">
              {{- last.created_at | date: format: 'date' }} · {{ last.fulfillment_status_label -}}
            </span>
          </span>
          <span class="track-order__go">{{ 'track.track' | t }}{%- render 'icon', icon: 'arrow' -%}</span>
        </a>
      {%- endif -%}
      <a class="btn track__btn" href="{{ routes.account_url }}">{{ 'track.see_orders' | t }}</a>
    {%- else -%}
      <p class="track__lead">{{ 'track.lead_out' | t }}</p>
      <a class="btn track__btn" href="{{ routes.account_login_url }}">{{ 'track.sign_in' | t }}</a>
      <p class="track__aside">{{ 'track.or_email' | t }}</p>
    {%- endif -%}

    <div class="track__help">
      <h2 class="track__help-title">{{ 'track.help_title' | t }}</h2>
      <p>{{ 'track.help_text' | t }}</p>
      {%- if whatsapp != blank -%}
        {%- capture message -%}{{ 'track.whatsapp_message' | t }}{% if last %}{{ last.name | remove: '#' }}{% endif %}{%- endcapture -%}
        <a class="btn btn--ghost" href="https://wa.me/{{ whatsapp }}?text={{ message | url_encode }}" rel="noopener" target="_blank">
          {%- render 'icon', icon: 'whatsapp' -%}{{ 'track.whatsapp' | t }}
          <span class="visually-hidden">({{ 'accessibility.new_window' | t }})</span>
        </a>
      {%- else -%}
        <a class="btn btn--ghost" href="/pages/contact?topic=order#ContactForm">{{ 'track.contact' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .track { padding-block: var(--space-7) var(--section-space); }
  .track__inner { display: grid; justify-items: start; gap: var(--space-3); max-width: 34rem; }
  .track__icon .icon { width: 40px; height: 40px; color: var(--color-heading); }
  .track__icon .icon__fill { fill: var(--blush); }
  .track__title { font-size: clamp(2rem, 1.5rem + 2vw, 3rem); line-height: 1.05; }
  .track__lead { font-size: var(--fs-lead); line-height: 1.5; color: var(--color-ink); }
  .track__btn { margin-top: var(--space-2); }
  .track__aside { color: var(--color-muted); font-size: var(--fs-small); }

  .track-order {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    margin-top: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--white);
    color: inherit;
    text-decoration: none;
  }
  .track-order__media { --ratio: 1; border-radius: var(--radius-sm); background: var(--oat); }
  .track-order__text { display: grid; gap: 2px; min-width: 0; }
  .track-order__name { font-weight: 500; color: var(--color-heading); }
  .track-order__meta { font-size: var(--fs-small); color: var(--color-muted); }
  .track-order__go { display: inline-flex; align-items: center; gap: 4px; font-weight: 500; color: var(--color-heading); }
  .track-order__go .icon { width: 18px; height: 18px; transition: transform var(--dur-panel) var(--ease-out); }
  @media (hover: hover) { .track-order:hover .track-order__go .icon { transform: translateX(3px); } }

  .track__help { display: grid; justify-items: start; gap: var(--space-2); width: 100%; margin-top: var(--space-7); padding-top: var(--space-6); border-top: 1px solid var(--color-line); }
  .track__help-title { font-size: var(--fs-h3); }
  .track__help p { color: var(--color-muted); }
{% endstylesheet %}
