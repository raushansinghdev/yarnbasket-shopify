{%- doc -%}
  The cart's totals and Checkout (docs/cart-plan.md §4, §6.5). In the drawer it's the pinned footer; on the cart page
  it's the summary card. Checkout is a real submit button named "checkout", so the cart form (quantities, gift note)
  is saved first and Shopify then sends the shopper to its checkout. It must stay the only way into checkout, so a
  checkout app can take it over later.

  The drawer's footer is kept small so the products get the room (docs/cart-compact-plan.md): only the amount and
  Checkout, on one row that wraps when there's no room for both. The amount is a button with a dotted underline
  that scrolls to the price details at the end of the list (snippets/cart-details, cart.js). On the cart page the
  price details are part of the card.

  @param {string} place - 'drawer' or 'page'. The page also shows express payment buttons and payment icons.

  @example
  {% render 'cart-summary', place: 'page' %}
{%- enddoc -%}
{%- liquid
  assign blocked = false
  for item in cart.items
    if item.variant.available == false
      assign blocked = true
      break
    endif
  endfor
  capture list_total
    render 'cart-list-total'
  endcapture
  assign list_total = list_total | plus: 0
  assign saved = list_total | minus: cart.total_price
-%}
<div class="cart-summary cart-summary--{{ place }}">
  {%- render 'cart-rewards', place: place -%}
  {%- if place == 'page' -%}{%- render 'cart-details', place: 'page' -%}{%- endif -%}

  <div class="cart-summary__main">
    {%- if place == 'drawer' -%}
      <button type="button" class="cart-summary__amount" data-details data-total>
        <span class="visually-hidden">{{ 'cart.subtotal' | t }}</span>
        {%- if saved > 0 -%}<s aria-hidden="true">{{ list_total | money }}</s>{%- endif -%}
        <span class="cart-summary__now">{{ cart.total_price | money }}</span>
        <span class="visually-hidden">{{ 'cart.details' | t }}</span>
      </button>
    {%- endif -%}
    <button
      type="submit"
      name="checkout"
      class="btn cart-summary__checkout"
      data-checkout
      {% if blocked %}
        disabled aria-describedby="CartBlocked-{{ place }}"
      {% endif %}
    >
      {%- render 'icon', icon: 'lock' -%}
      <span>{{ 'cart.checkout' | t }}</span>
    </button>
  </div>
  {%- if blocked -%}
    <p class="cart-summary__blocked" id="CartBlocked-{{ place }}">{{ 'cart.sold_out' | t }}</p>
  {%- endif -%}

  {%- if place == 'page' and additional_checkout_buttons -%}
    <div class="cart-summary__express">{{ content_for_additional_checkout_buttons }}</div>
  {%- endif -%}

  {%- if place == 'page' and shop.enabled_payment_types.size > 0 -%}
    <div class="cart-summary__pay">
      <p class="visually-hidden">{{ 'cart.payments' | t }}</p>
      <ul role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'cart-summary__pay-icon' }}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-summary { display: grid; gap: var(--space-3); }
  .cart-summary__main { display: grid; gap: var(--space-3); }
  .cart-summary__checkout { width: 100%; min-height: 56px; font-size: 1.0625rem; gap: var(--space-2); }
  .cart-summary__checkout .icon { width: 20px; height: 20px; }
  @media (hover: hover) { .cart-summary__checkout:hover .icon { transform: none; } }
  .cart-summary__checkout:disabled { --btn-bg: var(--taupe-ink); cursor: not-allowed; transform: none; box-shadow: none; }
  .cart-summary__blocked { font-size: var(--fs-small); color: #9A3B2E; font-weight: 500; text-align: center; }
  .cart-summary__express:empty { display: none; }
  .cart-summary__pay ul { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); }
  .cart-summary__pay-icon { width: 38px; height: 24px; }

  /* The drawer: the amount on the left, Checkout filling the rest of the row. When the two don't fit side by side
     (large text), Checkout wraps under the amount at full width. The dotted underline says the amount can be
     tapped: it goes to the price details. */
  .cart-summary--drawer .cart-summary__main { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  .cart-summary--drawer .cart-summary__checkout { flex: 1 1 10rem; width: auto; }
  .cart-summary__amount {
    display: grid;
    align-content: center;
    justify-items: start;
    min-width: var(--tap);
    min-height: var(--tap);
    font-weight: 500;
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--color-heading);
    font-variant-numeric: tabular-nums;
    border-radius: var(--radius-sm);
    transition: opacity var(--dur-state) ease;
  }
  .cart-summary__amount s { font-size: var(--fs-small); font-weight: 400; color: var(--color-muted); }
  .cart-summary__now { text-decoration: underline dotted; text-decoration-thickness: 2px; text-underline-offset: 6px; text-decoration-color: var(--taupe-ink); }
  @media (hover: hover) { .cart-summary__amount:hover .cart-summary__now { text-decoration-style: solid; } }
{% endstylesheet %}
