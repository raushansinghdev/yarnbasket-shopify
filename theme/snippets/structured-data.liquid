{%- doc -%}
  JSON-LD for search engines and AI answer engines.
  Home: Organization and WebSite (with site search). Contact page: ContactPage with how to reach us. Product: our own Product data with one Offer per variant, shipping and a breadcrumb
  (docs/product-page-plan.md).
  The home page FAQ section outputs its own FAQPage data.
{%- enddoc -%}
{%- if request.page_type == 'index' -%}
  {%- liquid
    assign same_as = ''
    if settings.social_instagram != blank
      assign same_as = same_as | append: settings.social_instagram | append: '|'
    endif
    if settings.social_meesho != blank
      assign same_as = same_as | append: settings.social_meesho | append: '|'
    endif
    assign same_as = same_as | split: '|'
  -%}
  {%- capture search_template -%}{{ shop.url }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ shop.url | append: '/#organization' | json }},
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }},
          {%- if settings.logo %}
          "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
          {%- endif %}
          {%- if shop.description != blank %}
          "description": {{ shop.description | json }},
          {%- endif %}
          "slogan": "Handmade with love",
          "sameAs": {{ same_as | json }}
        },
        {
          "@type": "WebSite",
          "@id": {{ shop.url | append: '/#website' | json }},
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }},
          "inLanguage": "en-IN",
          "publisher": { "@id": {{ shop.url | append: '/#organization' | json }} },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": {{ search_template | json }}
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
  </script>
{%- elsif request.page_type == 'product' -%}
  {%- comment -%}
    Our own Product data (docs/product-page-plan.md "SEO"): one Offer per variant in rupees, the shipping fee from
    Theme settings → Cart, a breadcrumb, and ratings only when real ones exist. No return policy here yet: the rule
    is replacement if damaged with no change-of-mind returns, and the exact markup is settled in the SEO phase.
  {%- endcomment -%}
  {%- liquid
    assign product_url = shop.url | append: product.url
    assign ship_from = settings.free_shipping_threshold | default: 0 | times: 100
    assign ship_fee = settings.shipping_fee | default: 0 | times: 100
    assign rating_count = product.metafields.reviews.rating_count.value | default: 0
    assign crumb = collection
    if crumb == blank
      assign craft_handle = product.type | handleize
      assign craft = collections[craft_handle]
      if craft.id
        assign crumb = craft
      endif
    endif
    if crumb == blank
      assign skip = 'frontpage,all,shop,bestsellers' | split: ','
      for c in product.collections
        if skip contains c.handle or c.id == settings.shop_all_collection.id
          continue
        endif
        assign crumb = c
        break
      endfor
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Product",
          "@id": {{ product_url | append: '#product' | json }},
          "name": {{ product.title | json }},
          "url": {{ product_url | json }},
          {%- if product.description != blank %}
          "description": {{ product.description | strip_html | strip_newlines | truncate: 5000 | json }},
          {%- endif %}
          {%- if product.media.size > 0 %}
          "image": [
            {%- for media in product.media limit: 8 -%}
              {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ],
          {%- endif %}
          {%- if product.type != blank %}
          "category": {{ product.type | json }},
          {%- endif %}
          "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
          {%- if rating_count > 0 %}
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
            "bestRating": {{ product.metafields.reviews.rating.value.scale_max | json }},
            "ratingCount": {{ rating_count }}
          },
          {%- endif %}
          "offers": [
            {%- for variant in product.variants -%}
              {
                "@type": "Offer",
                "url": {{ product_url | append: '?variant=' | append: variant.id | json }},
                {%- unless product.has_only_default_variant %}
                "name": {{ variant.title | json }},
                {%- endunless %}
                {%- if variant.sku != blank %}
                "sku": {{ variant.sku | json }},
                {%- endif %}
                "price": {{ variant.price | divided_by: 100.0 | json }},
                "priceCurrency": {{ cart.currency.iso_code | json }},
                "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
                "itemCondition": "https://schema.org/NewCondition",
                {%- if ship_from > 0 or ship_fee > 0 %}
                "shippingDetails": {
                  "@type": "OfferShippingDetails",
                  "shippingRate": {
                    "@type": "MonetaryAmount",
                    "value": {% if ship_from > 0 and variant.price >= ship_from %}0{% else %}{{ ship_fee | divided_by: 100.0 | json }}{% endif %},
                    "currency": {{ cart.currency.iso_code | json }}
                  },
                  "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IN" }
                },
                {%- endif %}
                "seller": { "@id": {{ shop.url | append: '/#organization' | json }} }
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ shop.url | json }} },
            {%- if crumb != blank %}
            { "@type": "ListItem", "position": 2, "name": {{ crumb.title | json }}, "item": {{ shop.url | append: crumb.url | json }} },
            { "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
            {%- else %}
            { "@type": "ListItem", "position": 2, "name": {{ product.title | json }} }
            {%- endif %}
          ]
        }
      ]
    }
  </script>
{%- elsif request.page_type == 'page' and page.handle == 'contact' -%}
  {%- comment -%} How to reach us (docs/contact-plan.md): the contact email from Theme settings → Social. No number: the page doesn't ask for calls. {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "@id": {{ shop.url | append: page.url | append: '#contactpage' | json }},
      "url": {{ shop.url | append: page.url | json }},
      "name": {{ page.title | json }},
      "inLanguage": "en-IN",
      "mainEntity": {
        "@type": "Organization",
        "@id": {{ shop.url | append: '/#organization' | json }},
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer service",
          {%- if settings.social_email != blank %}
          "email": {{ settings.social_email | strip | json }},
          {%- endif %}
          "areaServed": "IN",
          "availableLanguage": ["English", "Hindi"]
        }
      }
    }
  </script>
{%- endif -%}
