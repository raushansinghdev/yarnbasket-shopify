{%- doc -%}
  Brand fonts, self-hosted so pages don't wait on a third-party connection.
  Files are Google Fonts subsets (Latin plus ₹ and typographic punctuation):
  Cormorant Garamond Italic 600 for headings, Jost variable 400–500 for text.
{%- enddoc -%}
<style>
  @font-face {
    font-family: "Cormorant Garamond";
    font-style: italic;
    font-weight: 600;
    font-display: swap;
    src: url("{{ 'cormorant-garamond-600-italic.woff2' | asset_url }}") format("woff2");
  }
  @font-face {
    font-family: "Jost";
    font-style: normal;
    font-weight: 400 500;
    font-display: swap;
    src: url("{{ 'jost-variable.woff2' | asset_url }}") format("woff2");
  }
</style>
