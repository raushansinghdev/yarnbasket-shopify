{%- doc -%}
  What's inside one order, for its own page (snippets/account-order-view, docs/account-orders-plan.md), in two parts
  so the page can place them: 'main' is the pieces and the amounts; 'side' is the payment, where it's going and the
  parcel's tracking. Every amount is the order's own figure, as charged; nothing is worked out here.
  Liquid can't see deliveries, so this never says "Delivered".

  @param {object} order - The order
  @param {string} part - 'main' or 'side'
{%- enddoc -%}
{%- liquid
  assign address = order.shipping_address

  case order.financial_status
    when 'paid'
      assign pay_key = 'account.pay_paid'
    when 'pending', 'authorized', 'partially_paid'
      assign pay_key = 'account.pay_due'
    when 'refunded'
      assign pay_key = 'account.pay_refunded'
    when 'partially_refunded'
      assign pay_key = 'account.pay_part_refunded'
    else
      assign pay_key = blank
  endcase
-%}
{%- if part == 'main' -%}
  <ul class="order-more__items" role="list">
    {%- for li in order.line_items -%}
      <li class="order-more__item">
        <span class="order-more__media media" aria-hidden="true">
          {%- if li.image -%}
            <img src="{{ li.image | image_url: width: 112, height: 112, crop: 'center' }}" alt="" width="56" height="56" loading="lazy">
          {%- endif -%}
        </span>
        <span class="order-more__name">
          {%- if li.product -%}
            <a href="{{ li.product.url }}">{{ li.product.title | default: li.title | escape }}</a>
          {%- else -%}
            {{ li.product.title | default: li.title | escape }}
          {%- endif -%}
          {%- if li.variant.title != blank and li.variant.title != 'Default Title' -%}
            <span class="order-more__option">{{ li.variant.title | escape }}</span>
          {%- endif -%}
          <span class="order-more__option">{{ 'account.quantity' | t: count: li.quantity }}</span>
        </span>
        <span class="order-more__price">
          {%- if li.final_line_price == 0 -%}
            {{ 'account.free' | t }}
          {%- else -%}
            {%- if li.original_line_price > li.final_line_price -%}
              <s><span class="visually-hidden">{{ 'products.regular_price' | t }} </span>{{ li.original_line_price | money }}</s>
            {%- endif -%}
            {{ li.final_line_price | money }}
          {%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>

  <dl class="order-more__sums">
    <div><dt>{{ 'account.subtotal' | t }}</dt><dd>{{ order.line_items_subtotal_price | money }}</dd></div>
    {%- for discount in order.cart_level_discount_applications -%}
      <div><dt>{{ discount.title | escape }}</dt><dd>−{{ discount.total_allocated_amount | money }}</dd></div>
    {%- endfor -%}
    <div>
      <dt>{{ 'account.delivery' | t }}</dt>
      <dd>{%- if order.shipping_price > 0 -%}{{ order.shipping_price | money }}{%- else -%}{{ 'account.free' | t }}{%- endif -%}</dd>
    </div>
    <div class="order-more__total"><dt>{{ 'account.total' | t }}</dt><dd>{{ order.total_price | money }}</dd></div>
  </dl>
{%- else -%}
  {%- if pay_key or order.total_refunded_amount > 0 -%}
    <div class="order-more__block">
      <h2 class="order-more__label">{{ 'account.payment' | t }}</h2>
      <p>
        {%- if pay_key -%}{{ pay_key | t }}{%- endif -%}
        {%- if order.total_refunded_amount > 0 -%}
          {%- if pay_key -%}<br>{%- endif -%}
          {{ 'account.refunded_amount' | t }}: {{ order.total_refunded_amount | money }}
        {%- endif -%}
      </p>
    </div>
  {%- endif -%}

  {%- if address -%}
    <div class="order-more__block">
      <h2 class="order-more__label">{{ 'account.delivering_to' | t }}</h2>
      <p>
        {{ address.name | escape }}<br>
        {{ address.address1 | escape }}{% if address.address2 != blank %}, {{ address.address2 | escape }}{% endif %}<br>
        {{ address.city | escape }} {{ address.zip | escape }}{% if address.province != blank %}, {{ address.province | escape }}{% endif %}
        {%- if address.phone != blank -%}<br>{{ address.phone | escape }}{%- endif -%}
      </p>
    </div>
  {%- endif -%}

  {%- comment -%} One line per parcel: an order sent in two parcels lists both. {%- endcomment -%}
  {%- assign listed = '' -%}
  {%- capture parcels -%}
    {%- for li in order.line_items -%}
      {%- assign f = li.fulfillment -%}
      {%- if f == blank or f.tracking_number == blank -%}{%- continue -%}{%- endif -%}
      {%- assign key = f.tracking_number | prepend: '|' | append: '|' -%}
      {%- if listed contains key -%}{%- continue -%}{%- endif -%}
      {%- assign listed = listed | append: key -%}
      <li>
        {%- if f.tracking_company != blank -%}{{ f.tracking_company | escape }} · {% endif -%}
        {%- if f.tracking_url != blank -%}
          <a href="{{ f.tracking_url }}" rel="noopener" target="_blank">{{ f.tracking_number | escape }}<span class="visually-hidden"> ({{ 'accessibility.new_window' | t }})</span></a>
        {%- else -%}
          {{ f.tracking_number | escape }}
        {%- endif -%}
      </li>
    {%- endfor -%}
  {%- endcapture -%}
  {%- if listed != '' -%}
    <div class="order-more__block">
      <h2 class="order-more__label">{{ 'account.tracking' | t }}</h2>
      <ul class="order-more__parcels" role="list">{{ parcels }}</ul>
    </div>
  {%- endif -%}
{%- endif -%}
