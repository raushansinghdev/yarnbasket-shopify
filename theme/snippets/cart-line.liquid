{%- doc -%}
  One line in the cart, shared by the drawer and the cart page (docs/cart-plan.md §4).
  Photo · name · options · price · quantity stepper. The photo repeats the name link, so it's hidden from screen
  readers and skipped by Tab; the name is the one link. cart.js keeps the photo element when it refreshes a line
  (only [data-line-body] is swapped), so photos never flash.
  The free gift (docs/offers-plan.md §5.4) gets a "Free gift" badge, "Free" with its worth struck through, and a
  remove button instead of the stepper, but only while it really is free. If its discount is missing it's an ordinary
  line at its real price (rewards.js takes it out), so nothing is given away and nothing is mislabelled.

  One product, one line (docs/cart-compact-plan.md §9). With the gift's "Buy X get Y" discount on, Shopify keeps the
  pieces that earned the gift on a line of their own, so the same product can come back as two lines, and it splits
  them again if they're merged through its API. Lines that are the same thing (variant, options typed in, selling
  plan) are drawn once: the first one shows the total quantity and price, and the others draw nothing. The quantity
  field posts the total for the first line and a hidden 0 for each of the others, which Shopify adds up to the same
  total, with or without JavaScript; cart.js sends the same from data-more.

  @param {object} item - The cart line item
  @param {string} place - 'drawer' or 'page' (keeps ids unique when both are on a page)
  @param {string} [sizes] - The photo's sizes attribute

  @example
  {% render 'cart-line', item: item, place: 'page' %}
{%- enddoc -%}
{%- liquid
  assign uid = item.key | handle | prepend: '-' | prepend: place
  assign title = item.product.title | escape

  assign is_gift = false
  assign gift_variant = settings.gift_product.variants.first.id
  if settings.gift_product != blank and settings.gift_threshold > 0 and item.variant_id == gift_variant and item.final_line_price == 0
    assign is_gift = true
  endif

  # The same thing on other lines: an earlier one means this line is already drawn there; later ones are added in.
  # Their discounts are kept as "title::amount" pairs, so each discount is listed once with its whole amount.
  assign qty = item.quantity
  assign line_price = item.final_line_price
  assign original_line = item.original_line_price
  assign more = ''
  assign more_keys = ''
  assign twin_before = false
  assign deals = ''
  for allocation in item.line_level_discount_allocations
    assign deals = deals | append: allocation.discount_application.title | append: '::' | append: allocation.amount | append: ';;'
  endfor
  unless item.variant_id == gift_variant
    assign props = item.properties | json
    assign past_self = false
    for other in cart.items
      if other.key == item.key
        assign past_self = true
        continue
      endif
      assign other_props = other.properties | json
      if other.variant_id != item.variant_id or other_props != props or other.selling_plan_allocation.selling_plan.id != item.selling_plan_allocation.selling_plan.id
        continue
      endif
      if past_self == false
        assign twin_before = true
        break
      endif
      assign qty = qty | plus: other.quantity
      assign line_price = line_price | plus: other.final_line_price
      assign original_line = original_line | plus: other.original_line_price
      assign more = more | append: other.key | append: ' '
      for allocation in other.line_level_discount_allocations
        assign deals = deals | append: allocation.discount_application.title | append: '::' | append: allocation.amount | append: ';;'
      endfor
    endfor
    assign more = more | strip
    assign more_keys = more | split: ' '
  endunless

  assign max = blank
  if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny'
    assign max = item.variant.inventory_quantity
    if max < qty
      assign max = qty
    endif
  endif
  # At most this many of one piece per order (Theme settings → Cart); the stock limit wins when it is lower.
  assign cap = settings.max_per_item | default: 0
  assign capped = false
  if cap > 0
    if max == blank or max > cap
      assign max = cap
      assign capped = true
    endif
  endif
  assign note = blank
  if item.variant.available == false
    assign note = 'cart.sold_out' | t
  elsif capped and qty >= max
    assign note = 'cart.cap' | t: count: cap
  elsif max != blank and qty >= max
    assign note = 'cart.max' | t
  endif

  # The struck-through price is the higher of the sale's "compare at" and the price before discounts.
  assign was = original_line
  if item.variant.compare_at_price > item.original_price
    assign was = item.variant.compare_at_price | times: qty
  endif
-%}
{%- unless twin_before -%}
<li
  class="cart-line{% if item.variant.available == false %} is-sold-out{% endif %}{% if is_gift %} is-gift{% endif %}"
  data-key="{{ item.key }}"
  data-title="{{ title }}"
  data-variant="{{ item.variant_id }}"
  data-qty="{{ qty }}"
  {% if capped %}
    data-capped
  {% endif %}
  {% if more != blank %}
    data-more="{{ more }}"
  {% endif %}
  data-properties="{{ item.properties | json | escape }}"
  {% if item.selling_plan_allocation %}
    data-plan="{{ item.selling_plan_allocation.selling_plan.id }}"
  {% endif %}
>
  <a href="{{ item.url }}" class="cart-line__media media" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {%- render 'image', image: item.image, sizes: sizes, width: 360, class: 'cart-line__img' -%}
    {%- endif -%}
  </a>
  <div class="cart-line__body" data-line-body>
    <div class="cart-line__info">
      {%- if is_gift -%}<p class="cart-line__badge">{%- render 'icon', icon: 'gift' -%}{{ 'rewards.badge' | t }}</p>{%- endif -%}
      <a href="{{ item.url }}" class="cart-line__title" id="CartTitle-{{ uid }}">{{ item.product.title }}</a>
      {%- unless item.product.has_only_default_variant -%}
        <p class="cart-line__meta">{{ item.variant.options | join: ' · ' }}</p>
      {%- endunless -%}
      {%- for property in item.properties -%}
        {%- assign first = property.first | slice: 0 -%}
        {%- if property.last != blank and first != '_' -%}
          <p class="cart-line__meta">{{ property.first }}: {{ property.last }}</p>
        {%- endif -%}
      {%- endfor -%}
      {%- unless is_gift -%}
        {%- liquid
          assign pairs = deals | split: ';;'
          assign listed = ';;'
        -%}
        {%- for pair in pairs -%}
          {%- liquid
            assign deal = pair | split: '::' | first
            assign marker = ';;' | append: deal | append: ';;'
            if listed contains marker
              continue
            endif
            assign listed = listed | append: deal | append: ';;'
            assign off = 0
            for each_pair in pairs
              assign parts = each_pair | split: '::'
              if parts.first == deal
                assign off = parts.last | plus: off
              endif
            endfor
          -%}
          {%- comment -%} Shopify lists the gift's discount on every line, with nothing off the others. {%- endcomment -%}
          {%- if off > 0 -%}
            <p class="cart-line__meta cart-line__deal">{{ deal | escape }} (−{{ off | money }})</p>
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
      {%- if qty > 1 -%}
        {%- assign each = line_price | divided_by: qty | money -%}
        <p class="cart-line__meta">{{ 'cart.each' | t: price: each }}</p>
      {%- endif -%}
    </div>
    <p class="cart-line__price">
      {%- if is_gift -%}
        <span>{{ 'rewards.free' | t }}</span>
        {%- assign worth = original_line | money -%}
        <span class="visually-hidden">{{ 'rewards.worth' | t: price: worth }}</span>
        <s aria-hidden="true">{{ worth }}</s>
      {%- elsif was > line_price -%}
        <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>
        <span>{{ line_price | money }}</span>
        <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
        <s>{{ was | money }}</s>
      {%- else -%}
        {{ line_price | money }}
      {%- endif -%}
    </p>
    <div class="cart-line__qty">
      {%- if is_gift -%}
        {%- comment -%} Without JavaScript this submits the cart form with the gift at 0; rewards.js remembers the
        "no thanks" so it isn't added again. {%- endcomment -%}
        <button type="submit" name="updates[{{ item.key }}]" value="0" class="cart-line__gift-remove" data-gift-remove>
          {%- render 'icon', icon: 'bin' -%}
          <span>{{ 'rewards.remove' | t }}</span>
        </button>
      {%- else -%}
      {%- liquid
        assign note_id = blank
        if note != blank
          assign note_id = 'CartLineNote-' | append: uid
        endif
        assign qty_name = 'updates[' | append: item.key | append: ']'
        assign qty_id = 'CartQty-' | append: uid
        render 'quantity', id: qty_id, name: qty_name, value: qty, title: title, max: max, describedby: note_id
      -%}
      {%- for key in more_keys -%}
        <input type="hidden" name="updates[{{ key }}]" value="0">
      {%- endfor -%}
      {%- endif -%}
    </div>
    <p class="cart-line__note" id="CartLineNote-{{ uid }}" data-line-note {% if note == blank %}hidden{% endif %}>
      {{- note -}}
    </p>
  </div>
</li>
{%- endunless -%}

{% stylesheet %}
  /* Phone: photo on the left; name and price share the first row; the stepper sits under them (cart-plan §4.1). */
  .cart-line {
    --photo: 88px;
    display: grid;
    grid-template-columns: var(--photo) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    padding-block: var(--space-4);
    background: linear-gradient(90deg, var(--color-line-strong) 6px, transparent 0) 0 100% / 10px 1px repeat-x;
  }
  .cart-line:last-child { background: none; }
  .cart-line__media { --ratio: 1; border-radius: var(--radius-sm); background: var(--blush); }
  .cart-line__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "info price" "qty qty" "note note";
    column-gap: var(--space-3);
    min-width: 0;
  }
  .cart-line__info { grid-area: info; display: grid; gap: 2px; align-content: start; }
  .cart-line__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* A taller tap area than one line of text (WCAG 2.5.8), without moving anything. */
    padding-block: 3px;
    margin-block: -3px;
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--color-heading);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  @media (hover: hover) { .cart-line__title:hover { text-decoration: underline; text-decoration-color: var(--rose); text-underline-offset: 3px; } }
  .cart-line__meta { font-size: var(--fs-small); line-height: 1.4; color: var(--color-muted); }
  .cart-line__price {
    grid-area: price;
    display: grid;
    justify-items: end;
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--color-heading);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: opacity var(--dur-state) ease;
  }
  .cart-line__price s { font-weight: 400; font-size: var(--fs-small); color: var(--color-muted); }
  .cart-line__qty { grid-area: qty; margin-top: var(--space-3); }
  .cart-line__note { grid-area: note; margin-top: var(--space-2); font-size: var(--fs-small); color: var(--color-heading); }
  .cart-line__note.is-error { color: #9A3B2E; font-weight: 500; }
  /* The free gift: a small badge over its name, and a plain remove button where the stepper would be. */
  .cart-line__badge { display: inline-flex; align-items: center; gap: 4px; justify-self: start; margin-bottom: 2px; padding: 2px 8px; border-radius: var(--radius-pill); background: var(--blush); color: var(--cocoa-deep); font-size: .75rem; font-weight: 500; }
  .cart-line__badge .icon { width: 14px; height: 14px; }
  .cart-line__gift-remove {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-4) 0 var(--space-3);
    border: 1.5px solid color-mix(in srgb, var(--cocoa) 40%, transparent);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--color-heading);
    font: 500 var(--fs-small) var(--font-sans);
    line-height: 1.25;
    text-align: start;
    cursor: pointer;
  }
  .cart-line__gift-remove .icon { width: 20px; height: 20px; flex: none; }
  @media (hover: hover) { .cart-line__gift-remove:hover { background: var(--color-surface); } }
  .cart-line.is-sold-out .cart-line__media img { filter: grayscale(.7); opacity: .7; }
  /* While a change is on its way, the line's price and the totals dim; nothing else moves. */
  .cart-line.is-busy .cart-line__price, [data-cart-root].is-busy [data-total] { opacity: .55; }

  /* The slim row a removed line becomes, with its Undo (cart-plan §6.3). */
  .cart-undo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 56px;
    margin-block: var(--space-2);
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-4);
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    color: var(--color-muted);
  }
  .cart-undo__btn {
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--color-heading);
    font: 500 var(--fs-small) var(--font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--rose);
    cursor: pointer;
  }
  @media (hover: hover) { .cart-undo__btn:hover { background: var(--color-surface); } }
  @media (prefers-reduced-motion: no-preference) {
    .cart-undo { animation: cart-fade var(--dur-panel) var(--ease-out) both; }
  }
  @keyframes cart-fade { from { opacity: 0; } }
  @media (forced-colors: active) { .cart-line { border-bottom: 1px solid CanvasText; } .cart-undo { border-color: CanvasText; } }

  /* Last, so it wins over the rules above. Large text (the line is under 15em wide, about 150% on a phone): the price moves under the name and the photo
     shrinks, so nothing is pushed past the edge. */
  .cart-lines { container-type: inline-size; }
  @container (max-width: 15em) {
    .cart-line { --photo: 64px; }
    .cart-line__body { grid-template-columns: minmax(0, 1fr); grid-template-areas: "info" "price" "qty" "note"; }
    .cart-line__price { justify-items: start; }
  }
{% endstylesheet %}
