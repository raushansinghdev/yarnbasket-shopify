{%- doc -%}
  The cart's rewards (docs/offers-plan.md §5, docs/pricing-plan.md): one goal at a time. A line of words names the
  next goal ("Add ₹120 more for free shipping") and a thin bar runs from the last goal reached to that one, so it
  fills afresh for each goal; what's already earned sits above as short ticks. The ladder is free shipping, the free
  gift, then up to two money-off steps (Theme settings → Cart). The words are the truth; the bar and its amount are
  decoration. Drawn by the server, so it's right without JavaScript; rewards.js adds and removes the gift and reads
  its state from the data attributes here.

  Shipping uses the cart total as Shopify's free rate sees it (after discounts). The gift step uses the total without
  the gift itself, so a gift that's still charged (its discount is missing) can't pay for its own step. The money-off
  steps use the items' subtotal before order discounts, as Shopify's automatic discounts do: otherwise the ₹50 just
  earned would push the cart back under its own step.

  @param {string} place - 'drawer' or 'page'. The drawer offers "Small add-ons" while a goal is still ahead; the
    page has Little extras for that.

  @example
  {% render 'cart-rewards', place: 'drawer' %}
{%- enddoc -%}
{%- liquid
  assign ship_at = settings.free_shipping_threshold | default: 0 | times: 100
  assign gift_at = settings.gift_threshold | default: 0 | times: 100
  assign gift = settings.gift_product
  assign gift_variant = gift.variants.first
  assign gift_line = nil
  assign gift_paid = 0
  if gift_variant
    for item in cart.items
      if item.variant_id == gift_variant.id
        assign gift_line = item
        assign gift_paid = gift_paid | plus: item.final_line_price
      endif
    endfor
  endif

  # The gift step needs an amount above free shipping and a gift that's in the cart or can still be had.
  assign gift_on = false
  if gift_variant and gift_at > ship_at
    if gift_line or gift_variant.available
      assign gift_on = true
    endif
  endif

  assign total = cart.total_price | minus: gift_paid
  assign basis = cart.items_subtotal_price | minus: gift_paid
  assign top = ship_at
  if gift_on
    assign top = gift_at
  endif

  # Money-off steps: each needs an amount and a starting total above the step before it.
  assign off1_at = settings.discount_1_from | default: 0 | times: 100
  assign off1 = settings.discount_1_amount | default: 0 | times: 100
  assign off2_at = settings.discount_2_from | default: 0 | times: 100
  assign off2 = settings.discount_2_amount | default: 0 | times: 100
  assign off1_on = false
  assign off2_on = false
  if off1 > 0 and off1_at > top
    assign off1_on = true
    assign top = off1_at
    if off2 > 0 and off2_at > off1_at
      assign off2_on = true
      assign top = off2_at
    endif
  endif
  assign earned_off = 0
  if off2_on and basis >= off2_at
    assign earned_off = off2
  elsif off1_on and basis >= off1_at
    assign earned_off = off1
  endif

  assign declined = false
  if cart.attributes._gift_declined == '1'
    assign declined = true
  endif
  assign gift_name = gift.title | escape
-%}
{%- if top > 0 and cart.item_count > 0 -%}
  {%- liquid
    # The next goal: where its stretch of the bar starts and ends, and how far along the cart is.
    assign next = blank
    assign from = 0
    assign to = 0
    assign have = 0
    assign next_off = 0
    if ship_at > 0 and cart.total_price < ship_at
      assign next = 'ship'
      assign to = ship_at
      assign have = cart.total_price
    elsif gift_on and total < gift_at
      assign next = 'gift'
      assign from = ship_at
      assign to = gift_at
      assign have = total
    elsif off1_on and basis < off1_at
      assign next = 'save'
      assign from = ship_at
      if gift_on
        assign from = gift_at
      endif
      assign to = off1_at
      assign have = basis
      assign next_off = off1
    elsif off2_on and basis < off2_at
      assign next = 'save-2'
      assign from = off1_at
      assign to = off2_at
      assign have = basis
      assign next_off = off2
    endif
    assign pct = 100
    if next != blank
      assign span = to | minus: from
      assign pct = have | minus: from | times: 100 | divided_by: span
      if pct > 100
        assign pct = 100
      elsif pct < 0
        assign pct = 0
      endif
    endif
    assign away = to | minus: have | money_without_trailing_zeros
    assign next_off_money = next_off | money_without_trailing_zeros
    assign earned_off_money = earned_off | money_without_trailing_zeros

    assign button = blank
    assign ahead = false
    assign gift_open = false
    if next == 'ship'
      assign state = 'ship'
      assign ahead = true
      assign text = 'rewards.ship_away' | t: amount: away
    elsif next == 'gift'
      assign state = 'gift'
      assign ahead = true
      assign text = 'rewards.gift_away' | t: amount: away
    elsif gift_on and gift_line and gift_paid > 0
      # The gift is in the cart but still charged: its discount is missing. Never call it free (rewards.js takes it out).
      assign state = 'charged'
      assign text = 'rewards.ship_done' | t
    elsif gift_on and gift_line == nil and declined == false
      assign state = 'ready'
      assign text = 'rewards.gift_ready' | t
      assign button = 'rewards.add' | t
    elsif next != blank
      assign state = next
      assign ahead = true
      assign text = 'rewards.off_away' | t: amount: away, off: next_off_money
      if gift_on and gift_line == nil
        assign gift_open = true
      endif
    elsif gift_on and gift_line == nil
      assign state = 'declined'
      assign text = 'rewards.gift_declined' | t
      assign button = 'rewards.add_back' | t
    else
      assign state = 'done'
      # Short enough for one line on a phone; the gift's name is on its own cart line.
      if earned_off > 0 and gift_on
        assign text = 'rewards.all_done_off' | t: off: earned_off_money
      elsif earned_off > 0
        assign text = 'rewards.ship_off_done' | t: off: earned_off_money
      elsif gift_on and ship_at > 0
        assign text = 'rewards.all_done' | t
      elsif gift_on
        assign text = 'rewards.gift_done' | t
      else
        assign text = 'rewards.ship_done' | t
      endif
    endif

    # What's already earned, shown as ticks above the next goal.
    assign show_earned = false
    if ahead and next != 'ship'
      if ship_at > 0 or gift_on or earned_off > 0
        assign show_earned = true
      endif
    endif
  -%}
  <div
    class="rewards{% unless ahead %} is-done{% endunless %}"
    data-rewards
    data-state="{{ state }}"
    data-top="{{ top }}"
    data-ship-at="{{ ship_at }}"
    data-fee="{{ settings.shipping_fee | default: 0 | times: 100 }}"
    {% if gift_on %}
      data-gift-variant="{{ gift_variant.id }}"
      data-gift-name="{{ gift_name }}"
      data-gift-at="{{ gift_at }}"
      data-gift-at-money="{{ gift_at | money_without_trailing_zeros | escape }}"
      data-total="{{ total }}"
      data-gift-key="{{ gift_line.key }}"
      data-gift-paid="{{ gift_paid }}"
      {% if gift_variant.available %}data-gift-available{% endif %}
      {% if declined %}data-gift-declined{% endif %}
    {% endif %}
  >
    {%- if show_earned -%}
      <ul class="rewards__earned" role="list">
        {%- if ship_at > 0 -%}
          <li>{%- render 'icon', icon: 'check' -%}{{ 'rewards.earned_ship' | t }}</li>
        {%- endif -%}
        {%- if gift_on and gift_line and next != 'gift' -%}
          <li>{%- render 'icon', icon: 'check' -%}{{ 'rewards.earned_gift' | t }}</li>
        {%- elsif gift_open -%}
          <li>
            {{- 'rewards.gift_declined' | t -}}
            <a
              class="rewards__btn"
              href="{{ routes.cart_add_url }}?id={{ gift_variant.id }}&quantity=1"
              aria-label="{{ 'rewards.add_label' | t: gift: gift_name }}"
              data-gift-add
              >{{ 'rewards.add_back' | t }}</a
            >
          </li>
        {%- endif -%}
        {%- if earned_off > 0 -%}
          <li>{%- render 'icon', icon: 'check' -%}{{ 'rewards.earned_off' | t: off: earned_off_money }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}
    <p class="rewards__text">
      {%- unless ahead -%}{%- render 'icon', icon: 'check' -%}{%- endunless -%}
      <span data-rewards-text>{{ text }}</span>
      {%- if button != blank -%}
        {%- comment -%} A link, so it works without JavaScript too (Shopify adds the item and returns to the cart). {%- endcomment -%}
        <a
          class="rewards__btn"
          href="{{ routes.cart_add_url }}?id={{ gift_variant.id }}&quantity=1"
          aria-label="{{ 'rewards.add_label' | t: gift: gift_name }}"
          data-gift-add
          >{{ button }}</a
        >
      {%- endif -%}
    </p>
    {%- if ahead -%}
      {%- liquid
        assign to_money = to | money_without_trailing_zeros
        assign step_icon = 'truck'
        if next == 'gift'
          assign step_icon = 'gift'
        elsif next != 'ship'
          assign step_icon = 'cash'
        endif
      -%}
      <div class="rewards__track" aria-hidden="true">
        <span class="rewards__fill" style="--pct: {{ pct }}%" data-rewards-fill data-goal="{{ next }}"></span>
        <span class="rewards__step is-last" style="--at: 100%">
          {%- render 'icon', icon: step_icon -%}
        </span>
      </div>
      {%- comment -%} "Small add-ons" shares the amount's row (drawer only), so it costs no extra line. {%- endcomment -%}
      {%- if place == 'drawer' -%}
        <a class="rewards__more" href="{{ settings.shop_all_collection.url | default: routes.all_products_collection_url }}?sort_by=price-ascending">
          {{- 'rewards.more' | t -}}
        </a>
      {%- endif -%}
      <div class="rewards__amounts" aria-hidden="true">
        <span class="is-last" style="--at: 100%">{{ to_money }}</span>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  /* The ticks for what's earned, one line of words for the next goal, a 4px bar ending in that goal's round marker,
     and the goal's amount in 12px under the marker. */
  .rewards { display: grid; gap: var(--space-2); font-size: var(--fs-small); color: var(--color-heading); }
  /* No wrapping between the parts: the tick stays beside the first line, and the words wrap inside their own box. */
  .rewards__text { display: flex; align-items: flex-start; column-gap: var(--space-2); line-height: 1.4; }
  .rewards__text > .icon { width: 18px; height: 18px; flex: none; margin-top: .0625rem; }
  .rewards__text > span { min-width: 0; }
  .rewards__btn {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: var(--tap);
    margin-block: calc((var(--tap) - 1.4em) / -2);
    color: var(--color-heading);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--rose);
  }
  /* Shares the amounts row: lifted onto it, with a tap area taller than the 16px row (WCAG 2.5.8). */
  .rewards__more {
    position: relative;
    z-index: 1;
    justify-self: start;
    grid-row: 4;
    grid-column: 1;
    margin-top: -4px;
    font-size: .75rem;
    line-height: 16px;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rewards__more::after { content: ""; position: absolute; inset: -14px -8px; }
  .rewards__amounts { grid-row: 4; grid-column: 1; }
  @media (hover: hover) { .rewards__btn:hover, .rewards__more:hover { text-decoration-thickness: 2px; } }
  /* What's already earned: one short row of ticks above the next goal. */
  .rewards__earned { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--space-3); font-size: .75rem; line-height: 16px; color: var(--color-ink); }
  .rewards__earned li { display: inline-flex; align-items: center; gap: var(--space-1); }
  .rewards__earned .icon { width: 14px; height: 14px; flex: none; color: var(--color-heading); }
  .rewards__earned .rewards__btn { margin-inline-start: var(--space-1); }
  /* Explicit rows, so the link and the amount share the last row. */
  .rewards__earned { grid-row: 1; }
  .rewards__text { grid-row: 2; }
  .rewards__track { grid-row: 3; }

  .rewards__track { position: relative; height: 22px; margin-inline-end: 0; }
  .rewards__track::before, .rewards__fill {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 9px;
    height: 4px;
    border-radius: 4px;
  }
  .rewards__track::before { inset-inline-end: 0; background: var(--color-line-strong); }
  /* cart.js sets the old width for a frame after a refresh, so the bar moves from where it was (motion-plan "Progress"). */
  .rewards__fill { width: var(--pct); background: var(--cocoa); transition: width 600ms var(--ease-out), background-color var(--dur-state) ease; }
  @media (prefers-reduced-motion: reduce) { .rewards__fill { transition: none; } }
  html.lite .rewards__fill { transition: none; }
  .rewards.is-done .rewards__fill { background: var(--sage); }
  .rewards__step {
    position: absolute;
    top: 0;
    inset-inline-start: var(--at);
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1.5px solid var(--color-line-strong);
    border-radius: 50%;
    background: var(--white);
    color: var(--color-muted);
    transform: translateX(-50%);
    transition: background-color var(--dur-state) ease, border-color var(--dur-state) ease, color var(--dur-state) ease;
  }
  .rewards__step.is-last { transform: translateX(-100%); }
  .rewards__step .icon { width: 14px; height: 14px; stroke-width: 2; }
  .rewards__step.is-reached { background: var(--sage); border-color: var(--sage); color: var(--cocoa-deep); }

  .rewards__amounts { position: relative; height: 16px; margin-top: -4px; font-size: .75rem; line-height: 16px; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .rewards__amounts > span { position: absolute; inset-inline-start: var(--at); transform: translateX(-50%); white-space: nowrap; }
  .rewards__amounts > .is-last { transform: translateX(-100%); }
  .rewards__amounts > .is-near { display: none; }

  /* Once everything is unlocked the full bar has nothing left to say: only the words stay
     (docs/cart-compact-plan.md). */
  .rewards.is-done :is(.rewards__track, .rewards__amounts) { display: none; }

  @media (forced-colors: active) {
    .rewards__track::before { border: 1px solid CanvasText; }
    .rewards__fill { background: Highlight; }
    .rewards__step { border-color: CanvasText; }
  }
{% endstylesheet %}
