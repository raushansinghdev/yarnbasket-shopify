{%- doc -%}
  Responsive image from Shopify's CDN (AVIF/WebP chosen automatically), optionally wrapped in a link.
  Always outputs width and height, so the browser reserves space and nothing jumps (CLS).

  @param {image} image - The image to render
  @param {string} [sizes] - The sizes attribute. Defaults to 100vw.
  @param {string} [loading] - 'lazy' (default) or 'eager' for images visible on first load
  @param {boolean} [priority] - true for the page's main image: high fetch priority plus a preload hint
  @param {string} [alt] - Alt text override. Defaults to the image's own alt text.
  @param {boolean} [decorative] - true for an empty alt, when visible text next to the image already names it
  @param {string} [class] - Class for the img element
  @param {string} [url] - Wraps the image in a link
  @param {number} [width] - Max width for the source. Defaults to 2400.
  @param {number} [height] - Optional height, used with crop for a fixed ratio
  @param {string} [crop] - Crop position, used with height

  @example
  {% render 'image', image: section.settings.image, sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', priority: true %}
{%- enddoc -%}
{%- liquid
  assign max_width = width | default: 2400
  assign img_sizes = sizes | default: '100vw'
  assign img_loading = loading | default: 'lazy'
  assign img_alt = alt | default: image.alt | escape
  if decorative
    assign img_alt = ''
  endif
  assign widths = '240, 360, 480, 640, 768, 960, 1200, 1440, 1800, 2400'
  if priority
    assign img_fetch = 'high'
  else
    assign img_fetch = 'auto'
  endif
-%}
{%- capture img -%}
  {{- image | image_url: width: max_width, height: height, crop: crop | image_tag:
    widths: widths,
    sizes: img_sizes,
    loading: img_loading,
    fetchpriority: img_fetch,
    preload: priority,
    alt: img_alt,
    class: class
  -}}
{%- endcapture -%}
{%- if url -%}
  <a href="{{ url }}" class="image-link">{{ img }}</a>
{%- else -%}
  {{ img }}
{%- endif -%}
