{%- doc -%}
  The header's account button (docs/account-plan.md §4): Shopify's <shopify-account> component. It opens a sheet
  over the page with sign-in (email code, Google once connected, Shop) when signed out, or the account menu
  (Orders, Profile, Saved, Track an order: Content → Menus → Customer account main menu) when signed in. Shopify
  loads its script (about 10 KB, low priority, after the page) and keeps it up to date.
  - Signed out it shows our account glyph (the slot); signed in, the shopper's initial on a Blush circle.
  - Until the component is ready, or without JavaScript, a plain link to the account stands in its place.
  - Under 900px it isn't shown (beside the search field it would crowd the centred name): the drawer's account row
    opens the same sheet (saved.js).
  - From 1100px it shows the word "Account" beside the glyph, like "Cart" next to it. The word is "Account", not
    "Sign in": Shopify's button is named "Account" (aria-label, inside its shadow root), and the visible label must
    match the spoken name (WCAG 2.5.3) so voice control ("click Account") works. Signed in, Shopify's initial circle
    replaces it (a full page load, so nothing jumps). The fallback link is the same pill, so nothing moves when the
    component arrives.
  The colours, fonts and corners below are the component's own CSS variables; its layout and wording are Shopify's.
  Signed in, our own menu replaces it (snippets/account-menu, docs/account-hub-plan.md §5): Shopify's sheet has no
  Sign out, icons or counts. So Shopify's sheet is only ever the sign-in sheet.
{%- enddoc -%}
{%- liquid
  # The account-demo pages show the signed-in menu too, with its made-up shopper, so it can be judged.
  assign demo_menu = false
  if customer == blank and settings.demo_content and template.suffix == 'account-demo' or template.suffix == 'account-details-demo'
    assign demo_menu = true
  endif
-%}
{%- if customer or demo_menu -%}
  {%- liquid
    assign account_page = pages['account'].url
    assign account_url = account_page | default: routes.account_url
    if account_page
      assign details_url = account_page | append: '#details'
    else
      assign details_url = routes.account_addresses_url
    endif
  -%}
  {%- render 'account-menu', account_url: account_url, saved_url: pages['saved'].url, details_url: details_url, demo: demo_menu -%}
{%- else -%}
{%- comment -%} The menu is used once it exists in the admin; until then Shopify shows Orders and Profile (and logs a warning). {%- endcomment -%}
<shopify-account class="account-btn" {% if linklists['customer-account-main-menu'].links.size > 0 %}menu="customer-account-main-menu"{% endif %} data-account>
  <span slot="signed-out-avatar" class="account-btn__glyph">
    {%- render 'icon', icon: 'account' -%}
    <span class="account-btn__word" aria-hidden="true">{{ 'header.account' | t }}</span>
    <span class="tip" aria-hidden="true">{{ 'header.account' | t }}</span>
  </span>
</shopify-account>
<a href="{{ routes.account_url }}" class="icon-btn site-header__account">
  {%- render 'icon', icon: 'account' -%}
  <span class="visually-hidden">{{ 'header.account' | t }}</span>
  <span class="account-btn__word" aria-hidden="true">{{ 'header.account' | t }}</span>
</a>
{%- endif -%}

{% stylesheet %}
  .account-btn {
    --shopify-account-color-accent: var(--cocoa-deep);
    --shopify-account-color-accent-text: var(--cream);
    --shopify-account-color-background: var(--white);
    --shopify-account-color-text: var(--cocoa-deep);
    --shopify-account-color-text-subdued: var(--taupe-ink);
    /* One white surface, Cocoa text throughout (the menu box's text fell back to black), a softer shadow. The border
       also draws the email field's edge, so it stays strong enough to see (3:1 on white). */
    --shopify-account-color-border: #A08A80;
    --shopify-account-color-card-background: var(--white);
    --shopify-account-color-card-text: var(--cocoa-deep);
    --shopify-account-color-background-subdued: var(--blush-soft);
    --shopify-account-color-control-background: var(--white);
    --shopify-account-color-control-text: var(--cocoa-deep);
    --shopify-account-color-shadow: rgb(78 58 49 / .22);
    --shopify-account-radius-dialog: var(--radius-lg);
    --shopify-account-font-body: var(--font-sans);
    --shopify-account-font-heading: var(--font-sans);
    --shopify-account-font-heading-weight: 500;
    --shopify-account-radius-base: var(--radius-md);
    --shopify-account-radius-button: var(--radius-pill);
    --shopify-account-radius-button-small: var(--radius-pill);
    --shopify-account-radius-input: var(--radius-pill);
    --shopify-account-dialog-position-top: calc(var(--header-top, 0px) + var(--header-height) + var(--space-2));
    --shopify-account-signed-in-avatar-color-background: var(--blush);
    --shopify-account-signed-in-avatar-color-text: var(--cocoa-deep);
    --shopify-account-signed-in-avatar-size: 32px;
    display: none;
    position: relative;
    color: var(--color-heading);
  }
  .account-btn::part(signed-out-avatar) { width: var(--tap); height: var(--tap); border-radius: 50%; }
  .account-btn__glyph { position: relative; display: grid; place-items: center; }
  .account-btn__glyph .icon { width: 28px; height: 28px; transition: transform var(--dur-panel) var(--ease-spring); }
  @media (hover: hover) {
    .account-btn:hover .account-btn__glyph .icon { transform: translateY(-1px); }
    .account-btn:hover .tip { opacity: 1; visibility: visible; translate: -50% 0; transition-delay: 300ms, 300ms, 300ms; }
  }
  .account-btn__glyph .tip { top: calc(100% + 10px); }
  /* The plain link stands in until the component is ready (same size and place, so nothing moves). */
  .account-btn:defined + .site-header__account { display: none !important; }
  @media (min-width: 900px) {
    .account-btn:defined { display: block; }
    .account-btn:not(:defined) + .site-header__account { display: inline-grid; }
  }
  .account-btn__word { display: none; }
  /* From 1100px: a pill with the word, the same shape as the cart beside it (sections/header.liquid). The tooltip
     would only repeat the word, so it goes. */
  @media (min-width: 1100px) {
    .account-btn::part(signed-out-avatar) { width: auto; padding: 0 14px 0 10px; border-radius: var(--radius-pill); }
    .account-btn__glyph { display: inline-flex; align-items: center; gap: 10px; }
    .account-btn__glyph .icon { width: 26px; height: 26px; }
    .account-btn__glyph .tip { display: none; }
    /* Text slotted into Shopify's button inherits the button's own font, so ours is set here, matching "Cart". */
    .account-btn__word { display: inline; font-family: var(--font-sans); font-size: .9375rem; font-weight: 500; line-height: 1; letter-spacing: 0; color: var(--color-heading); white-space: nowrap; }
    .site-header__account { align-items: center; gap: 10px; width: auto; padding: 0 14px 0 10px; border-radius: var(--radius-pill); text-decoration: none; }
    .account-btn:not(:defined) + .site-header__account { display: inline-flex; }
    .site-header__account > .icon { width: 26px; height: 26px; }
  }
  @media (min-width: 1100px) and (hover: hover) {
    .account-btn::part(signed-out-avatar):hover { background: color-mix(in srgb, var(--color-heading) 8%, transparent); }
  }
  /* Under 900px: opened from the drawer's account row. Its sheet lives in the top layer, so the host only needs to exist,
     not to show. */
  .account-btn.is-summoned { display: block; position: fixed; top: 0; right: 0; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
{% endstylesheet %}
