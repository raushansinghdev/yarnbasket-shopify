{%- doc -%}
  Delivery and payment terms near Add to cart (docs/offers-plan.md §6): Baymard found 27% of shoppers miss offers
  that only live in a site-wide banner, so the product page says them again where people decide. A muted two-by-two
  grid, so it's two rows at most. Every part comes from Theme settings, so it can't disagree with the cart or the
  announcement bar: free shipping and COD only once they're switched on.
  "Replacement if damaged", not "easy returns": there are no change-of-mind returns (docs/legal/terms-of-service.html
  §6). It links to the refund policy once that exists.

  @example
  {% render 'offer-terms' %}
{%- enddoc -%}
{%- assign threshold = settings.free_shipping_threshold | default: 0 | times: 100 -%}
<ul class="offer-terms" role="list" aria-label="{{ 'offers.label' | t }}">
  {%- if threshold > 0 -%}
    {%- assign amount = threshold | money_without_trailing_zeros -%}
    <li>{%- render 'icon', icon: 'truck' -%}{{ 'announcement.free_shipping' | t: amount: amount }}</li>
  {%- endif -%}
  {%- if settings.cod_available -%}
    <li>{%- render 'icon', icon: 'cash' -%}{{ 'announcement.cod' | t }}</li>
  {%- endif -%}
  <li>{%- render 'icon', icon: 'package' -%}{{ 'cart.ships' | t }}</li>
  <li>
    {%- render 'icon', icon: 'replace' -%}
    {%- if shop.refund_policy -%}
      <a href="{{ shop.refund_policy.url }}">{{ 'offers.replace' | t }}</a>
    {%- else -%}
      {{- 'offers.replace' | t -}}
    {%- endif -%}
  </li>
</ul>

{% stylesheet %}
  /* A two-by-two grid: two rows at most, and a long term wraps inside its own cell instead of making a ragged line. */
  .offer-terms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3) var(--space-4); font-size: .8125rem; line-height: 1.4; color: var(--color-muted); }
  .product-form > .offer-terms { margin-top: var(--space-5); }
  .offer-terms li { display: flex; align-items: flex-start; gap: var(--space-2); }
  .offer-terms .icon { width: 18px; height: 18px; flex: none; color: var(--color-heading); }
  .offer-terms a { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); }
  @media (hover: hover) { .offer-terms a:hover { text-decoration-color: currentColor; } }
{% endstylesheet %}
