{%- doc -%}
  Product card, modelled on the brand kit's Instagram photo frame: a rounded 4:5 photo on Oat,
  the name in Cormorant italic, the price in Jost, then at most one quiet line: how many colours. Shows the second photo on hover (desktop)
  and at most one badge. Renders a placeholder card when product is blank.

  Everything on the card is true data (docs/home-shop-plan.md §4):
  - Badge: Sold out wins, then "Last few" (tracked stock of 3 or fewer), then the "new" tag, then the "bestseller" tag.
  - Meta line: the number of colours (an option named Colour or Color), when there's more than one.
    (No "Ships in X days": every order ships in 1–2 days, so it would say the same thing on every card.)
  - Stars: only from Shopify's standard reviews.rating / reviews.rating_count metafields, which review apps fill in.
  The badge comes after the name in the HTML (CSS places it on the photo), so the link reads name first.
  With no product, shows one of eight demo products (Theme settings → Demo content) or a plain placeholder.

  @param {product} [product] - The product. Blank renders a placeholder.
  @param {string} [sizes] - Image sizes attribute for the grid it sits in
  @param {string} [loading] - 'lazy' (default) or 'eager'
  @param {number} [index] - Position in the grid, used for staggered reveal and placeholder art
  @param {number} [demo] - Which demo product (1–8) to show when product is blank. Defaults to index + 1.
  @param {boolean} [skip_bestseller] - Don't show the Bestseller badge (in a list that is already the bestsellers)
{%- enddoc -%}
{%- liquid
  assign img_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign badge = blank
  assign meta = blank
  if product != blank
    assign tracked = 0
    assign untracked = false
    for variant in product.variants
      if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
        assign tracked = tracked | plus: variant.inventory_quantity
      else
        assign untracked = true
      endif
    endfor

    if product.available == false
      assign badge = 'products.sold_out' | t
    elsif untracked == false and tracked > 0 and tracked <= 3
      assign badge = 'products.last_few' | t
    elsif product.tags contains 'new'
      assign badge = 'products.new' | t
    elsif product.tags contains 'bestseller' and skip_bestseller != true
      assign badge = 'products.bestseller' | t
    endif

    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name == 'colour' or option_name == 'color' or option_name == 'colours' or option_name == 'colors'
        if option.values.size > 1
          assign meta = 'products.colours' | t: count: option.values.size
        endif
      endif
    endfor

    assign rating = product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  endif
-%}
<article class="card" style="--i: {{ index | default: 0 | modulo: 4 }}">
  {%- if product != blank -%}
    <a href="{{ product.url }}" class="card__link">
      <div class="card__media media">
        {%- if product.featured_media -%}
          {%- assign main_alt = product.featured_media.alt | default: product.title | escape -%}
          {%- render 'image', image: product.featured_media.preview_image, sizes: img_sizes, loading: loading, class: 'card__img', alt: main_alt -%}
          {%- if product.media[1] -%}
            {%- render 'image', image: product.media[1].preview_image, sizes: img_sizes, class: 'card__img card__img--alt', alt: '' -%}
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="card__info">
        <h3 class="card__title">{{ product.title }}</h3>
        {%- render 'price', product: product -%}
        {%- if rating_count > 0 -%}
          <p class="card__rating">
            <span aria-hidden="true">★ {{ rating.rating | round: 1 }} <span class="card__muted">({{ rating_count }})</span></span>
            <span class="visually-hidden">{{ 'products.rating' | t: rating: rating.rating, count: rating_count }}</span>
          </p>
        {%- endif -%}
        {%- if meta != blank -%}<p class="card__meta">{{ meta }}</p>{%- endif -%}
      </div>
      {%- if badge != blank -%}<span class="card__badge">{{ badge }}</span>{%- endif -%}
    </a>
  {%- elsif settings.demo_content -%}
    {%- comment -%} Demo product while the store has none (Theme settings → Demo content). {%- endcomment -%}
    {%- liquid
      assign n = demo | default: index | default: 0
      if demo == blank
        assign n = n | modulo: 8 | plus: 1
      endif
      assign d_compare = blank
      assign d_badge = blank
      assign d_meta = blank
      case n
        when 1
          assign d_title = 'Sunflower Trio Crochet Bouquet'
          assign d_price = '₹1,299'
          unless skip_bestseller
            assign d_badge = 'products.bestseller' | t
          endunless
        when 2
          assign d_title = 'Red Rose Crochet Bouquet'
          assign d_price = '₹1,199'
          assign d_meta = 'products.colours' | t: count: 3
        when 3
          assign d_title = 'Pink Tulip & Daisy Bouquet'
          assign d_price = '₹999'
          assign d_compare = '₹1,199'
        when 4
          assign d_title = 'Bee & Chick Keychain Set'
          assign d_price = '₹449'
          assign d_badge = 'products.new' | t
        when 5
          assign d_title = 'Daisy Crochet Flower Pot'
          assign d_price = '₹599'
          assign d_meta = 'products.colours' | t: count: 4
        when 6
          assign d_title = 'Flower Hair Clips, Set of 8'
          assign d_price = '₹399'
        when 7
          assign d_title = 'Lily of the Valley Bag Charm'
          assign d_price = '₹349'
          assign d_badge = 'products.last_few' | t
          assign d_meta = 'products.colours' | t: count: 2
        else
          assign d_title = 'Daisy Crochet Headband'
          assign d_price = '₹449'
      endcase
      assign img_a = 'p' | append: n | append: '-a'
      assign img_b = 'p' | append: n | append: '-b'
    -%}
    <a href="{{ routes.all_products_collection_url }}" class="card__link">
      <div class="card__media media">
        {%- render 'demo-image', name: img_a, sizes: img_sizes, class: 'card__img', alt: d_title, loading: loading -%}
        {%- render 'demo-image', name: img_b, sizes: img_sizes, class: 'card__img card__img--alt' -%}
      </div>
      <div class="card__info">
        <h3 class="card__title">{{ d_title }}</h3>
        <p class="price{% if d_compare %} price--sale{% endif %}">
          {%- if d_compare -%}
            <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>
            <span>{{ d_price }}</span>
            <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
            <s class="price__compare">{{ d_compare }}</s>
          {%- else -%}
            {{ d_price }}
          {%- endif -%}
        </p>
        {%- if d_meta != blank -%}<p class="card__meta">{{ d_meta }}</p>{%- endif -%}
      </div>
      {%- if d_badge != blank -%}<span class="card__badge">{{ d_badge }}</span>{%- endif -%}
    </a>
  {%- else -%}
    {%- assign art = index | default: 0 | modulo: 6 | plus: 1 -%}
    <div class="card__link" aria-hidden="true">
      <div class="card__media media">
        {{ 'product-' | append: art | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
      <div class="card__info">
        <p class="card__title">{{ 'products.placeholder_name' | t }}</p>
        <p class="price">₹999</p>
      </div>
    </div>
  {%- endif -%}
</article>

{% stylesheet %}
  .card { min-width: 0; }
  .card__link {
    position: relative;
    display: grid;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
    -webkit-touch-callout: none;
  }
  .card__media { --ratio: 4 / 5; border-radius: var(--radius-md); background: var(--blush); }
  .card__img {
    transition: opacity 500ms var(--ease-out), transform 900ms var(--ease-out);
  }
  .card__img--alt { opacity: 0; }
  @media (hover: hover) {
    .card__link:hover .card__img { transform: scale(1.035); }
    .card__link:hover .card__img--alt { opacity: 1; }
  }
  .card__link:active .card__media { transform: scale(.985); transition: transform var(--dur-press) ease; }
  .card__media { transition: transform var(--dur-panel) var(--ease-out); }

  /* After the name in the HTML, placed on the photo's corner here (the photo is the link's first row). */
  .card__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--blush);
    color: var(--cocoa-deep);
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .card__info { display: grid; gap: 2px; padding-inline: 2px; }
  .card__title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.125rem, 1.05rem + .35vw, 1.3125rem);
    line-height: 1.2;
    letter-spacing: -.005em;
    color: var(--color-heading);
    text-wrap: balance;
  }
  /* One quiet line: how many colours. Taupe Ink is 5.7:1 on Soft blush. */
  .card__meta, .card__rating { font-size: .875rem; line-height: 1.35; color: var(--color-muted); }
  .card__rating { color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .card__muted { color: var(--color-muted); }
{% endstylesheet %}
