{%- doc -%}
  One product in the search panel's results: a square photo, the name with the typed letters in bold, the price,
  and "Sold out" when it is. A row on phones, a small card in the wider panel (container query in
  sections/predictive-search.liquid). The whole thing is one link; the photo has empty alt because the name is in the link.

  @param {product} [product] - The product. Blank with demo shows a demo product.
  @param {number} [demo] - Demo product number (1–8), used when product is blank
  @param {string} [terms] - What was typed, for highlighting
{%- enddoc -%}
{%- liquid
  assign img_sizes = '(min-width: 768px) 210px, 64px'
  if product != blank
    assign title = product.title | escape
    assign url = product.url
  else
    capture title
      render 'search-demo', what: 'title', n: demo
    endcapture
    assign title = title | strip | escape
    assign url = routes.all_products_collection_url
  endif
  if terms != blank
    assign title = title | highlight: terms
  endif
-%}
<li class="search-result">
  <a href="{{ url }}" class="search-result__link">
    <div class="search-result__media media">
      {%- if product != blank -%}
        {%- if product.featured_media -%}
          {{- product.featured_media.preview_image | image_url: width: 480 | image_tag: widths: '128, 240, 360, 480', sizes: img_sizes, loading: 'lazy', alt: '' -}}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      {%- else -%}
        {%- assign img = 'p' | append: demo | append: '-a' -%}
        {%- render 'demo-image', name: img, sizes: img_sizes -%}
      {%- endif -%}
    </div>
    <div class="search-result__info">
      <p class="search-result__title">{{ title }}</p>
      {%- if product != blank -%}
        {%- render 'price', product: product -%}
        {%- unless product.available -%}<p class="search-result__badge">{{ 'products.sold_out' | t }}</p>{%- endunless -%}
      {%- else -%}
        <p class="price">{%- render 'search-demo', what: 'price', n: demo -%}</p>
      {%- endif -%}
    </div>
  </a>
</li>

{% stylesheet %}
  .search-result__link {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    min-height: 72px;
    padding: var(--space-1);
    margin-inline: calc(var(--space-1) * -1);
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .search-result__link:active { background: var(--blush-soft); }
  .search-result__media { --ratio: 1; border-radius: var(--radius-sm); background: var(--oat); }
  .search-result__info { display: grid; gap: 2px; }
  .search-result__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: .9375rem;
    line-height: 1.35;
    color: var(--color-heading);
  }
  .search-result__title .highlight { font-weight: 600; }
  .search-result__info .price { font-size: .875rem; }
  .search-result__badge { font-size: .75rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); }
  @media (hover: hover) {
    .search-result__link:hover .search-result__title { text-decoration: underline; text-decoration-color: var(--rose); text-underline-offset: 3px; }
    .search-result__media img { transition: transform 900ms var(--ease-out); }
    .search-result__link:hover .search-result__media img { transform: scale(1.05); }
  }
  /* In the wider panel, results become small cards in a grid. */
  @container search-body (min-width: 560px) {
    .search-result__link { grid-template-columns: 1fr; align-items: start; gap: var(--space-2); margin: 0; padding: 0; }
    .search-result__link:active { background: none; }
    .search-result__link:active .search-result__media { scale: .97; }
  }
{% endstylesheet %}
