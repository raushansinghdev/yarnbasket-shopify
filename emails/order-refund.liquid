  <td class="subtotal-line__title">
    <p>
      <span>Total due on fulfillment</span>
    </p>
  </td>
  <td class="subtotal-line__value">
      <strong>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ next_amount_due | money_with_currency }}{% if buyer_email_rtl == true %}</span>{% endif %}</strong>
  </td>
</tr>

          {% else %}
            

<tr class="subtotal-line">
  <td class="subtotal-line__title">
    <p>
      <span>Total due {% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ due_at_date }}{% if buyer_email_rtl == true %}</span>{% endif %}</span>
    </p>
  </td>
  <td class="subtotal-line__value">
      <strong>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ next_amount_due | money_with_currency }}{% if buyer_email_rtl == true %}</span>{% endif %}</strong>
  </td>
</tr>

          {% endif %}
        </div>
      {% elsif transaction_amount != total_price %}
          

<tr class="subtotal-line">
  <td class="subtotal-line__title">
    <p>
      <span>Total</span>
    </p>
  </td>
  <td class="subtotal-line__value">
      <strong>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ total_price | money_with_currency }}{% if buyer_email_rtl == true %}</span>{% endif %}</strong>
  </td>
</tr>

        <div class="payment-terms">
          

<tr class="subtotal-line">
  <td class="subtotal-line__title">
    <p>
      <span>Total paid</span>
    </p>
  </td>
  <td class="subtotal-line__value">
      <strong>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ transaction_amount | money_with_currency }}{% if buyer_email_rtl == true %}</span>{% endif %}</strong>
  </td>
</tr>

        </div>
      {% else %}
        

<tr class="subtotal-line">
  <td class="subtotal-line__title">
    <p>
      <span>Total</span>
    </p>
  </td>
  <td class="subtotal-line__value">
      <strong>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ total_price | money_with_currency }}{% if buyer_email_rtl == true %}</span>{% endif %}</strong>
  </td>
</tr>

      {% endif %}
      </table>

      {% if total_discounts > 0 %}
        <p class="total-discount">
          You saved <span class="total-discount--amount">{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ total_discounts | money }}{% if buyer_email_rtl == true %}</span>{% endif %}</span>
        </p>
      {% endif %}

      {% unless payment_terms %}
      {% if transaction_size > 1 or transaction_amount < total_price %}
        <table class="row subtotal-table">
          <tr><td colspan="2" class="subtotal-table__line"></td></tr>
          <tr><td colspan="2" class="subtotal-table__small-space"></td></tr>

          {% for transaction in transactions %}
            {% if transaction.status == "success" and transaction.kind == "capture" or transaction.kind == "sale" %}
              {% if transaction.payment_details.local_payment? %}
                {% capture transaction_name %}{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ transaction.payment_details.payment_method_display_name | default: transaction.payment_details.payment_method_name }}{% if buyer_email_rtl == true %}</span>{% endif %}{% endcapture %}
              {% elsif transaction.payment_details.credit_card_company %}
                {% capture transaction_name %}{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ transaction.payment_details.credit_card_company }}{% if buyer_email_rtl == true %}</span>{% endif %} (ending in {% if buyer_email_rtl == true %}<span dir="ltr" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ transaction.payment_details.credit_card_last_four_digits }}{% if buyer_email_rtl == true %}</span>{% endif %}){% endcapture %}
              {% else %}
                {% capture transaction_name %}{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ transaction.gateway_display_name }}{% if buyer_email_rtl == true %}</span>{% endif %}{% endcapture %}
              {% endif %}

              

<tr class="subtotal-line">
  <td class="subtotal-line__title">
    <p>
      <span>{{transaction_name}}</span>
    </p>
  </td>
  <td class="subtotal-line__value">
      <strong>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ transaction.amount | money }}{% if buyer_email_rtl == true %}</span>{% endif %}</strong>
  </td>
</tr>

            {% endif %}
            {% if transaction.kind == 'refund' and transaction.gateway != "shop_offer" %}
              {% if transaction.payment_details.local_payment? %}
                {% capture refund_method_subtitle %}{{ transaction.payment_details.payment_method_display_name | default: transaction.payment_details.payment_method_name }}{% endcapture %}
              {% elsif transaction.payment_details.credit_card_company %}
                {% capture refund_method_subtitle %}{{ transaction.payment_details.credit_card_company | replace: '_', ' ' | capitalize }}{% endcapture %}
              {% else %}
                {% capture refund_method_subtitle %}{{ transaction.gateway_display_name | replace: '_', ' ' | capitalize }}{% endcapture %}
              {% endif %}

              {% if transaction.gateway == 'shopify_store_credit' %}
                {% assign link_url = routes.account_profile_url %}
                {% capture link_text %}View{% endcapture %}
              {% else %}
                {% assign link_url = nil %}
                {% assign link_text = nil %}
              {% endif %}

              {% assign current_date = transaction.created_at | date: "%B %e, %Y" %}

              

<tr class="subtotal-line">
  <td class="subtotal-line__title">
    <p>
      <span>Refund</span>
        <br>
        <small>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ refund_method_subtitle }}{% if buyer_email_rtl == true %}</span>{% endif %}</small>
          &nbsp;&nbsp;<a href="{{ link_url }}" class="small">{{ link_text }}</a>
    </p>
  </td>
  <td class="subtotal-line__value">
      <strong>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ transaction.amount | times: -1 | money }}{% if buyer_email_rtl == true %}</span>{% endif %}</strong>
  </td>
</tr>

            {% endif %}
          {% endfor %}
        </table>
      {% endif %}


      {% endunless %}
    </td>
  </tr>
</table>


            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

{%- comment -%}yb:start footer{%- endcomment -%}
          <table class="row yb-help">
  <tr>
    <td class="yb-help__cell">
      <center>
        <table class="container"{% if buyer_email_rtl == true %} dir="rtl"{% endif %}>
          <tr>
            <td class="yb-help__box">
              Questions about this order? <a href="https://wa.me/919321979410?text=Hi%20Yarn%20Basket!%20I%20need%20help%20with%20my%20order%20%23{{ order_name | default: name | remove: '#' }}">WhatsApp us</a> or reply to this email.
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

          <table class="row footer">
  <tr>
    <td class="footer__cell">
      <center>
        <table class="container"{% if buyer_email_rtl == true %} dir="rtl"{% endif %}>
          <tr>
            <td>
              <p class="yb-foot__made">Handmade with love in India</p>
              <p class="disclaimer__subtext"><a href="{{ shop.url }}">Shop</a> &nbsp;·&nbsp; <a href="https://www.instagram.com/yarnbasket.in/">Instagram</a> &nbsp;·&nbsp; <a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
              <p class="disclaimer__subtext"><a href="{{ shop.url }}/policies/shipping-policy">Shipping</a> &nbsp;·&nbsp; <a href="{{ shop.url }}/policies/refund-policy">Returns &amp; refunds</a> &nbsp;·&nbsp; <a href="{{ shop.url }}/policies/privacy-policy">Privacy</a></p>
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

<img src="{{ 'notifications/spacer.png' | shopify_asset_url }}" class="spacer" height="1" />
{%- comment -%}yb:end footer{%- endcomment -%}

        </td>
      </tr>
    </table>
  </body>
</html>
