                  {% endif %}

                  {%- assign yb_billing = billing_address | format_address -%}{%- assign yb_delivery = shipping_address | format_address -%}
                  {% if billing_address and yb_billing != yb_delivery %}
                    <td class="customer-info__item">
                      <h4>Billing address</h4>
                      {% if buyer_email_rtl %}<div dir="auto" style="unicode-bidi: isolate;">{% endif %}{{ billing_address | format_address }}{% if buyer_email_rtl %}</div>{% endif %}
                    </td>
                  {% endif %}
                </tr>
              </table>
              {% if shipping_method or company_location or payment_terms %}
                <table class="row">
                  <tr>
                    {% if company_location %}
                      <td class="customer-info__item">
                        <h4>Location</h4>
                        <p>
                          {% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ company_location.name }}{% if buyer_email_rtl == true %}</span>{% endif %}
                        </p>
                      </td>
                    {% endif %}

                    {% if payment_terms %}
                      <td class="customer-info__item">
                        <h4>Payment</h4>
                        {% assign due_date = payment_terms.next_payment.due_at | default: nil %}
                        {% if payment_terms.type == 'receipt' or payment_terms.type == 'fulfillment' %}
                          <p>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ payment_terms.translated_name }}{% if buyer_email_rtl == true %}</span>{% endif %}</p>
                        {% else %}
                          <p>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ payment_terms.translated_name }}{% if buyer_email_rtl == true %}</span>{% endif %}: Due {% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ due_date | date: format: 'date' }}{% if buyer_email_rtl == true %}</span>{% endif %}</p>
                        {% endif %}
                      </td>
                    {% endif %}
                  </tr>
                  <tr>
                    {% if shipping_method %}
                      <td class="customer-info__item customer-info__item--last">
                        <h4>Delivery method</h4>
                        {% if local_pickup %}
                          <p>Local pickup - {% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ shipping_method.title }}{% if buyer_email_rtl == true %}</span>{% endif %}</p>
                          {% if local_pickup_address %}
                            {% if buyer_email_rtl %}<div dir="auto" style="unicode-bidi: isolate;">{% endif %}{{ local_pickup_address | format_address }}{% if buyer_email_rtl %}</div>{% endif %}
                          {% endif %}
                        {% else %}
                          <p>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ shipping_method.title }}{% if buyer_email_rtl == true %}</span>{% endif %}<br/>{% if buyer_email_rtl == true %}<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ shipping_method.price | money }}{% if buyer_email_rtl == true %}</span>{% endif %}</p>
                        {% endif %}
                      </td>
                      <td class="customer-info__item customer-info__item--last">
                      </td>
                    {% endif %}
                  </tr>
                </table>
              {% endif %}

            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>
          {% endif %}

{%- comment -%}yb:start footer{%- endcomment -%}
          <table class="row yb-help">
  <tr>
    <td class="yb-help__cell">
      <center>
        <table class="container"{% if buyer_email_rtl == true %} dir="rtl"{% endif %}>
          <tr>
            <td class="yb-help__box">
              Questions about this order? <a href="https://wa.me/919321979410?text=Hi%20Yarn%20Basket!%20I%20need%20help%20with%20my%20order%20%23{{ order_name | default: name | remove: '#' }}">WhatsApp us</a> or reply to this email.
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

          <table class="row footer">
  <tr>
    <td class="footer__cell">
      <center>
        <table class="container"{% if buyer_email_rtl == true %} dir="rtl"{% endif %}>
          <tr>
            <td>
              <p class="yb-foot__made">Handmade with love in India</p>
              <p class="disclaimer__subtext"><a href="{{ shop.url }}">Shop</a> &nbsp;·&nbsp; <a href="https://www.instagram.com/yarnbasket.in/">Instagram</a> &nbsp;·&nbsp; <a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
              <p class="disclaimer__subtext"><a href="{{ shop.url }}/policies/shipping-policy">Shipping</a> &nbsp;·&nbsp; <a href="{{ shop.url }}/policies/refund-policy">Returns &amp; refunds</a> &nbsp;·&nbsp; <a href="{{ shop.url }}/policies/privacy-policy">Privacy</a></p>
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

<img src="{{ 'notifications/spacer.png' | shopify_asset_url }}" class="spacer" height="1" />
{%- comment -%}yb:end footer{%- endcomment -%}

        </td>
      </tr>
    </table>
  </body>
</html>
